<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>BlazOrbit.FormsFluentValidation</PackageId>
        <Description>FluentValidation integration for BlazOrbit. It adds the ability to validate forms using FluentValidation</Description>
        <PackageTags>blazor;validation;blazorbit</PackageTags>
        <!-- RS0026: AddBOBFluentValidation has two overloads (generic + assembly-based) that
             both carry trailing optional parameters. Adding `OverloadResolutionPriority`
             or splitting overloads would be a breaking change against the existing 0.x
             surface. Re-evaluate at the 1.0 baseline. -->
        <NoWarn>$(NoWarn);RS0026</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1"/>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="$(BlazOrbitAspNetCoreVersion)"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(BlazOrbitAspNetCoreVersion)"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="$(BlazOrbitAspNetCoreVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Per-TFM PublicAPI sidecars: net8 surfaces traditional `static (this T)` extension
         methods; net10 surfaces C# 14 `extension(T)` extension members. Same logical method,
         different declared symbol - analyzer reports each form on its respective build. -->
    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.net8.txt" Condition="'$(TargetFramework)' == 'net8.0'"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.net10.txt" Condition="'$(TargetFramework)' == 'net10.0'"/>
    </ItemGroup>

</Project>
