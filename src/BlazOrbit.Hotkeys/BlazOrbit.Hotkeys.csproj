<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageType>Dependency</PackageType>
        <PackageId>BlazOrbit.Hotkeys</PackageId>
        <Description>Global keyboard shortcut registry for BlazOrbit. Document-level keydown listener.</Description>
        <PackageTags>blazor;hotkeys;keyboard;shortcuts;keybinding;blazorbit</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BlazOrbit.Tests.Integration"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="$(BlazOrbitAspNetCoreVersion)"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(BlazOrbitAspNetCoreVersion)"/>
        <PackageReference Include="Microsoft.JSInterop" Version="$(BlazOrbitJsInteropVersion)"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(BlazOrbitExtensionsVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Hotkeys reaches into the Core abstractions for ModuleJsInteropBase. No dependency
            on the main BlazOrbit component library — the host renders nothing visible and
            keeps the package surface minimal so consumers can opt in without pulling the
            full design system.
        -->
        <ProjectReference Include="..\BlazOrbit.Core\BlazOrbit.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
    </ItemGroup>

    <!--
        TypeScript source-of-truth lives at Types/Hotkey/HotkeyInterop.ts. The bundled
        .min.js under wwwroot/js/Hotkey/ is committed so consumers building without Node
        still get the JS interop module.
    -->
    <ItemGroup>
        <None Remove="Types\**\*.ts"/>
        <Compile Remove="Types\**\*.ts"/>
        <Content Remove="Types\**\*.ts"/>
    </ItemGroup>

    <!--
        TypeScript → minified ESM JS pipeline.

        Source-of-truth lives at Types/**/*.ts; the bundled output ships at
        wwwroot/js/**/*.min.js and is committed so consumers building
        without Node still get the JS interop module.

        This target runs once per managed build (outer build or single-TFM) to
        avoid duplicate work and parallel npm/esbuild races when TargetFrameworks
        contains multiple values.
    -->
    <PropertyGroup>
        <_HotkeysEsbuildBinaryUnix>$(MSBuildThisFileDirectory)node_modules\esbuild\bin\esbuild</_HotkeysEsbuildBinaryUnix>
        <_HotkeysEsbuildBinaryWin>$(_HotkeysEsbuildBinaryUnix).exe</_HotkeysEsbuildBinaryWin>
    </PropertyGroup>

    <Target Name="EnsureHotkeysNodeModules"
            BeforeTargets="DispatchToInnerBuilds;BeforeBuild"
            Condition="('$(IsCrossTargetingBuild)' == 'true' OR '$(TargetFrameworks)' == '') AND !Exists('$(_HotkeysEsbuildBinaryUnix)') AND !Exists('$(_HotkeysEsbuildBinaryWin)') AND Exists('$(MSBuildThisFileDirectory)package.json')">
        <Message Text="[BlazOrbit.Hotkeys] esbuild binary missing (corrupted node_modules). Purging esbuild and running npm install..." Importance="high"/>
        <RemoveDir Directories="$(MSBuildThisFileDirectory)node_modules\esbuild"/>
        <Exec Command="npm install" WorkingDirectory="$(MSBuildThisFileDirectory)" ContinueOnError="false"/>
    </Target>

    <Target Name="BundleHotkeysInterop"
            BeforeTargets="DispatchToInnerBuilds;BeforeBuild"
            DependsOnTargets="EnsureHotkeysNodeModules"
            Condition="('$(IsCrossTargetingBuild)' == 'true' OR '$(TargetFrameworks)' == '') AND (Exists('$(_HotkeysEsbuildBinaryUnix)') OR Exists('$(_HotkeysEsbuildBinaryWin)'))"
            Inputs="@(None);Types\**\*.ts;package.json"
            Outputs="wwwroot\js\Hotkey\HotkeyInterop.min.js">
        <Message Text="[BlazOrbit.Hotkeys] Bundling Types/Hotkey/HotkeyInterop.ts → wwwroot/js/Hotkey/HotkeyInterop.min.js" Importance="high"/>
        <Exec Command="npm run build:js"
              WorkingDirectory="$(MSBuildThisFileDirectory)"
              ContinueOnError="false"/>
    </Target>

</Project>
