@namespace BlazOrbit.Hotkeys

@using Microsoft.JSInterop

@inject IHotkeyService HotkeyService
@inject IHotkeyJsInterop HotkeyJsInterop
@implements IAsyncDisposable

@* Pure host - renders nothing visible. Mount it once in the app shell (e.g. inside
   BOBBlazorLayout) to wire the document-level keydown listener that drives
   IHotkeyService. Inherits the default ComponentBase rather than BOBComponentBase
   because there is no design-system surface to participate in. *@

@code {
    private DotNetObjectReference<HotkeyHostRelay>? _relay;
    private string _hostId = Guid.NewGuid().ToString("n");
    private bool _attached;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _attached) return;

        // The relay is invokable from JS via `relay.invokeMethodAsync('OnHotkey', combo)`.
        _relay = DotNetObjectReference.Create(new HotkeyHostRelay(HotkeyService));
        try
        {
            await HotkeyJsInterop.AttachAsync(_hostId, _relay);
            _attached = true;

            // Subscribe before we replay so we don't double-push a combo that lands
            // between the snapshot and the wiring.
            HotkeyService.Registered += HandleRegistered;
            HotkeyService.Unregistered += HandleUnregistered;

            // Replay any combos registered before the host mounted (typical for
            // page-level Register calls in OnInitialized that fire on prerender).
            foreach (var descriptor in HotkeyService.RegisteredHotkeys)
            {
                await PushRegisterAsync(descriptor);
            }
        }
        catch (JSDisconnectedException)
        {
            // Server circuit gone before we could attach - nothing to do.
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerender path with no JS runtime; the listener wires up on the next render
            // when interop is available.
        }
        catch (TaskCanceledException)
        {
        }
        catch (JSException)
        {
            // Module load failure is non-fatal - hotkeys silently degrade.
        }
    }

    private void HandleRegistered(HotkeyDescriptor descriptor)
    {
        Utilities.BOBAsyncHelper.SafeFireAndForget(() => PushRegisterAsync(descriptor).AsTask());
    }

    private void HandleUnregistered(HotkeyDescriptor descriptor)
    {
        Utilities.BOBAsyncHelper.SafeFireAndForget(() => PushUnregisterAsync(descriptor.Combo).AsTask());
    }

    private async ValueTask PushRegisterAsync(HotkeyDescriptor descriptor)
    {
        if (!_attached) return;
        try
        {
            await HotkeyJsInterop.RegisterComboAsync(_hostId, descriptor.Combo, descriptor.PreventDefault);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async ValueTask PushUnregisterAsync(string combo)
    {
        if (!_attached) return;
        try
        {
            await HotkeyJsInterop.UnregisterComboAsync(_hostId, combo);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        HotkeyService.Registered -= HandleRegistered;
        HotkeyService.Unregistered -= HandleUnregistered;

        if (_attached)
        {
            try
            {
                await HotkeyJsInterop.DetachAsync(_hostId);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
            catch (TaskCanceledException)
            {
            }
        }

        _relay?.Dispose();
    }

}
