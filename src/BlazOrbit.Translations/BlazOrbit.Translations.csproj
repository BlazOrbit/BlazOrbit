<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageType>Dependency</PackageType>
		<PackageId>BlazOrbit.Translations</PackageId>
		<RootNamespace>BlazOrbit.Translations</RootNamespace>
		<AssemblyName>BlazOrbit.Translations</AssemblyName>
		<Description>Localized resource bundle for BlazOrbit. Ships .resx satellites for every supported culture; loaded automatically by the localization integrations through the rerouted IStringLocalizerFactory.</Description>
		<PackageTags>blazor;localization;i18n;translations;blazorbit</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
	</ItemGroup>

	<!-- Package ships only .resx satellites — no .cs surface — so the sidecars stay empty.
	     The analyzer reference still gates any future code addition through RS0016. -->
	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>

</Project>
