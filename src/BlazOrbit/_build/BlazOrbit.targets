<Project>
    <!--
        Consumer-facing targets file. Shipped inside the NuGet package under `build/` and
        imported automatically by MSBuild on restore.

        By design this file does NOTHING: the CSS bundle (`wwwroot/css/blazorbit.css`)
        and JS interop modules (`wwwroot/js/Types/**/*.js`) are hand-written, committed,
        and ship as StaticWebAssets under `staticwebassets/` in the `.nupkg`. The Razor
        SDK serves them to the consumer's app without any build-time generation. No
        Node, npm, Vite, esbuild or TypeScript toolchain is required on either side.

        The file exists solely so MSBuild's `build/<PackageId>.targets` auto-import
        convention has a file to find - removing it would not break anything, but
        keeping it preserves the contract in case future shipped MSBuild logic is
        ever added.
    -->
</Project>
