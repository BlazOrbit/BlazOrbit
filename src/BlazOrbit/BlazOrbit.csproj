<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageType>Dependency</PackageType>
        <PackageId>BlazOrbit</PackageId>
        <Description>A dual-host (Blazor Server and Blazor WebAssembly) component library. C# first, high-performance, and accessible UI design. Lightweight, customizable, open source.</Description>
        <PackageTags>blazor;blazor-server;blazor-wasm;components;ui;design-system;material;theming</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="BlazOrbit.Tests.Integration"/>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(BlazOrbitAspNetCoreVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Localization" Version="$(BlazOrbitAspNetCoreVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlazOrbit.Core\BlazOrbit.Core.csproj"/>
    </ItemGroup>

    <!--
        Ship the consumer-facing (no-op) targets file so MSBuild auto-imports it on restore.
        Hand-written CSS (wwwroot/css/blazorbit.css) and JSDoc-typed .js modules under
        wwwroot/js/Types/** are committed sources — no build-time generation, no Node,
        no Vite. The targets file itself is a no-op and exists purely so MSBuild's
        package-import convention has a file to find.
    -->
    <ItemGroup>
        <None Include="_build/BlazOrbit.targets" Pack="true" PackagePath="build/"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlazOrbit.CodeGeneration\BlazOrbit.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\BlazOrbit.Localization.CodeGeneration\BlazOrbit.Localization.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\BlazOrbit.SyntaxHighlight\BlazOrbit.SyntaxHighlight.csproj"/>
    </ItemGroup>

    <!-- BOBLocalize: feed all .tn translation files to the generator. -->
    <ItemGroup>
        <AdditionalFiles Include="Translations\**\*.tn"/>
    </ItemGroup>

</Project>
