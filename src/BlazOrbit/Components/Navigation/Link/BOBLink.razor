@namespace BlazOrbit.Components
@attribute [GenerateComponentInfo]

@inherits BOBVariantComponentBase<BOBLink, BOBLinkVariant>
@implements IHasTransitions
@implements IHasSize
@implements IHasFullWidth
@implements IHasShadow
@implements IHasDensity
@implements IHasBorder
@implements IHasBackgroundColor
@implements IHasColor

@{
    base.BuildRenderTree(__builder);
}

@code {
    /* ========= Public API ========= */

    /// <summary>
    /// Destination URL rendered on the inner <c>&lt;a&gt;</c>. The value is emitted as-is;
    /// sanitize untrusted input (for example <c>javascript:</c> URLs) before passing it.
    /// </summary>
    [Parameter, EditorRequired]
    public string? Href { get; set; }

    /// <summary>Customizable link content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Text displayed inside the link. Ignored when <see cref="ChildContent"/> is provided.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Closed-catalog icon key rendered before the link text.</summary>
    [Parameter]
    public IconKey? LeadingIcon { get; set; }

    /// <summary>Closed-catalog icon key rendered after the link text.</summary>
    [Parameter]
    public IconKey? TrailingIcon { get; set; }

    /// <summary>
    /// Browsing context for the link (<c>_blank</c>, <c>_self</c>, ...). When <c>_blank</c>,
    /// <c>noopener noreferrer</c> is added to <see cref="Rel"/> and screen readers are told
    /// the link opens in a new tab.
    /// </summary>
    [Parameter]
    public string? Target { get; set; }

    /// <summary>Space-separated link relationship tokens (for example <c>nofollow</c>, <c>sponsored</c>).</summary>
    [Parameter]
    public string? Rel { get; set; }

    /// <summary>
    /// Accessible name for the link. Required when the link has no visible text
    /// (icon-only). Forwarded to the inner <c>&lt;a&gt;</c> element and replaces its content
    /// for assistive technologies. WCAG 4.1.2 Name, Role, Value.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    // IHasTransitions
    /// <summary>Transition classes applied to the link element.</summary>
    [Parameter]
    public BOBTransitions? Transitions { get; set; }

    // IHasSize
    /// <summary>Visual size of the link.</summary>
    [Parameter]
    public BOBSize Size { get; set; } = BOBSize.Medium;

    // IHasFullWidth
    /// <summary>When <see langword="true" />, the link spans the full width of its container.</summary>
    [Parameter]
    public bool FullWidth { get; set; }

    // IHasShadow
    /// <summary>Shadow style applied to the link.</summary>
    [Parameter]
    public ShadowStyle? Shadow { get; set; }

    // IHasBorder
    /// <summary>Border style applied to the link.</summary>
    [Parameter]
    public BorderStyle? Border { get; set; }

    // IHasDensity
    /// <summary>Spacing between icons and text.</summary>
    [Parameter]
    public BOBDensity Density { get; set; } = BOBDensity.Standard;

    // IHasBackgroundColor
    /// <summary>Background color of the link. Accepts any valid CSS color value, <see cref="PaletteColor"/> or <see cref="BOBColor"/>.</summary>
    [Parameter]
    public string? BackgroundColor { get; set; }

    // IHasColor
    /// <summary>Text and icon color of the link. Accepts any valid CSS color value, <see cref="PaletteColor"/> or <see cref="BOBColor"/>.</summary>
    [Parameter]
    public string? Color { get; set; }

    [Inject] internal IStringLocalizer<BOBNavigationResources> Localizer { get; set; } = default!;

    /* ========= Variant ========= */

    public override BOBLinkVariant DefaultVariant => BOBLinkVariant.Text;

    protected override Dictionary<BOBLinkVariant, Func<BOBLink, RenderFragment>> BuiltInTemplates { get; } = new()
    {
        [BOBLinkVariant.Text] = l => l.RenderDefault(),
        [BOBLinkVariant.Button] = l => l.RenderDefault()
    };

    /* ========= Derived state ========= */

    private bool OpensInNewTab => string.Equals(Target, "_blank", StringComparison.OrdinalIgnoreCase);

    // Reverse-tabnabbing protection: a page opened with target="_blank" must not get window.opener.
    private string? ResolvedRel
    {
        get
        {
            List<string> tokens = string.IsNullOrWhiteSpace(Rel)
                ? []
                : [.. Rel.Split(' ', StringSplitOptions.RemoveEmptyEntries)];

            if (OpensInNewTab)
            {
                foreach (string required in (string[])["noopener", "noreferrer"])
                {
                    if (!tokens.Contains(required, StringComparer.OrdinalIgnoreCase))
                    {
                        tokens.Add(required);
                    }
                }
            }

            return tokens.Count == 0 ? null : string.Join(' ', tokens);
        }
    }

    /* ========= Render ========= */

    private RenderFragment RenderDefault() => __builder =>
    {
        <bob-component @attributes="@ComputedAttributes">
            <a href="@Href"
               target="@Target"
               rel="@ResolvedRel"
               aria-label="@AriaLabel"
               class="bob-link__anchor transition-target">
                @if (ChildContent != null)
                {
                    @ChildContent
                }
                else
                {
                    @if (LeadingIcon.HasValue)
                    {
                        <BOBSvgIcon Icon="@LeadingIcon.Value" class="bob-link__icon bob-link__icon--leading"
                                    Size="@Size"/>
                    }

                    @if (!string.IsNullOrWhiteSpace(Text))
                    {
                        <span class="bob-link__text">@Text</span>
                    }

                    @if (TrailingIcon.HasValue)
                    {
                        <BOBSvgIcon Icon="@TrailingIcon.Value" class="bob-link__icon bob-link__icon--trailing"
                                    Size="@Size"/>
                    }
                }
                @if (OpensInNewTab)
                {
                    <span class="sr-only">@Localizer["(opens in a new tab)"]</span>
                }
            </a>
        </bob-component>
    };

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        WarnIfMissingAccessibleName();
    }

    [System.Diagnostics.Conditional("DEBUG")]
    private void WarnIfMissingAccessibleName()
    {
        // Icon-only links (no Text, no ChildContent) need an explicit accessible name.
        if (string.IsNullOrWhiteSpace(Text)
            && ChildContent is null
            && string.IsNullOrWhiteSpace(AriaLabel)
            && (LeadingIcon.HasValue || TrailingIcon.HasValue))
        {
            System.Diagnostics.Debug.WriteLine(
                "[BlazOrbit][A11Y] BOBLink rendered icon-only without AriaLabel; " +
                "screen readers cannot announce its purpose. Set AriaLabel.");
        }
    }

}
