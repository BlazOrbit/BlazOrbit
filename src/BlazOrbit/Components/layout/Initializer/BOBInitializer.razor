@namespace BlazOrbit.Components
@using BlazOrbit.Themes
@using Microsoft.JSInterop

@implements IDisposable

@inject IThemeJsInterop ThemeInterop

@* Anti-flash bootstrap shipped as a StaticWebAsset. Emitted in place (not via <HeadContent>):
   HeadOutlet only renders the last <HeadContent>, so a page declaring its own title/meta
   would drop the script. A synchronous <script src> placed before ChildContent still runs
   before any following element is parsed, so `data-bob-theme` is set before content paints.
   External-file form is CSP-safe under `script-src 'self'`. *@
<script src="_content/BlazOrbit/anti-flash.js" data-default-theme="@DefaultTheme"></script>

@* Content renders immediately so static SSR and prerender emit real markup. Theme colors
   come from CSS custom properties; the cascaded palette is null until JS resolves it. *@
<CascadingValue Value="_palette" IsFixed="false">
    @ChildContent
</CascadingValue>

@code{

    /// <summary>Content rendered inside the component.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>DefaultTheme.</summary>
    [Parameter]
    public string DefaultTheme { get; set; } = "dark";

    private BOBPalette? _palette;

    protected override void OnInitialized()
    {
        ThemeInterop.OnThemeChanged += HandleThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await ThemeInterop.InitializeAsync(DefaultTheme);
        await LoadPaletteAsync();
        StateHasChanged();
    }

    private void HandleThemeChanged(string theme)
    {
        BOBAsyncHelper.SafeFireAndForget(HandleThemeChangedSafeAsync);
    }

    private async Task HandleThemeChangedSafeAsync()
    {
        try
        {
            await LoadPaletteAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task LoadPaletteAsync()
    {
        var colors = await ThemeInterop.GetPaletteAsync();

        // An empty or partial snapshot (JS module failed to load, stylesheet not applied yet)
        // keeps the previous palette instead of faulting the render loop.
        try
        {
            _palette = new BOBPalette(colors);
        }
        catch (Exception ex) when (ex is KeyNotFoundException or ArgumentException)
        {
        }
    }

    public void Dispose()
    {
        ThemeInterop.OnThemeChanged -= HandleThemeChanged;
    }

}