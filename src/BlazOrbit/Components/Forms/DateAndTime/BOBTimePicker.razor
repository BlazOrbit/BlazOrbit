@namespace BlazOrbit.Components.Forms
@attribute [GenerateComponentInfo]
@using System.Globalization
@using Microsoft.Extensions.Localization

@inherits BOBComponentBase
@implements IHasSize
@implements IHasDensity
@implements IPickerFamilyComponent

<bob-component @attributes="ComputedAttributes">
    <div class="bob-picker__row">
        <_BOBInBtn Size="Size" OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, ToggleFormatClicked))">
            @(Format == "24" ? "24h" : "12h")
        </_BOBInBtn>

        <div class="bob-picker__row bob-time-picker__fields">
            <div class="bob-time-picker__column">
                <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronUp"
                           AriaLabel="@Localizer["Increment hour"]"
                           OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, IncrementHourClicked))"/>
                <_BOBInText Value="@DisplayHour.ToString("00")"
                            ValueChanged="@(EventCallback.Factory.Create<string?>(this, OnHourInputChanged))"
                            class="bob-picker__input"
                            maxlength="2"/>
                <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronDown"
                           AriaLabel="@Localizer["Decrement hour"]"
                           OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, DecrementHourClicked))"/>
            </div>

            <span class="bob-picker__separator">:</span>

            <div class="bob-time-picker__column">
                <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronUp"
                           AriaLabel="@Localizer["Increment minute"]"
                           OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, IncrementMinuteClicked))"/>
                <_BOBInText Value="@Minute.ToString("00")"
                            ValueChanged="@(EventCallback.Factory.Create<string?>(this, OnMinuteInputChanged))"
                            class="bob-picker__input"
                            maxlength="2"/>
                <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronDown"
                           AriaLabel="@Localizer["Decrement minute"]"
                           OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, DecrementMinuteClicked))"/>
            </div>
        </div>

        @if (Format == "12")
        {
            <_BOBInBtn OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, ToggleAmPmClicked))">
                @AmPm
            </_BOBInBtn>
        }
    </div>
</bob-component>

@code {
    [Inject] internal IStringLocalizer<BOBFormsResources> Localizer { get; set; } = default!;

    /// <summary>Current value of the component.</summary>
    [Parameter]
    public TimeOnly? Value { get; set; }

    /// <summary>Raised when the value changes.</summary>
    [Parameter]
    public EventCallback<TimeOnly?> ValueChanged { get; set; }

    /// <summary>Visual size of the component.</summary>
    [Parameter]
    public BOBSize Size { get; set; } = BOBSize.Medium;

    /// <summary>Vertical density (gap) of the component.</summary>
    [Parameter]
    public BOBDensity Density { get; set; } = BOBDensity.Standard;

    private int Hour;
    private int Minute;
    private string Format = "24";
    private string AmPm = "AM";

    private int DisplayHour => Format == "24" ? Hour : Hour % 12 == 0 ? 12 : Hour % 12;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Format = CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern.Contains("tt") ? "12" : "24";
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Value.HasValue)
        {
            Hour = Value.Value.Hour;
            Minute = Value.Value.Minute;
            AmPm = Hour >= 12 ? "PM" : "AM";
        }
    }

    private async Task IncrementHourClicked(MouseEventArgs e)
    {
        await UpdateHour((Hour + 1) % 24);
    }

    private async Task DecrementHourClicked(MouseEventArgs e)
    {
        await UpdateHour((Hour + 23) % 24);
    }

    private async Task IncrementMinuteClicked(MouseEventArgs e)
    {
        await UpdateMinute((Minute + 1) % 60);
    }

    private async Task DecrementMinuteClicked(MouseEventArgs e)
    {
        await UpdateMinute((Minute + 59) % 60);
    }

    private async Task OnHourInputChanged(string? value)
    {
        if (int.TryParse(value, out var h))
        {
            if (Format == "12")
            {
                if (h >= 1 && h <= 12)
                {
                    var newHour = h == 12 ? 0 : h;
                    if (AmPm == "PM") newHour += 12;
                    await UpdateHour(newHour);
                }
            }
            else if (h >= 0 && h < 24)
            {
                await UpdateHour(h);
            }
        }
    }

    private async Task OnMinuteInputChanged(string? value)
    {
        if (int.TryParse(value, out var m) && m >= 0 && m < 60)
            await UpdateMinute(m);
    }

    private async Task UpdateHour(int newHour)
    {
        Hour = newHour;
        AmPm = Hour >= 12 ? "PM" : "AM";
        await NotifyValueChanged();
    }

    private async Task UpdateMinute(int newMinute)
    {
        Minute = newMinute;
        await NotifyValueChanged();
    }

    private async Task NotifyValueChanged()
    {
        await ValueChanged.InvokeAsync(new TimeOnly(Hour, Minute));
    }

    private void ToggleFormatClicked(MouseEventArgs e)
    {
        Format = Format == "24" ? "12" : "24";
    }

    private async Task ToggleAmPmClicked(MouseEventArgs e)
    {
        if (AmPm == "AM")
        {
            AmPm = "PM";
            if (Hour < 12) Hour += 12;
        }
        else
        {
            AmPm = "AM";
            if (Hour >= 12) Hour -= 12;
        }

        await NotifyValueChanged();
    }

}