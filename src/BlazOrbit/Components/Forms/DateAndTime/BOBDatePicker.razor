@using System.Globalization
@using Microsoft.Extensions.Localization
@namespace BlazOrbit.Components.Forms
@attribute [GenerateComponentInfo]

@inherits BOBComponentBase
@implements IHasSize
@implements IHasDensity
@implements IPickerFamilyComponent

<bob-component @attributes="ComputedAttributes">
    <div class="bob-picker__row">
        <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronLeft"
                   AriaLabel="@Localizer["Previous year"]"
                   OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, PrevYearClicked))"/>
        <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronLeft"
                   AriaLabel="@Localizer["Previous month"]"
                   OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, PrevMonthClicked))"/>
        <span class="bob-picker__title">@CurrentMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</span>
        <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronRight"
                   AriaLabel="@Localizer["Next month"]"
                   OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, NextMonthClicked))"/>
        <_BOBInBtn Icon="@BOBIconKeys.UI.ChevronRight"
                   AriaLabel="@Localizer["Next year"]"
                   OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, NextYearClicked))"/>
    </div>

    <div class="bob-picker__grid">
        @foreach (var day in WeekDays)
        {
            <span class="bob-picker__cell" data-bob-muted="true">@day[..2]</span>
        }
        @foreach (var day in Days)
        {
            <_BOBInBtn Active="@day.IsSelected"
                       class="bob-picker__cell"
                       data-bob-muted="@(!day.IsCurrentMonth ? "true" : null)"
                       OnClick="@(() => SelectDateClicked(day.Date))">
                @day.Date.Day
            </_BOBInBtn>
        }
    </div>
</bob-component>

@code {
    [Inject] internal IStringLocalizer<BOBFormsResources> Localizer { get; set; } = default!;

    /// <summary>Current value of the component.</summary>
    [Parameter]
    public DateOnly? Value { get; set; }

    /// <summary>Raised when the value changes.</summary>
    [Parameter]
    public EventCallback<DateOnly?> ValueChanged { get; set; }

    /// <summary>Visual size of the component.</summary>
    [Parameter]
    public BOBSize Size { get; set; } = BOBSize.Medium;

    /// <summary>Vertical density (gap) of the component.</summary>
    [Parameter]
    public BOBDensity Density { get; set; } = BOBDensity.Standard;

    private DateTime CurrentMonth = DateTime.Today;
    private DateOnly SelectedDate = DateOnly.FromDateTime(DateTime.Today);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Value.HasValue)
        {
            SelectedDate = Value.Value;
            CurrentMonth = new DateTime(Value.Value.Year, Value.Value.Month, 1);
        }
    }

    private void PrevYearClicked(MouseEventArgs e)
    {
        CurrentMonth = CurrentMonth.AddYears(-1);
    }

    private void NextYearClicked(MouseEventArgs e)
    {
        CurrentMonth = CurrentMonth.AddYears(1);
    }

    private void PrevMonthClicked(MouseEventArgs e)
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
    }

    private void NextMonthClicked(MouseEventArgs e)
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
    }

    private async Task SelectDateClicked(DateOnly date)
    {
        SelectedDate = date;
        CurrentMonth = new DateTime(date.Year, date.Month, 1);
        await ValueChanged.InvokeAsync(SelectedDate);
    }

    private IEnumerable<string> WeekDays => CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;

    private IEnumerable<DayCell> Days
    {
        get
        {
            DateOnly firstOfMonth = new(CurrentMonth.Year, CurrentMonth.Month, 1);
            var start = firstOfMonth.AddDays(-(int)firstOfMonth.DayOfWeek);
            return Enumerable.Range(0, 42).Select(i =>
            {
                var d = start.AddDays(i);
                return new DayCell
                {
                    Date = d,
                    IsCurrentMonth = d.Month == CurrentMonth.Month,
                    IsSelected =
                        SelectedDate.DayNumber == d.DayNumber
                        && SelectedDate.Month == d.Month
                        && SelectedDate.Year == d.Year
                };
            });
        }
    }

    private sealed class DayCell
    {
        public DateOnly Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsSelected { get; set; }
    }

}