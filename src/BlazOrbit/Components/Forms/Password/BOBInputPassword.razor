@using BlazOrbit.Abstractions
@using BlazOrbit.Components.Display
@using BlazOrbit.Utilities
@using System.Diagnostics.CodeAnalysis
@using Microsoft.Extensions.Localization

@namespace BlazOrbit.Components.Forms
@attribute [GenerateComponentInfo]

@inherits BOBInputComponentBase<string, BOBInputPassword, BOBInputVariant>
@implements IBuiltComponent
@implements IHasSize
@implements IHasLoading
@implements IHasDensity
@implements IHasShadow
@implements IHasColor
@implements IHasBackgroundColor
@implements IHasPrefix
@implements IHasSuffix
@implements IInputFamilyComponent

@{
    base.BuildRenderTree(__builder);
}

@code {
    [Inject] internal IStringLocalizer<BOBFormsResources> Localizer { get; set; } = default!;

    private readonly string _inputId = $"bob-input-{Guid.NewGuid():N}";
    private readonly string _helperTextId = $"bob-helper-{Guid.NewGuid():N}";
    private readonly string _strengthId = $"bob-label-{Guid.NewGuid():N}";
    private bool _isFocused;
    private bool _isDirty;
    private bool _isRevealed;
    private BOBPasswordStrength _strength = BOBPasswordStrength.None;
    private BOBPasswordStrength _lastReportedStrength = BOBPasswordStrength.None;

    // IHasSize
    /// <summary>Visual size of the input.</summary>
    [Parameter] public BOBSize Size { get; set; } = BOBSize.Medium;

    // IHasLoading
    /// <summary>When <see langword="true" />, the input shows a loading indicator.</summary>
    [Parameter] public bool Loading { get; set; }
    /// <summary>Variant of the loading indicator shown when <see cref="Loading"/> is <see langword="true"/>.</summary>
    [Parameter] public BOBProgressIconVariant LoadingIndicatorVariant { get; set; } = BOBProgressIconVariant.Ring;

    // IHasDensity
    /// <summary>Vertical density (gap) of the input.</summary>
    [Parameter] public BOBDensity Density { get; set; } = BOBDensity.Standard;

    // IHasShadow
    /// <summary>Shadow style applied to the input container.</summary>
    [Parameter] public ShadowStyle? Shadow { get; set; }

    // IHasBackgroundColor
    /// <summary>Background color of the input. Accepts any valid CSS color value, <see cref="PaletteColor"/> or <see cref="BOBColor"/>.</summary>
    [Parameter] public string? BackgroundColor { get; set; }

    // IHasColor
    /// <summary>Text color of the input. Accepts any valid CSS color value, <see cref="PaletteColor"/> or <see cref="BOBColor"/>.</summary>
    [Parameter] public string? Color { get; set; }

    // IHasPrefix
    /// <summary>Text displayed before the input value.</summary>
    [Parameter] public string? PrefixText { get; set; }
    /// <summary>Material icon name displayed before the input value.</summary>
    [Parameter] public IconKey? PrefixIcon { get; set; }
    /// <summary>Color of the prefix text or icon.</summary>
    [Parameter] public string? PrefixColor { get; set; }
    /// <summary>Background color of the prefix area.</summary>
    [Parameter] public string? PrefixBackgroundColor { get; set; }

    // IHasSuffix
    /// <summary>Text displayed after the input value (rendered before the visibility toggle when enabled).</summary>
    [Parameter] public string? SuffixText { get; set; }
    /// <summary>Material icon name displayed after the input value.</summary>
    [Parameter] public IconKey? SuffixIcon { get; set; }
    /// <summary>Color of the suffix text or icon.</summary>
    [Parameter] public string? SuffixColor { get; set; }
    /// <summary>Background color of the suffix area.</summary>
    [Parameter] public string? SuffixBackgroundColor { get; set; }

    // Component-specific
    /// <summary>Placeholder text shown when the input is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Floating label displayed above the input when it has a value or focus.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Helper text displayed below the input for additional context.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>When <see langword="true" />, the bound value is updated on every keystroke instead of only on blur.</summary>
    [Parameter] public bool UpdateOnInput { get; set; }
    /// <summary>Raised on every keystroke when <see cref="UpdateOnInput"/> is enabled.</summary>
    [Parameter] public EventCallback<string> OnInput { get; set; }
    /// <summary>
    /// Trailing-edge debounce delay applied to <see cref="OnInput"/> only. See <see cref="BOBInputText.OnInputDebounceMs"/>.
    /// </summary>
    [Parameter] public int OnInputDebounceMs { get; set; }

    // Password-specific
    /// <summary>When <see langword="true" /> (default), an eye-icon button toggles plaintext visibility.</summary>
    [Parameter] public bool ShowVisibilityToggle { get; set; } = true;
    /// <summary>When <see langword="true" />, render an inline strength meter below the input.</summary>
    [Parameter] public bool ShowStrengthMeter { get; set; }
    /// <summary>Minimum length used by strength scoring. Defaults to <c>8</c>.</summary>
    [Parameter] public int MinLength { get; set; } = 8;
    /// <summary>Flags indicating which password strength requirements are enforced.</summary>
    [Parameter]
    public PasswordStrengthFlags StrengthFlags { get; set; }
    = PasswordStrengthFlags.HasUpper
    | PasswordStrengthFlags.HasLower
    | PasswordStrengthFlags.HasDigit
    | PasswordStrengthFlags.HasSymbol
    | PasswordStrengthFlags.MeetsLength;
    /// <summary>Raised whenever the computed <see cref="BOBPasswordStrength"/> changes.</summary>
    [Parameter] public EventCallback<BOBPasswordStrength> OnStrengthChanged { get; set; }

    private BOBDebouncer<string>? _onInputDebouncer;

    private bool HasValue => !string.IsNullOrEmpty(CurrentValue);
    private bool IsFloated => _isFocused || HasValue || _isDirty;

    public void BuildComponentDataAttributes(Dictionary<string, object> dataAttributes)
    {
        if (IsFloated)
            dataAttributes[FeatureDefinitions.DataAttributes.Floated] = "true";
        else
            dataAttributes.Remove(FeatureDefinitions.DataAttributes.Floated);
    }

    public void BuildComponentCssVariables(Dictionary<string, string> cssVariables) { }

    public override BOBInputVariant DefaultVariant => BOBInputVariant.Outlined;

    protected override IReadOnlyDictionary<BOBInputVariant, Func<BOBInputPassword, RenderFragment>> BuiltInTemplates { get; } =
        new Dictionary<BOBInputVariant, Func<BOBInputPassword, RenderFragment>>
        {
            [BOBInputVariant.Outlined] = i => i.RenderInput(),
            [BOBInputVariant.Filled] = i => i.RenderInput(),
            [BOBInputVariant.Standard] = i => i.RenderInput(),
            [BOBInputVariant.Flat] = i => i.RenderInput()
        };

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        BOBPasswordStrength next = ComputeStrength(CurrentValue);
        if (next != _strength)
        {
            _strength = next;
        }
    }

    /// <summary>Score 0..4 fed to BOBProgressBar — None=0, Weak=1, Fair=2, Good=3, Strong=4.</summary>
    private int StrengthValue => _strength switch
    {
        BOBPasswordStrength.Weak => 1,
        BOBPasswordStrength.Fair => 2,
        BOBPasswordStrength.Good => 3,
        BOBPasswordStrength.Strong => 4,
        _ => 0,
    };

    /// <summary>Per-tier palette color forwarded to BOBProgressBar; transparent dims the bar at the None tier.</summary>
    private string StrengthColor => _strength switch
    {
        BOBPasswordStrength.Weak => PaletteColor.Error,
        BOBPasswordStrength.Fair => PaletteColor.Warning,
        BOBPasswordStrength.Good => PaletteColor.Info,
        BOBPasswordStrength.Strong => PaletteColor.Success,
        _ => "transparent",
    };

    private BOBPasswordStrength ComputeStrength(string? value)
    {
        // Pure function of parameters + current value. Fast path: empty → None.
        if (string.IsNullOrEmpty(value)) return BOBPasswordStrength.None;

        Dictionary<string, bool> requirements = new();
        var currentFlags = CheckFlags();

        if (StrengthFlags.HasFlag(PasswordStrengthFlags.HasUpper)) { requirements[nameof(PasswordStrengthFlags.HasUpper)] = currentFlags.HasFlag(PasswordStrengthFlags.HasUpper); }
        if (StrengthFlags.HasFlag(PasswordStrengthFlags.HasLower)) { requirements[nameof(PasswordStrengthFlags.HasLower)] = currentFlags.HasFlag(PasswordStrengthFlags.HasLower); }
        if (StrengthFlags.HasFlag(PasswordStrengthFlags.HasDigit)) { requirements[nameof(PasswordStrengthFlags.HasDigit)] = currentFlags.HasFlag(PasswordStrengthFlags.HasDigit); }
        if (StrengthFlags.HasFlag(PasswordStrengthFlags.HasSymbol)) { requirements[nameof(PasswordStrengthFlags.HasSymbol)] = currentFlags.HasFlag(PasswordStrengthFlags.HasSymbol); }
        if (StrengthFlags.HasFlag(PasswordStrengthFlags.MeetsLength)) { requirements[nameof(PasswordStrengthFlags.MeetsLength)] = currentFlags.HasFlag(PasswordStrengthFlags.MeetsLength); }

        // Scoring: Strength scoring is relative to flags enabled via the StrengthFlags parameter.
        // If a flag is not enabled, it does not affect the score. If a flag is enabled, failure to meet that requirement results in a penalty to the score.
        // Each unmet requirement downgrades the strength by one level, with Weak being the lowest possible score.
        if (requirements.ContainsKey(nameof(PasswordStrengthFlags.MeetsLength))
            && !requirements[nameof(PasswordStrengthFlags.MeetsLength)]) { return BOBPasswordStrength.Weak; }
        if ((requirements.ContainsKey(nameof(PasswordStrengthFlags.HasUpper)) && !requirements[nameof(PasswordStrengthFlags.HasUpper)])
            || (requirements.ContainsKey(nameof(PasswordStrengthFlags.HasLower)) && !requirements[nameof(PasswordStrengthFlags.HasLower)]))
        {
            return BOBPasswordStrength.Weak;
        }
        if (requirements.ContainsKey(nameof(PasswordStrengthFlags.HasDigit))
            && !requirements[nameof(PasswordStrengthFlags.HasDigit)])
        {
            return BOBPasswordStrength.Fair;
        }
        if (requirements.ContainsKey(nameof(PasswordStrengthFlags.HasSymbol))
            && !requirements[nameof(PasswordStrengthFlags.HasSymbol)])
        {
            return BOBPasswordStrength.Good;
        }
        return BOBPasswordStrength.Strong;

        PasswordStrengthFlags CheckFlags()
        {
            PasswordStrengthFlags currentFlags = 0;
            if (value.Length >= MinLength) { currentFlags = currentFlags | PasswordStrengthFlags.MeetsLength; }
            foreach (char c in value)
            {
                if (c >= 'A' && c <= 'Z') { currentFlags = currentFlags | PasswordStrengthFlags.HasUpper; }
                else if (c >= 'a' && c <= 'z') { currentFlags = currentFlags | PasswordStrengthFlags.HasLower; }
                else if (c >= '0' && c <= '9') { currentFlags = currentFlags | PasswordStrengthFlags.HasDigit; }
                else if (c >= 33 && c <= 126) { currentFlags = currentFlags | PasswordStrengthFlags.HasSymbol; }
            }
            return currentFlags;
        }
    }

    private RenderFragment RenderInput() => __builder =>
    {
        <bob-component @attributes="ComputedAttributes">

            <div class="bob-input__wrapper">

                <BOBInputOutline Label="@Label" For="@_inputId" Required="@IsRequired" />
                <BOBInputPrefix PrefixText="@PrefixText" PrefixIcon="@PrefixIcon" Size="@Size" />

                <input type="@(_isRevealed ? "text" : "password")"
                       id="@_inputId"
                       class="bob-input__field"
                       autocomplete="current-password"
                       value="@CurrentValue"
                       @onchange="HandleChange"
                       @oninput="HandleInput"
                       @onfocus="HandleFocus"
                       @onblur="HandleBlur"
                       aria-label="@(string.IsNullOrWhiteSpace(Label) ? Placeholder : null)"
                       aria-describedby="@(ShowStrengthMeter ? $"{_helperTextId} {_strengthId}" : _helperTextId)"
                       aria-invalid="@IsError.ToString().ToLower()"
                       aria-required="@IsRequired.ToString().ToLower()"
                       placeholder="@(IsFloated ? Placeholder : null)"
                       disabled="@IsDisabled"
                       readonly="@IsReadOnly"
                       required="@IsRequired" />

                <BOBInputSuffix SuffixText="@SuffixText" SuffixIcon="@SuffixIcon" Size="@Size" />

                @if (ShowVisibilityToggle)
                {
                    <button type="button"
                            class="bob-password__toggle"
                            tabindex="-1"
                            aria-label="@(_isRevealed ? Localizer["HidePassword"] : Localizer["ShowPassword"])"
                            aria-pressed="@_isRevealed.ToString().ToLowerInvariant()"
                            disabled="@IsDisabled"
                            @onclick="ToggleVisibility">
                        <BOBSvgIcon Icon="@(_isRevealed ? BOBIconKeys.MaterialIconsOutlined.i_visibility_off : BOBIconKeys.MaterialIconsOutlined.i_visibility)"
                                    Size="@Size" />
                    </button>
                }

                <BOBInputLoading Loading="@Loading" LoadingIndicatorVariant="@LoadingIndicatorVariant" Size="@Size" />

            </div>

            @if (ShowStrengthMeter)
            {
                @* Strength meter delegates the visual to BOBProgressBar (Segments=4) — 4 tiers
                   (Weak / Fair / Good / Strong) map to filled segment count + per-tier color.
                   The flex wrapper keeps the textual label on the trailing edge, mirroring
                   the pre-refactor layout while removing the inline bar/gradient CSS. *@
                <div id="@_strengthId"
                     class="bob-password__strength"
                     data-bob-strength="@_strength.ToString().ToLowerInvariant()"
                     aria-live="polite">
                    <BOBProgressBar Value="@StrengthValue"
                                    Min="0"
                                    Max="4"
                                    Segments="4"
                                    Color="@StrengthColor"
                                    Size="BOBSize.Small"
                                    class="bob-password__strength-bar" />
                    <span class="bob-password__strength-label">@_strength</span>
                </div>
            }

            <_BOBFieldHelper TValue="string"
                             Id="@_helperTextId"
                             HelperText="@HelperText"
                             ShowValidation="@IsError"
                             EditContext="@EditContext"
                             For="@ValueExpression" />

        </bob-component>
    };

    private void HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        string inputValue = e.Value?.ToString() ?? string.Empty;
        _isDirty = !string.IsNullOrEmpty(inputValue);

        if (UpdateOnInput)
        {
            CurrentValueAsString = inputValue;
        }

        // Strength is recomputed from the live keystroke value rather than CurrentValue, so the
        // meter reacts on every keypress even when UpdateOnInput is false (the meter is purely
        // visual feedback; binding semantics stay opt-in).
        BOBPasswordStrength next = ComputeStrength(inputValue);
        if (next != _strength)
        {
            _strength = next;
            if (next != _lastReportedStrength && OnStrengthChanged.HasDelegate)
            {
                _lastReportedStrength = next;
                await OnStrengthChanged.InvokeAsync(next);
            }
        }

        if (!OnInput.HasDelegate)
        {
            return;
        }

        if (OnInputDebounceMs > 0)
        {
            _onInputDebouncer ??= new BOBDebouncer<string>
            (TimeSpan.FromMilliseconds(OnInputDebounceMs));
            await _onInputDebouncer.InvokeAsync(inputValue, v => OnInput.InvokeAsync(v));
        }
        else
        {
            _onInputDebouncer?.Cancel();
            await OnInput.InvokeAsync(inputValue);
        }
    }

    private void ToggleVisibility()
    {
        if (IsDisabled || IsReadOnly) return;
        _isRevealed = !_isRevealed;
    }

    public override async ValueTask DisposeAsync()
    {
        _onInputDebouncer?.Dispose();
        await base.DisposeAsync();
    }

    private void HandleFocus(FocusEventArgs e)
    {
        _isFocused = true;
    }

    private void HandleBlur(FocusEventArgs e)
    {
        _isFocused = false;
        _isDirty = false;
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }
}
