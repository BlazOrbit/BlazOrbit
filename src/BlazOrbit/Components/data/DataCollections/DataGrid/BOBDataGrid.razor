@using BlazOrbit.Abstractions
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization

@namespace BlazOrbit.Components
@attribute [GenerateComponentInfo]

@typeparam TItem
@inherits BOBDataCollectionBase<TItem, BOBDataGrid<TItem>, DataGridVariant>

@{
    base.BuildRenderTree(__builder);
}

<CascadingValue Value="@((IDataColumnRegistry<TItem>)ColumnRegistry)" Name="DataColumnRegistry">
    @Columns
</CascadingValue>

<bob-component @attributes="ComputedAttributes">
    @if (ColumnsBuilt)
    {
    <div role="status" aria-live="polite" class="sr-only">@LiveRegionMessage</div>

    @if (Filterable || ShowPageSizeSelector || HasVisibleBulkActions || HasBatchPendingChanges || Copyable)
    {
    <div class="bob-dc__toolbar">
        @if (Filterable)
        {
            <div class="bob-dc__filter">
                <_BOBInText Value="@State.FilterText"
                            Placeholder="@ResolvedFilterPlaceholder"
                            AriaLabel="@ResolvedFilterPlaceholder"
                            UpdateOnInput="true"
                            OnInput="@(EventCallback.Factory.Create<string?>(this, HandleFilterInputChange))"/>
                @if (!string.IsNullOrEmpty(State.FilterText))
                {
                    <_BOBInBtn Icon="@BOBIconKeys.UI.Close"
                               Variant="BOBInBtnVariant.Ghost"
                               AriaLabel="@Localizer["Clear filter"]"
                               OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, ClearFilterClicked))"/>
                }
            </div>
        }

        <div class="bob-dc__toolbar-spacer"></div>

        @if (SelectionMode != SelectionMode.None && State.SelectedItems.Any())
        {
            <div class="bob-dc__selection-info">
                <span>@string.Format(Localizer["{0} selected"], State.SelectedItems.Count)</span>
                <_BOBInBtn OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, ClearSelectionClicked))">
                    @Localizer["Clear"]
                </_BOBInBtn>
                @foreach (var bulk in VisibleBulkActions())
                {
                    var capturedBulk = bulk;
                    var bulkEnabled = bulk.Enabled is null || bulk.Enabled(State.SelectedItems.ToList());
                    <_BOBInBtn Icon="@bulk.Icon"
                               Disabled="@(!bulkEnabled)"
                               AriaLabel="@bulk.Label"
                               OnClick="@(_ => InvokeBulkActionAsync(capturedBulk))">
                        @bulk.Label
                    </_BOBInBtn>
                }
            </div>
        }

        @if (HasBatchPendingChanges)
        {
            <div class="bob-dc__batch-actions" role="group" aria-label="@Localizer["Pending changes"]">
                <span class="bob-dc__batch-count">
                    @string.Format(Localizer["{0} rows pending"], _batchSnapshots.Count)
                </span>
                @if (HasUnresolvedValidationErrors)
                {
                    <span class="bob-dc__batch-errors" role="status" aria-live="polite">
                        @string.Format(Localizer["{0} invalid"], _cellErrors.Count)
                    </span>
                }
                <_BOBInBtn Icon="@BOBIconKeys.UI.Check"
                           Disabled="@HasUnresolvedValidationErrors"
                           AriaLabel="@Localizer["Save changes"]"
                           OnClick="@(_ => CommitBatchAsync())">
                    @Localizer["Save"]
                </_BOBInBtn>
                <_BOBInBtn Icon="@BOBIconKeys.UI.Close"
                           Variant="BOBInBtnVariant.Ghost"
                           AriaLabel="@Localizer["Discard changes"]"
                           OnClick="@(_ => CancelBatchAsync())">
                    @Localizer["Cancel"]
                </_BOBInBtn>
            </div>
        }

        @if (ShowPageSizeSelector)
        {
        <div class="bob-dc__page-size">
            <label>@Localizer["Show"]</label>
            <_BOBInSelect Value="@State.PageSize.ToString()"
                          AriaLabel="@Localizer["Items per page"]"
            "
            ValueChanged="@(EventCallback.Factory.Create<string?>(this, HandlePageSizeSelectChange))">
            @foreach (var size in PageSizeOptions)
            {
                <option value="@size">@size</option>
            }
            </_BOBInSelect>
        </div>
        }

        @if (Copyable)
        {
            <div class="bob-dc__copy-action">
                <_BOBInBtn Icon="@BOBIconKeys.UI.Copy"
                           Variant="BOBInBtnVariant.Ghost"
                           AriaLabel="@Localizer["Copy to clipboard"]"
                           OnClick="@(_ => HandleCopyAsync())">
                    @Localizer["Copy"]
                </_BOBInBtn>
            </div>
        }
    </div>
    }

    @if (Loading)
    {
        @if (LoadingContent != null)
        {
            <div class="bob-dc__loading">@LoadingContent</div>
        }
        else if (LoadingMode == LoadingMode.Skeleton)
        {
            var skeletonCols = VisibleColumns.Count
                               + (SelectionMode != SelectionMode.None ? 1 : 0)
                               + (HasRowDetail ? 1 : 0)
                               + (HasRowActions ? 1 : 0);
            var skeletonRows = PageSize ?? 6;
            <div class="bob-dc__skeleton" role="status" aria-live="polite" aria-label="@Localizer["Loading data"]">
                @for (var r = 0; r < skeletonRows; r++)
                {
                    <div class="bob-dc__skeleton-row">
                        @for (var c = 0; c < Math.Max(1, skeletonCols); c++)
                        {
                            <div class="bob-dc__skeleton-cell"></div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bob-dc__loading bob-dc__loading--spinner" role="status" aria-live="polite"
                 aria-label="@Localizer["Loading"]">
                <div class="bob-dc__spinner" aria-hidden="true"></div>
            </div>
        }
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="bob-dc__error" role="alert">
            @if (ErrorContent != null)
            {
                @ErrorContent
            }
            else
            {
                <span class="bob-dc__error-icon" aria-hidden="true">⚠</span>
                <p class="bob-dc__error-text">@Error</p>
            }
        </div>
    }
    else
    {
        <div class="bob-datagrid__container" style="@GetContainerStyle()">
            <table class="bob-datagrid__table" role="grid" aria-rowcount="@FilteredItems.Count">
                <thead class="bob-datagrid__header">
                <tr role="row">
                    @if (HasRowDetail)
                    {
                        <th class="bob-datagrid__header-cell bob-datagrid__expand-cell"
                            role="columnheader" scope="col" aria-label="@Localizer["Expand row"]"></th>
                    }
                    @if (SelectionMode != SelectionMode.None)
                    {
                        <th class="bob-datagrid__header-cell bob-datagrid__select-cell" role="columnheader" scope="col">
                            @if (SelectionMode == SelectionMode.Multiple)
                            {
                                <_BOBInBtn Icon="@GetSelectAllIcon()"
                                           Size="BOBSize.Small"
                                           AriaLabel="@(IsAllSelected() ? Localizer["Deselect all"] : Localizer["Select all"])"
                                           OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, HandleSelectAllClick))"/>
                            }
                        </th>
                    }
                    @foreach (var col in VisibleColumns)
                    {
                        @* Drag attrs are inlined (not splatted via @attributes) because Blazor
                                   directive modifiers like `ondragover:preventDefault` and event handlers
                                   for drag events only wire up correctly when declared as Razor markup
                                   directives — passing them through a Dictionary leaks the raw key as a
                                   literal DOM attribute and the browser silently ignores it. *@
                        <th class="bob-datagrid__header-cell @GetAlignClass(col.Align, "bob-datagrid__cell") @GetFrozenClass(col) @col.HeaderClass"
                            style="@BuildHeaderCellStyle(col)"
                            role="columnheader"
                            scope="col"
                            tabindex="@(Reorderable ? 0 : (int?)null)"
                            draggable="@(Reorderable ? "true" : null)"
                            data-bob-drag-source="@(Reorderable && string.Equals(DraggingColumnHeader, col.Header, StringComparison.OrdinalIgnoreCase) ? "true" : null)"
                            @ondragstart="@(e => HandleHeaderDragStart(col.Header ?? string.Empty, e))"
                            @ondragover="@(e => HandleHeaderDragOver(col.Header ?? string.Empty, e))"
                            @ondragover:preventDefault="@Reorderable"
                            @ondrop="@(e => HandleHeaderDrop(col.Header ?? string.Empty, e))"
                            @ondragend="HandleHeaderDragEnd"
                            @onkeydown="@(e => HandleHeaderKeyDown(col.Header ?? string.Empty, e))"
                            @onkeydown:preventDefault="_preventHeaderKeyDefault"
                            aria-sort="@GetAriaSort(col)">
                            @if (col.Sortable && Sortable)
                            {
                                var dir = GetSortDirection(col);
                                var priority = GetSortPriority(col);
                                @* draggable="@Reorderable" lets the sort button act as the drag
                                           source — otherwise a pointerdown on the button consumes the
                                           gesture for click semantics and the parent <th draggable="true">
                                           never sees a dragstart. dragstart bubbles up to the <th>'s
                                           handler so HandleHeaderDragStart still fires with the right
                                           column header. A pure click without drag motion still triggers
                                           the onclick sort handler — both gestures cohabit. *@
                                <button type="button"
                                        class="bob-datagrid__sort-btn"
                                        title="@(priority != null ? string.Format(Localizer["Sort priority {0}"], priority) : Localizer["Sort column"])"
                                        draggable="@(Reorderable ? "true" : "false")"
                                        @onclick="@((MouseEventArgs e) => HandleSortClick(col, e))">
                                            <span>
                                                @if (col.HeaderTemplate != null)
                                                {
                                                    @col.HeaderTemplate
                                                }
                                                else
                                                {
                                                    @col.Header
                                                }
                                            </span>
                                    <span class="bob-datagrid__sort-icon" aria-hidden="true">
                                                @if (dir == SortDirection.Ascending)
                                        {
                                            <BOBSvgIcon Icon="@BOBIconKeys.UI.ArrowUpward" Size="BOBSize.Small"/>
                                        }
                                        else if (dir == SortDirection.Descending)
                                        {
                                            <BOBSvgIcon Icon="@BOBIconKeys.UI.ArrowDownward" Size="BOBSize.Small"/>
                                        }
                                            </span>
                                    @if (priority is not null)
                                    {
                                        <span class="bob-datagrid__sort-priority"
                                              aria-label="@string.Format(Localizer["Sort priority {0}"], priority)">@priority</span>
                                    }
                                </button>
                            }
                            else
                            {
                                @if (col.HeaderTemplate != null)
                                {
                                    @col.HeaderTemplate
                                }
                                else
                                {
                                    @col.Header
                                }
                            }

                            @if (Resizable && col.Resizable && !string.IsNullOrEmpty(col.Header))
                            {
                                var capturedCol = col;
                                @* draggable="false" + ondragstart:stopPropagation keep the resizer from
                                           hijacking the <th draggable="true"> gesture when the user grabs the
                                           trailing edge — without them, a pointerdown on the resizer starts a
                                           column-reorder drag instead of a resize. *@
                                <div class="bob-datagrid__col-resizer"
                                     role="separator"
                                     aria-orientation="vertical"
                                     aria-label="@string.Format(Localizer["Resize column {0}"], col.Header)"
                                     draggable="false"
                                     @onpointerdown="@(e => StartColumnResize(capturedCol, e))"
                                     @onpointerdown:stopPropagation="true"
                                     @ondragstart:stopPropagation="true"
                                     @ondragover:preventDefault="true"></div>
                            }

                            @if (ShowColumnFilters && col.Filterable && col.ValueSelector != null && !string.IsNullOrEmpty(col.Header))
                            {
                                var columnKey = col.Header!;
                                State.ColumnFilters.TryGetValue(columnKey, out var currentValue);
                                var mode = col.FilterMode;
                                var currentOp = currentValue.Text is { Length: > 0 }
                                    ? currentValue.Operator
                                    : DefaultOperatorFor(mode);

                                @* The wrap opts out of the parent <th draggable="true"> gesture so
                                           a pointerdown on the operator <select> or filter <input> doesn't
                                           start a column-reorder drag. Clicks already stop propagation to
                                           keep header sort-click out of the picture. *@
                                <div class="bob-datagrid__column-filter-wrap"
                                     draggable="false"
                                     @onclick:stopPropagation="true"
                                     @ondragstart:stopPropagation="true"
                                     @ondragover:preventDefault="true">
                                    <_BOBInSelect Value="@currentOp.ToString()"
                                                  AriaLabel="@($"Operator {columnKey}")"
                                                  class="bob-datagrid__column-filter-op"
                                                  ValueChanged="@(v => HandleColumnFilterOperatorString(columnKey, v))">
                                        @foreach (var op in GetOperatorsFor(mode))
                                        {
                                            <option value="@op"
                                                    selected="@(op == currentOp)">@OperatorLabel(op)</option>
                                        }
                                    </_BOBInSelect>
                                    @switch (mode)
                                    {
                                        case ColumnFilterMode.Date:
                                            @* Date inputs commit on picker selection / blur, not per keystroke — bind via
                                                       ValueChanged (onchange) so a partial calendar entry doesn't churn the filter
                                                       pipeline with empty strings while the user is mid-edit. *@
                                            <_BOBInDate Value="@currentValue.Text"
                                                        Placeholder="@FilterPlaceholder"
                                                        AriaLabel="@($"Filter {columnKey}")"
                                                        ValueChanged="@(v => HandleColumnFilterInputText(columnKey, v))"
                                                        class="bob-datagrid__column-filter"/>
                                            break;
                                        case ColumnFilterMode.Numeric:
                                            <_BOBInText Value="@currentValue.Text"
                                                        Placeholder="@FilterPlaceholder"
                                                        AriaLabel="@($"Filter {columnKey}")"
                                                        UpdateOnInput="true"
                                                        OnInput="@(v => HandleColumnFilterInputText(columnKey, v))"
                                                        class="bob-datagrid__column-filter"
                                                        inputmode="decimal"/>
                                            break;
                                        default:
                                            <_BOBInText Value="@currentValue.Text"
                                                        Placeholder="@FilterPlaceholder"
                                                        AriaLabel="@($"Filter {columnKey}")"
                                                        UpdateOnInput="true"
                                                        OnInput="@(v => HandleColumnFilterInputText(columnKey, v))"
                                                        class="bob-datagrid__column-filter"/>
                                            break;
                                    }
                                </div>
                            }
                        </th>
                    }
                    @if (HasRowActions)
                    {
                        <th class="bob-datagrid__header-cell bob-datagrid__actions-cell"
                            role="columnheader"
                            scope="col"
                            aria-label="@Localizer["Row actions"]"></th>
                    }
                </tr>
                </thead>
                <tbody>
                @if (UsesItemsProvider)
                {
                    @* DataSource + virtualization + height → infinite-scroll mode. Virtualize
                       drives slicing via ItemsProvider; the pagination footer is hidden below
                       so the user has a single scroll affordance. Placeholder renders while a
                       new slice is loading from the source. *@
                    <Virtualize @ref="VirtualizeRef"
                                ItemsProvider="ProvideVirtualizedItemsAsync"
                                Context="item">
                        <ItemContent>
                            @RenderRow(item, 0)
                        </ItemContent>
                        <Placeholder>
                            <tr class="bob-datagrid__row bob-datagrid__row--loading" role="row" aria-busy="true">
                                <td colspan="@(VisibleColumns.Count + (SelectionMode != SelectionMode.None ? 1 : 0) + (HasRowActions ? 1 : 0) + (HasRowDetail ? 1 : 0))"
                                    class="bob-datagrid__cell bob-datagrid__cell--loading">
                                    <span class="bob-datagrid__placeholder" aria-hidden="true"></span>
                                </td>
                            </tr>
                        </Placeholder>
                    </Virtualize>
                }
                else if (EnableVirtualization && !string.IsNullOrEmpty(Height))
                {
                    <Virtualize Items="@IndexedItems" Context="indexed">
                        @RenderRow(indexed.Item, indexed.Index)
                    </Virtualize>
                }
                else if (ProcessedItems.Any())
                {
                    var rowIndex = 0;
                    @foreach (var item in ProcessedItems)
                    {
                        @RenderRow(item, rowIndex)
                        rowIndex++;
                    }
                }
                else
                {
                    <tr class="bob-datagrid__empty-row" role="row">
                        <td colspan="@(VisibleColumns.Count + (SelectionMode != SelectionMode.None ? 1 : 0) + (HasRowActions ? 1 : 0) + (HasRowDetail ? 1 : 0))"
                            class="bob-datagrid__empty-cell">
                            @if (EmptyContent != null)
                            {
                                @EmptyContent
                            }
                            else
                            {
                                <div class="bob-dc__empty">
                                    <span class="bob-dc__empty-icon">📋</span>
                                    <p class="bob-dc__empty-text">@Localizer["No data available"]</p>
                                    @if (EmptyActionTemplate != null)
                                    {
                                        <div class="bob-dc__empty-actions">@EmptyActionTemplate</div>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>

                @if (HasAggregates)
                {
                    <tfoot class="bob-datagrid__footer bob-datagrid__footer--aggregate" role="rowgroup">
                    <tr role="row">
                        @if (HasRowDetail)
                        {
                            <td class="bob-datagrid__cell bob-datagrid__expand-cell" role="gridcell"></td>
                        }
                        @if (SelectionMode != SelectionMode.None)
                        {
                            <td class="bob-datagrid__cell bob-datagrid__select-cell" role="gridcell"></td>
                        }
                        @foreach (var col in VisibleColumns)
                        {
                            var aggregate = ComputeAggregate(col, FilteredItems);
                            <td class="bob-datagrid__cell bob-datagrid__aggregate-cell @GetAlignClass(col.Align, "bob-datagrid__cell") @GetFrozenClass(col) @col.CellClass"
                                style="@(col.Freeze != ColumnFreeze.None ? GetFrozenStyle(col) : null)"
                                role="gridcell"
                                aria-label="@(aggregate != null ? $"{col.Header} {GetAggregateLabel(col.Aggregate)}" : null)">
                                @aggregate
                            </td>
                        }
                        @if (HasRowActions)
                        {
                            <td class="bob-datagrid__cell bob-datagrid__actions-cell" role="gridcell"></td>
                        }
                    </tr>
                    </tfoot>
                }
                @if (FooterTemplate != null)
                {
                    <tfoot class="bob-datagrid__footer">
                    @FooterTemplate
                    </tfoot>
                }
            </table>

            @if (IsResizing)
            {
                @* Full-grid overlay activates only while a column resize is in progress,
                       capturing pointermove / pointerup so the cursor can leave the column
                       resizer mid-drag. Pure-Blazor alternative to setPointerCapture (mirrors
                       the BOBSplitter pattern). *@
                <div class="bob-datagrid__resize-overlay"
                     @onpointermove="OnResizePointerMove"
                     @onpointerup="EndColumnResize"
                     @onpointercancel="EndColumnResize"></div>
            }
        </div>
    }

    @if (PageSize.HasValue && FilteredItems.Any() && !UsesItemsProvider)
    {
        <_BOBInPagination CurrentPage="@State.CurrentPage"
                          TotalPages="@TotalPages"
                          TotalItems="@FilteredItems.Count"
                          PageSize="@State.PageSize"
                          OnPageChange="@(EventCallback.Factory.Create<int>(this, ChangePage))"/>
    }
    }
</bob-component>

@code {

    /// <summary>When <see langword="true" />, the header row stays fixed while scrolling.</summary>
    [Parameter]
    public bool FixedHeader { get; set; }

    /// <summary>Custom template for rendering each data row.</summary>
    [Parameter]
    public RenderFragment<TItem>? RowTemplate { get; set; }

    /// <summary>Custom template rendered inside the table footer.</summary>
    [Parameter]
    public RenderFragment? FooterTemplate { get; set; }

    /// <summary>Border style applied to individual cells.</summary>
    [Parameter]
    public BorderStyle? CellBorder { get; set; }

    /// <summary>Border style applied to rows.</summary>
    [Parameter]
    public BorderStyle? RowBorder { get; set; }

    /// <summary>
    /// Inline-edit strategy. <see cref="BOBDataGridEditMode.None"/> (default) keeps the
    /// grid read-only. <see cref="BOBDataGridEditMode.Cell"/> activates per-cell editing
    /// on double-click; <see cref="BOBDataGridEditMode.Batch"/> stages changes until the
    /// toolbar Save / Cancel actions commit them.
    /// </summary>
    [Parameter]
    public BOBDataGridEditMode EditMode { get; set; } = BOBDataGridEditMode.None;

    /// <summary>
    /// Raised after a row's edit is committed (Enter, blur, or — in batch mode — the
    /// toolbar Save action). The handler receives the mutated row item so the consumer
    /// can persist the change to the backing store.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnRowSave { get; set; }

    /// <summary>
    /// Raised when the user discards an in-progress edit via <c>Escape</c> (cell mode) or
    /// the toolbar Cancel action (batch mode). The handler receives the row item before
    /// the grid restores its original value.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnRowCancel { get; set; }

    /// <summary>
    /// When <see langword="true"/>, the toolbar shows a "Copy" button that writes the current
    /// filtered + sorted view to the system clipboard as TSV (<c>text/plain</c>) and an HTML
    /// <c>&lt;table&gt;</c> (<c>text/html</c>) so the payload pastes natively into Excel,
    /// Sheets, and Numbers. Opt-in (defaults to <see langword="false"/>) — every grid in the
    /// wild stays unchanged unless the consumer enables the feature explicitly.
    /// </summary>
    [Parameter]
    public bool Copyable { get; set; }

    /// <summary>
    /// Raised after the grid has serialised + written the clipboard payload. The event arg
    /// carries the item snapshot and both payloads so the consumer can surface a toast
    /// ("N rows copied"), audit, or log — the grid itself is intentionally feedback-free
    /// to avoid coupling to <see cref="IToastService"/>
    /// in core grid code.
    /// </summary>
    [Parameter]
    public EventCallback<BOBDataGridCopyEventArgs<TItem>> OnCopy { get; set; }

    [Inject]
    private IClipboardJsInterop ClipboardJsInterop { get; set; } = default!;

    // Single-cell edit state for EditMode.Cell/Batch. Stores the item being edited and
    // the column header so the renderer knows which <td> to swap for the input.
    private TItem? _editingItem;
    private string? _editingColumnHeader;

    // Per-cell validation errors keyed by (item, columnHeader). Populated by the cell
    // editor's OnValidate callback when the column's Validator rejects a proposed value;
    // drives the bob-datagrid__cell--invalid class + title tooltip on the affected cell.
#pragma warning disable CS8714 // TKey notnull: TItem is grid-generic + may be nullable for the consumer
    private readonly Dictionary<(TItem Item, string Header), string> _cellErrors = new();

    // Batch-mode staging: row items the user touched + their original values keyed by
    // column header. Snapshotted on the first commit so Cancel can restore them; cleared
    // on Save (after each row's OnRowSave fires) or on Cancel (after revert + OnRowCancel).
    private readonly Dictionary<TItem, Dictionary<string, object?>> _batchSnapshots = new();
#pragma warning restore CS8714

    /// <summary>
    /// Returns <see langword="true"/> when the given cell is the active edit target. Both
    /// <see cref="BOBDataGridEditMode.Cell"/> and <see cref="BOBDataGridEditMode.Batch"/>
    /// share the same single-cell-at-a-time editor activation; the modes only diverge in
    /// when <c>OnRowSave</c> fires (immediate vs. toolbar-deferred).
    /// </summary>
    private bool IsCellEditing(TItem item, DataColumnRegistration<TItem> col) =>
        EditMode != BOBDataGridEditMode.None
        && _editingItem is not null
        && EqualityComparer<TItem>.Default.Equals(_editingItem, item)
        && string.Equals(_editingColumnHeader, col.Header, StringComparison.Ordinal);

    /// <summary>
    /// Returns <see langword="true"/> when the column accepts inline editing — the
    /// per-column <c>Editable</c> flag is on, and either a <c>ValueSetter</c> or
    /// <c>EditTemplate</c> is wired so the grid can actually write the change back.
    /// </summary>
    private bool IsColumnEditable(DataColumnRegistration<TItem> col) =>
        EditMode != BOBDataGridEditMode.None
        && col.Editable
        && (col.ValueSetter is not null || col.EditTemplate is not null);

    /// <summary>
    /// Activates inline editing for a cell. Resolves to a no-op when the grid is in
    /// <see cref="BOBDataGridEditMode.None"/>, the column is not editable, or another
    /// cell is already in edit mode (the caller would have committed/cancelled first via
    /// blur or Escape, so this branch is the safety net for a stuck state machine).
    /// </summary>
    private void BeginEditCell(TItem item, DataColumnRegistration<TItem> col)
    {
        if (!IsColumnEditable(col))
        {
            return;
        }

        // Snapshot the row's editable columns now, before the setter writes anything —
        // batch-mode Cancel rewinds against these original values, so capturing them at
        // commit time (after the user typed) would defeat the revert.
        EnsureBatchSnapshot(item);

        _editingItem = item;
        _editingColumnHeader = col.Header;
    }

    /// <summary>
    /// Snapshots a row's original editable-column values before the first batch-mode
    /// commit. No-op when the item is already staged or the grid is not in
    /// <see cref="BOBDataGridEditMode.Batch"/>. Captures every editable column's current
    /// value so <see cref="CancelBatchAsync"/> can fully revert the row even if the user
    /// edited multiple cells.
    /// </summary>
    private void EnsureBatchSnapshot(TItem item)
    {
        if (EditMode != BOBDataGridEditMode.Batch || _batchSnapshots.ContainsKey(item))
        {
            return;
        }

        Dictionary<string, object?> snapshot = new(StringComparer.Ordinal);
        foreach (DataColumnRegistration<TItem> c in RegisteredColumns)
        {
            if (!c.Editable || string.IsNullOrEmpty(c.Header) || c.ValueSelector is null)
            {
                continue;
            }

            snapshot[c.Header] = c.ValueSelector(item);
        }

        _batchSnapshots[item] = snapshot;
    }

    /// <summary>
    /// Closes the active inline edit. In cell mode fires <see cref="OnRowSave"/> /
    /// <see cref="OnRowCancel"/> immediately. In batch mode the events are deferred until
    /// the toolbar Save / Cancel actions; this method only resets the editor's UI state
    /// (and snapshots the original values on first commit so Cancel can revert).
    /// </summary>
    private async Task EndEditCell(TItem item, bool save)
    {
        _editingItem = default;
        _editingColumnHeader = null;

        // Cell mode raises the row events on every commit; batch mode defers them to the
        // toolbar action so the consumer's persistence hook sees the full batch at once.
        if (EditMode == BOBDataGridEditMode.Cell)
        {
            if (save && OnRowSave.HasDelegate)
            {
                await OnRowSave.InvokeAsync(item);
            }
            else if (!save && OnRowCancel.HasDelegate)
            {
                await OnRowCancel.InvokeAsync(item);
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Records a per-cell validation result reported by the cell editor's
    /// <c>OnValidate</c> callback. A non-null error keeps the cell in edit mode and
    /// surfaces the message in a tooltip + invalid-cell styling; a null error clears any
    /// previous error for the cell.
    /// </summary>
    private void HandleCellValidation(TItem item, DataColumnRegistration<TItem> col, string? error)
    {
        if (string.IsNullOrEmpty(col.Header))
        {
            return;
        }

        (TItem Item, string Header) key = (item, col.Header);
        if (string.IsNullOrEmpty(error))
        {
            _cellErrors.Remove(key);
        }
        else
        {
            _cellErrors[key] = error;
        }
    }

    /// <summary>Returns the error message for a cell if one is currently recorded.</summary>
    private string? GetCellError(TItem item, DataColumnRegistration<TItem> col)
    {
        if (string.IsNullOrEmpty(col.Header))
        {
            return null;
        }

        return _cellErrors.TryGetValue((item, col.Header), out string? msg) ? msg : null;
    }

    /// <summary>
    /// <see langword="true"/> when batch mode has at least one staged row pending
    /// commit. Drives the Save / Cancel toolbar buttons' visibility.
    /// </summary>
    private bool HasBatchPendingChanges =>
        EditMode == BOBDataGridEditMode.Batch && _batchSnapshots.Count > 0;

    /// <summary>
    /// <see langword="true"/> when at least one staged cell still carries an unresolved
    /// validator error. Gates the toolbar Save button — committing while errors are
    /// pending would fire <see cref="OnRowSave"/> for rows whose column setters were
    /// blocked by the validator, signalling "saved" for a row that never actually
    /// updated its property. The user must resolve every flagged cell before save
    /// becomes available.
    /// </summary>
    private bool HasUnresolvedValidationErrors => _cellErrors.Count > 0;

    /// <summary>
    /// Commits every staged batch row by firing <see cref="OnRowSave"/> per item and
    /// dropping the snapshots. The row items have already been mutated through the
    /// column setters during each cell commit; this is the "let the consumer persist"
    /// signal.
    ///
    /// Guards: no-op if there are no staged rows, OR if any cell still has an
    /// unresolved validator error. The Save button is disabled in the latter case but
    /// the code-side guard defends against a click-through race between the input's
    /// blur (which records the error) and the button's click (which would otherwise
    /// dispatch before the render that disables the button has flushed).
    /// </summary>
    private async Task CommitBatchAsync()
    {
        if (!HasBatchPendingChanges || HasUnresolvedValidationErrors)
        {
            return;
        }

        if (OnRowSave.HasDelegate)
        {
            foreach (TItem item in _batchSnapshots.Keys.ToList())
            {
                await OnRowSave.InvokeAsync(item);
            }
        }

        _batchSnapshots.Clear();
        _cellErrors.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// Serialises the current filtered + sorted view to TSV (text/plain) and an HTML
    /// &lt;table&gt; (text/html), writes both to the system clipboard via <see cref="IClipboardJsInterop"/>,
    /// and fires <see cref="OnCopy"/> so the consumer can surface confirmation UX
    /// (toast, log, analytics). The grid stays feedback-free — coupling to a toast
    /// service would force every host to register one.
    /// </summary>
    private async Task HandleCopyAsync()
    {
        IReadOnlyList<TItem> snapshot = FilteredItems.ToList();
        IReadOnlyList<DataColumnRegistration<TItem>> cols = RegisteredColumns.ToList();

        string tsv = BOBDataCollectionClipboardSerializer<TItem>.BuildTsv(snapshot, cols, includeHeaders: true);
        string html = BOBDataCollectionClipboardSerializer<TItem>.BuildHtml(snapshot, cols, includeHeaders: true);

        await ClipboardJsInterop.CopyRichAsync(tsv, html);

        if (OnCopy.HasDelegate)
        {
            await OnCopy.InvokeAsync(new BOBDataGridCopyEventArgs<TItem>
            {
                Items = snapshot, Tsv = tsv, Html = html
            });
        }
    }

    /// <summary>
    /// Reverts every staged batch row to the snapshot taken at first commit + fires
    /// <see cref="OnRowCancel"/> per item. After this call the rows reflect their
    /// pre-edit state and the toolbar Save / Cancel buttons disappear.
    /// </summary>
    private async Task CancelBatchAsync()
    {
        if (!HasBatchPendingChanges)
        {
            return;
        }

        foreach (KeyValuePair<TItem, Dictionary<string, object?>> entry in _batchSnapshots)
        {
            foreach (KeyValuePair<string, object?> field in entry.Value)
            {
                DataColumnRegistration<TItem>? col = RegisteredColumns
                    .FirstOrDefault(c => string.Equals(c.Header, field.Key, StringComparison.Ordinal));
                col?.ValueSetter?.Invoke(entry.Key, field.Value);
            }

            if (OnRowCancel.HasDelegate)
            {
                await OnRowCancel.InvokeAsync(entry.Key);
            }
        }

        _batchSnapshots.Clear();
        _cellErrors.Clear();
        StateHasChanged();
    }

    public override DataGridVariant DefaultVariant => DataGridVariant.Default;

    protected override IReadOnlyDictionary<DataGridVariant, Func<BOBDataGrid<TItem>, RenderFragment>> BuiltInTemplates { get; } =
        new Dictionary<DataGridVariant, Func<BOBDataGrid<TItem>, RenderFragment>>();

    private List<(TItem Item, int Index)> IndexedItems =>
        ProcessedItems.Select((item, i) => (item, i)).ToList();

    public override void BuildComponentCssVariables(Dictionary<string, string> cssVariables)
    {
        base.BuildComponentCssVariables(cssVariables);

        if (CellBorder != null)
        {
            var values = CellBorder.GetCssValues();
            if (values.All != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcCellBorder] = values.All;
            if (values.Top != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcCellBorderTop] = values.Top;
            if (values.Right != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcCellBorderRight] = values.Right;
            if (values.Bottom != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcCellBorderBottom] = values.Bottom;
            if (values.Left != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcCellBorderLeft] = values.Left;
        }

        if (RowBorder != null)
        {
            var values = RowBorder.GetCssValues();
            if (values.All != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcRowBorder] = values.All;
            if (values.Top != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcRowBorderTop] = values.Top;
            if (values.Right != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcRowBorderRight] = values.Right;
            if (values.Bottom != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcRowBorderBottom] = values.Bottom;
            if (values.Left != null)
                cssVariables[FeatureDefinitions.InlineVariables.DcRowBorderLeft] = values.Left;
        }
    }

    private RenderFragment RenderRow(TItem item, int index) => __builder =>
    {
        var isSelected = State.IsSelected(item);
        var isExpanded = HasRowDetail && IsExpanded(item);
        var patternStyle = GetItemPatternStyle(index);

        <tr @key="item"
            class="bob-datagrid__row"
            data-bob-selected="@(isSelected ? "true" : null)"
            data-bob-expanded="@(isExpanded ? "true" : null)"
            data-bob-interactive="@(IsInteractiveRow ? "true" : null)"
            style="@patternStyle"
            role="row"
            tabindex="@(IsInteractiveRow ? 0 : -1)"
            @onclick="() => HandleRowClick(item)"
            @onkeydown="e => HandleRowKeyDown(e, item)"
            @onkeydown:preventDefault="PreventRowKeyDown">

            @if (HasRowDetail)
            {
                var capturedExpItem = item;
                var capturedExpState = isExpanded;
                <td class="bob-datagrid__cell bob-datagrid__expand-cell" role="gridcell"
                    @onclick:stopPropagation="true">
                    <_BOBInBtn Icon="@(capturedExpState ? BOBIconKeys.UI.ArrowDownward : BOBIconKeys.UI.ArrowForward)"
                               AriaLabel="@(capturedExpState ? Localizer["Collapse row"] : Localizer["Expand row"])"
                               Size="BOBSize.Small"
                               OnClick="@(_ =>
                                        {
                                            ToggleExpanded(capturedExpItem);
                                            StateHasChanged();
                                            return Task.CompletedTask;
                                        })"/>
                </td>
            }

            @if (SelectionMode != SelectionMode.None)
            {
                <td class="bob-datagrid__select-cell" role="gridcell">
                    <_BOBInCheckMark Checked="@isSelected"
                                     Mode="@(SelectionMode == SelectionMode.Single ? _BOBInCheckMark.CheckMarkMode.Radio : _BOBInCheckMark.CheckMarkMode.Checkbox)"
                                     Size="@Size"/>
                </td>
            }

            @if (RowTemplate != null)
            {
                @RowTemplate(item)
            }
            else
            {
                @foreach (var col in VisibleColumns)
                {
                    var capturedCol = col;
                    var editing = IsCellEditing(item, capturedCol);
                    var editable = IsColumnEditable(capturedCol);
                    var cellError = GetCellError(item, capturedCol);
                    <td class="@GetAlignClass(col.Align, "bob-datagrid__cell") @GetFrozenClass(col) @col.CellClass @(editing ? "bob-datagrid__cell--editing" : null) @(cellError is not null ? "bob-datagrid__cell--invalid" : null)"
                        style="@(col.Freeze != ColumnFreeze.None ? GetFrozenStyle(col) : null)"
                        role="gridcell"
                        title="@cellError"
                        aria-invalid="@(cellError is not null ? "true" : null)"
                        @ondblclick="@(() => BeginEditCell(item, capturedCol))"
                        @ondblclick:stopPropagation="@editable">
                        @if (editing)
                        {
                            <_BOBDataGridCellEditor TItem="TItem"
                                                    Item="item"
                                                    Column="capturedCol"
                                                    OnCommit="@(async (TItem committed) => await EndEditCell(committed, save: true))"
                                                    OnCancel="@(async (TItem cancelled) => await EndEditCell(cancelled, save: false))"
                                                    OnValidate="@(((TItem Item, string? Error) v) => HandleCellValidation(v.Item, capturedCol, v.Error))" />
                        }
                        else if (col.Template != null)
                        {
                            @col.Template(item)
                        }
                        else if (col.ValueSelector != null)
                        {
                            @FormatValue(col.ValueSelector(item), col.Format)
                        }
                    </td>
                }
            }

            @if (HasRowActions)
            {
                <td class="bob-datagrid__cell bob-datagrid__actions-cell" role="gridcell">
                    <div class="bob-dc__row-actions" @onclick:stopPropagation="true">
                        @foreach (var action in VisibleRowActionsFor(item))
                        {
                            var capturedAction = action;
                            var capturedItem = item;
                            var actionEnabled = action.Enabled is null || action.Enabled(item);
                            <_BOBInBtn Icon="@action.Icon"
                                       AriaLabel="@action.Label"
                                       Disabled="@(!actionEnabled)"
                                       Size="BOBSize.Small"
                                       OnClick="@(_ => InvokeRowActionAsync(capturedAction, capturedItem))">
                                @if (action.Icon is null)
                                {
                                    @action.Label
                                }
                            </_BOBInBtn>
                        }
                    </div>
                </td>
            }
        </tr>
        @if (isExpanded && RowDetailTemplate != null)
        {
            var detailColspan = VisibleColumns.Count
                                + (SelectionMode != SelectionMode.None ? 1 : 0)
                                + (HasRowDetail ? 1 : 0)
                                + (HasRowActions ? 1 : 0);
            <tr @key="@(new { Item = item, Detail = true })" class="bob-datagrid__detail-row" role="row">
                <td colspan="@detailColspan" class="bob-datagrid__detail-cell" role="gridcell">
                    @RowDetailTemplate(item)
                </td>
            </tr>
        }
    };

    private string GetContainerStyle()
    {
        if (EnableVirtualization && !string.IsNullOrEmpty(Height))
            return $"max-height: {Height}; overflow-y: auto;";

        if (FixedHeader && !string.IsNullOrEmpty(Height))
            return $"max-height: {Height}; overflow-y: auto;";

        return string.Empty;
    }

    /// <summary>
    /// Returns the additional CSS class fragment for a frozen cell. The grid renders
    /// frozen columns as <c>position: sticky</c> on the inline-start (Start) or inline-end
    /// (End) edges; the modifier class drives background opacity + z-index in the scoped
    /// CSS so the frozen surface stays opaque while the rest of the row scrolls under it.
    /// </summary>
    private static string GetFrozenClass(DataColumnRegistration<TItem> col) => col.Freeze switch
    {
        ColumnFreeze.Start => "bob-datagrid__cell--frozen bob-datagrid__cell--frozen-start",
        ColumnFreeze.End => "bob-datagrid__cell--frozen bob-datagrid__cell--frozen-end",
        _ => string.Empty
    };

    /// <summary>
    /// Returns the inline <c>style</c> fragment for a frozen cell — the cumulative
    /// <c>left</c> (Start) or <c>right</c> (End) offset summed over preceding peers on
    /// the same edge. Width must be specified in pixels (e.g. <c>"180px"</c>); other CSS
    /// length units fall back to a zero offset which still renders correctly when only
    /// one column is frozen on a given edge.
    /// </summary>
    private string GetFrozenStyle(DataColumnRegistration<TItem> col)
    {
        if (col.Freeze == ColumnFreeze.None) return string.Empty;

        // Walk visible columns in render order, accumulating widths up to (but not
        // including) the column under inspection. End-frozen columns walk in reverse so
        // each column's "right" offset reflects the columns to its right that are also
        // pinned.
        IReadOnlyList<DataColumnRegistration<TItem>> visible = VisibleColumns;
        var offset = 0;
        if (col.Freeze == ColumnFreeze.Start)
        {
            foreach (var peer in visible)
            {
                if (ReferenceEquals(peer, col)) break;
                if (peer.Freeze == ColumnFreeze.Start)
                {
                    offset += GetEffectiveWidthPx(peer);
                }
            }

            return $"left: {offset}px;";
        }
        else
        {
            for (var i = visible.Count - 1; i >= 0; i--)
            {
                var peer = visible[i];
                if (ReferenceEquals(peer, col)) break;
                if (peer.Freeze == ColumnFreeze.End)
                {
                    offset += GetEffectiveWidthPx(peer);
                }
            }

            return $"right: {offset}px;";
        }
    }

    private string? BuildHeaderCellStyle(DataColumnRegistration<TItem> col)
    {
        // The state-level ColumnWidths dict (populated by the resize drag handle) wins
        // over the static Width parameter so the user's drag survives across re-renders.
        var effectiveWidth = ResolveEffectiveWidth(col);
        var hasWidth = effectiveWidth != null;
        var isFrozen = col.Freeze != ColumnFreeze.None;
        if (!hasWidth && !isFrozen) return null;

        var widthFragment = hasWidth ? $"width: {effectiveWidth}" : string.Empty;
        var frozenFragment = isFrozen ? GetFrozenStyle(col) : string.Empty;

        if (hasWidth && isFrozen)
        {
            return $"{widthFragment}; {frozenFragment}";
        }

        return hasWidth ? widthFragment : frozenFragment;
    }

    private string? ResolveEffectiveWidth(DataColumnRegistration<TItem> col)
    {
        if (!string.IsNullOrEmpty(col.Header)
            && State.ColumnWidths.TryGetValue(col.Header!, out var live)
            && live > 0)
        {
            return $"{live.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px";
        }

        return col.Width;
    }

    private int GetEffectiveWidthPx(DataColumnRegistration<TItem> col)
    {
        if (!string.IsNullOrEmpty(col.Header)
            && State.ColumnWidths.TryGetValue(col.Header!, out var live)
            && live > 0)
        {
            return (int)Math.Round(live);
        }

        return ParseWidthPx(col.Width);
    }

    private static int ParseWidthPx(string? width)
    {
        if (string.IsNullOrWhiteSpace(width)) return 0;
        // Accept "180px" / "180" only — other CSS length units would require runtime
        // resolution we cannot do server-side. Consumers freezing columns must use px.
        var trimmed = width.Trim();
        if (trimmed.EndsWith("px", StringComparison.OrdinalIgnoreCase))
        {
            trimmed = trimmed[..^2];
        }

        return int.TryParse(trimmed, out var value) ? value : 0;
    }

    private static ColumnFilterOperator DefaultOperatorFor(ColumnFilterMode mode) => mode switch
    {
        ColumnFilterMode.Numeric => ColumnFilterOperator.Equals,
        ColumnFilterMode.Date => ColumnFilterOperator.Equals,
        _ => ColumnFilterOperator.Contains
    };

    private static string OperatorLabel(ColumnFilterOperator op) => op switch
    {
        ColumnFilterOperator.Contains => "contains",
        ColumnFilterOperator.StartsWith => "starts",
        ColumnFilterOperator.EndsWith => "ends",
        ColumnFilterOperator.Equals => "=",
        ColumnFilterOperator.NotEquals => "!=",
        ColumnFilterOperator.GreaterThan => ">",
        ColumnFilterOperator.LessThan => "<",
        ColumnFilterOperator.GreaterOrEqual => ">=",
        ColumnFilterOperator.LessOrEqual => "<=",
        _ => op.ToString()
    };

    private IconKey GetSelectAllIcon()
    {
        if (!ProcessedItems.Any())
            return BOBIconKeys.MaterialIconsRound.i_check_box_outline_blank;

        if (IsAllSelected())
            return BOBIconKeys.MaterialIconsRound.i_check_box;

        if (State.SelectedItems.Any())
            return BOBIconKeys.MaterialIconsOutlined.i_indeterminate_check_box;

        return BOBIconKeys.MaterialIconsRound.i_check_box_outline_blank;
    }

    private async Task HandleSelectAllClick(MouseEventArgs e)
    {
        if (IsAllSelected())
            State.ClearSelection();
        else
            State.SelectAll(ProcessedItems);

        await NotifySelectionChanged();
    }
}