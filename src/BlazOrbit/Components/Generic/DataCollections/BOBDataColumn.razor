@namespace BlazOrbit.Components
@typeparam TItem

@using System.Linq.Expressions

@code {
    private bool _registered;
    private DataColumnRegistration<TItem>? _registration;
    private Func<TItem, object?>? _compiledSelector;
    private string? _propertyName;

    /// <summary>Align.</summary>
    [Parameter] public ColumnAlign Align { get; set; } = ColumnAlign.Left;
    /// <summary>CSS class applied to the Cell.</summary>
    [Parameter] public string? CellClass { get; set; }
    /// <summary>Custom sort comparer for the column. Replaces default value comparison when <see cref="Sortable"/> is on.</summary>
    [Parameter] public Func<TItem, TItem, int>? CustomComparer { get; set; }
    /// <summary>Custom filter predicate. Replaces default substring matching when <see cref="Filterable"/> is on.</summary>
    [Parameter] public Func<TItem, string, bool>? CustomFilter { get; set; }
    /// <summary>Filterable.</summary>
    [Parameter] public bool Filterable { get; set; }
    /// <summary>Format.</summary>
    [Parameter] public string? Format { get; set; }
    /// <summary>Header.</summary>
    [Parameter] public string? Header { get; set; }
    /// <summary>Custom template for rendering the Header.</summary>
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    /// <summary>CSS class applied to the Header.</summary>
    [Parameter] public string? HeaderClass { get; set; }
    /// <summary>Expression that selects the column's bound property. Used to derive header text, sorting, and filtering.</summary>
    [Parameter] public Expression<Func<TItem, object?>>? Property { get; set; }
    /// <summary>Sortable.</summary>
    [Parameter] public bool Sortable { get; set; }
    /// <summary>Custom template for rendering the .</summary>
    [Parameter] public RenderFragment<TItem>? Template { get; set; }
    /// <summary>Visible.</summary>
    [Parameter] public bool Visible { get; set; } = true;
    /// <summary>Width.</summary>
    [Parameter] public string? Width { get; set; }
    /// <summary>
    /// Pin side. <see cref="ColumnFreeze.Start"/> sticks the column to the inline-start
    /// edge of the scroll container, <see cref="ColumnFreeze.End"/> to the inline-end.
    /// Frozen columns require an explicit pixel <see cref="Width"/> so the grid can
    /// compute cumulative offsets for adjacent frozen peers.
    /// </summary>
    [Parameter] public ColumnFreeze Freeze { get; set; } = ColumnFreeze.None;
    /// <summary>
    /// Filter category. Drives which input type + operator dropdown render when
    /// <c>ShowColumnFilters=true</c> on the parent grid. Defaults to
    /// <see cref="ColumnFilterMode.Text"/>. Use <see cref="ColumnFilterMode.Numeric"/>
    /// for <c>=/!=/&gt;/&lt;</c> against numeric properties, or
    /// <see cref="ColumnFilterMode.Date"/> for Before / After / Equals against date
    /// properties.
    /// </summary>
    [Parameter] public ColumnFilterMode FilterMode { get; set; } = ColumnFilterMode.Text;
    /// <summary>
    /// When <see langword="true"/>, the grid renders a drag handle on the trailing edge of
    /// this column's header so the user can resize via pointer events. Requires
    /// <c>BOBDataGrid.Resizable</c> to be on.
    /// </summary>
    [Parameter] public bool Resizable { get; set; }
    /// <summary>Lower bound (in pixels) the resize drag clamps to. Default <c>48</c>.</summary>
    [Parameter] public double MinWidth { get; set; } = 48d;
    /// <summary>Upper bound (in pixels) the resize drag clamps to. <c>0</c> = no limit.</summary>
    [Parameter] public double MaxWidth { get; set; }
    /// <summary>Aggregate function rendered in the column footer (Sum, Avg, …). Default <see cref="AggregateFunction.None"/>.</summary>
    [Parameter] public AggregateFunction Aggregate { get; set; } = AggregateFunction.None;
    /// <summary>Format string applied to the aggregate value. Falls back to <see cref="Format"/> when null.</summary>
    [Parameter] public string? AggregateFormat { get; set; }
    /// <summary>Optional prefix label shown next to the aggregate (e.g. <c>"Total: "</c>).</summary>
    [Parameter] public string? AggregateLabel { get; set; }
    /// <summary>Custom aggregate. Invoked when <see cref="Aggregate"/> is <see cref="AggregateFunction.Custom"/>.</summary>
    [Parameter] public Func<IEnumerable<TItem>, object?>? CustomAggregate { get; set; }

    [CascadingParameter(Name = "DataColumnRegistry")]
    internal IDataColumnRegistry<TItem>? Registry { get; set; }

    protected override void OnParametersSet()
    {
        if (Property != null && _compiledSelector == null)
        {
            Func<TItem, object?> compiled = Property.Compile();
            _compiledSelector = compiled;

            if (Property.Body is MemberExpression memberExpr)
            {
                _propertyName = memberExpr.Member.Name;
            }
            else if (Property.Body is UnaryExpression { Operand: MemberExpression innerMember })
            {
                _propertyName = innerMember.Member.Name;
            }
        }

        if (Registry != null)
        {
            if (!_registered)
            {
                _registration = new DataColumnRegistration<TItem>
                {
                    Header = Header ?? _propertyName,
                    HeaderTemplate = HeaderTemplate,
                    ValueSelector = _compiledSelector,
                    Template = Template,
                    Format = Format,
                    Align = Align,
                    Width = Width,
                    HeaderClass = HeaderClass,
                    CellClass = CellClass,
                    Visible = Visible,
                    Sortable = Sortable,
                    Filterable = Filterable,
                    CustomComparer = CustomComparer,
                    CustomFilter = CustomFilter,
                    Aggregate = Aggregate,
                    AggregateFormat = AggregateFormat,
                    AggregateLabel = AggregateLabel,
                    CustomAggregate = CustomAggregate,
                    Freeze = Freeze,
                    FilterMode = FilterMode,
                    Resizable = Resizable,
                    MinWidth = MinWidth,
                    MaxWidth = MaxWidth
                };
                Registry.RegisterColumn(_registration);
                _registered = true;
            }
            else if (_registration != null)
            {
                _registration.Header = Header ?? _propertyName;
                _registration.HeaderTemplate = HeaderTemplate;
                _registration.ValueSelector = _compiledSelector;
                _registration.Template = Template;
                _registration.Format = Format;
                _registration.Align = Align;
                _registration.Width = Width;
                _registration.HeaderClass = HeaderClass;
                _registration.CellClass = CellClass;
                _registration.Visible = Visible;
                _registration.Sortable = Sortable;
                _registration.Filterable = Filterable;
                _registration.CustomComparer = CustomComparer;
                _registration.CustomFilter = CustomFilter;
                _registration.Aggregate = Aggregate;
                _registration.AggregateFormat = AggregateFormat;
                _registration.AggregateLabel = AggregateLabel;
                _registration.CustomAggregate = CustomAggregate;
                _registration.Freeze = Freeze;
                _registration.FilterMode = FilterMode;
                _registration.Resizable = Resizable;
                _registration.MinWidth = MinWidth;
                _registration.MaxWidth = MaxWidth;
            }
        }
    }
}