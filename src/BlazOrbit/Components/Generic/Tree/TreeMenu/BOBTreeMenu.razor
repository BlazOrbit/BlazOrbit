@using BlazOrbit.Abstractions
@using Microsoft.AspNetCore.Components.Routing

@namespace BlazOrbit.Components
@attribute [GenerateComponentInfo]

@typeparam TItem
@inherits BOBComponentBase
@implements IPureBuiltComponent
@implements IHasSize
@implements IDisposable

@inject NavigationManager NavigationManager

@{
    base.BuildRenderTree(__builder);
}

<bob-component @attributes="@ComputedAttributes">
    @if (_isDeclarativeMode)
    {
        <CascadingValue Value="@((ITreeNodeRegistry<TreeMenuNodeRegistration>)_registry)" Name="TreeNodeRegistry">
            @ChildContent
        </CascadingValue>
    }

    @if (_structureBuilt)
    {
        @if (_isOpen && ExpandMode == TreeMenuExpandMode.Flyout)
        {
            <div class="bob-tree-menu__overlay" @onclick="CloseAllMenus" @onclick:stopPropagation="true"></div>
        }

        <nav class="bob-tree-menu__nav" role="menubar" aria-orientation="@Orientation.ToString().ToLowerInvariant()">
            @foreach (var node in _tree.RootNodes)
            {
                @RenderNode(node)
            }
        </nav>
    }
</bob-component>

@code {
    private readonly TreeNodeRegistry<TreeMenuNodeRegistration> _registry = new();
    private readonly DelayedActionHandler _hoverDelayHandler = new();
    private TreeStructure<TreeMenuNode<TItem>, TItem> _tree = null!;
    private bool _isDeclarativeMode;
    private bool _structureBuilt;
    private bool _isOpen;
    private string _currentUri = string.Empty;

    /// <summary>Content rendered inside the component.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Root items the menu renders.</summary>
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Returns a stable key for an item. Required for keyboard navigation and lazy loading.</summary>
    [Parameter]
    public Func<TItem, string>? KeySelector { get; set; }

    /// <summary>Returns the children of an item.</summary>
    [Parameter]
    public Func<TItem, IEnumerable<TItem>?>? ChildrenSelector { get; set; }

    /// <summary>Returns whether an item has children without loading them. Enables lazy expansion via <see cref="OnLoadChildren"/>.</summary>
    [Parameter]
    public Func<TItem, bool>? HasChildrenSelector { get; set; }

    /// <summary>Called the first time a node is expanded with no in-memory children. Result is cached on the menu.</summary>
    [Parameter]
    public Func<TItem, Task<IEnumerable<TItem>>>? OnLoadChildren { get; set; }

    /// <summary>Custom template for rendering the Node.</summary>
    [Parameter]
    public RenderFragment<TreeMenuNode<TItem>>? NodeTemplate { get; set; }

    /// <summary>Cache.</summary>
    [Parameter]
    public TreeNodeCache<TItem>? Cache { get; set; }

    /// <summary>ExpandedKeys.</summary>
    [Parameter]
    public HashSet<string>? ExpandedKeys { get; set; }

    /// <summary>ExpandedKeysChanged.</summary>
    [Parameter]
    public EventCallback<HashSet<string>> ExpandedKeysChanged { get; set; } = EventCallback<HashSet<string>>.Empty;

    /// <summary>ExpandAll.</summary>
    [Parameter]
    public bool ExpandAll { get; set; }

    /// <summary>Orientation.</summary>
    [Parameter]
    public TreeMenuOrientation Orientation { get; set; } = TreeMenuOrientation.Vertical;

    /// <summary>Trigger.</summary>
    [Parameter]
    public TreeMenuTrigger Trigger { get; set; } = TreeMenuTrigger.Click;

    /// <summary>ExpandMode.</summary>
    [Parameter]
    public TreeMenuExpandMode ExpandMode { get; set; } = TreeMenuExpandMode.Inline;

    /// <summary>ExpandMode.</summary>
    [Parameter]
    public TreeMenuTextBehavior TextBehavior { get; set; } = TreeMenuTextBehavior.BreakSpaces;

    /// <summary>Visual size of the component.</summary>
    [Parameter]
    public BOBSize Size { get; set; } = BOBSize.Medium;

    /// <summary>Collapsible.</summary>
    [Parameter]
    public bool Collapsible { get; set; } = true;

    /// <summary>Overrides the default NavLinkMatch for all the child menu items.</summary>
    [Parameter]
    public NavLinkMatch? Match { get; set; }

    /// <summary>HoverOpenDelay.</summary>
    [Parameter]
    public int HoverOpenDelay { get; set; } = 150;

    /// <summary>HoverCloseDelay.</summary>
    [Parameter]
    public int HoverCloseDelay { get; set; } = 300;

    /// <summary>Raised when the NodeClick event occurs.</summary>
    [Parameter]
    public EventCallback<TreeNodeEventArgs<TreeMenuNode<TItem>>> OnNodeClick { get; set; }

    /// <summary>Raised when the Navigate event occurs.</summary>
    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    public void BuildComponentDataAttributes(Dictionary<string, object> dataAttributes)
    {
        dataAttributes[FeatureDefinitions.DataAttributes.Orientation] = Orientation.ToString().ToLowerInvariant();
        dataAttributes[FeatureDefinitions.DataAttributes.Trigger] = Trigger.ToString().ToLowerInvariant();
        dataAttributes[FeatureDefinitions.DataAttributes.ExpandMode] = ExpandMode.ToString().ToLowerInvariant();
        dataAttributes[FeatureDefinitions.DataAttributes.TextBehavior] = TextBehavior.ToString().ToLowerInvariant();
    }

    public void BuildComponentCssVariables(Dictionary<string, string> cssVariables)
    {
    }

    protected override void OnInitialized()
    {
        _tree = new TreeStructure<TreeMenuNode<TItem>, TItem>(CreateNodeFromContext);
        _currentUri = NavigationManager.Uri;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _isDeclarativeMode = ChildContent != null && Items == null;

        if (ExpandedKeys != null)
        {
            _tree.SetExpandedKeys(ExpandedKeys);
        }

        if (!_isDeclarativeMode && Items != null)
        {
            _tree.BuildFromItems(Items, KeySelector, ChildrenSelector, HasChildrenSelector, ExpandAll);
            _structureBuilt = true;
            EnsureCurrentPathExpanded();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender && _isDeclarativeMode && !_structureBuilt)
        {
            BuildFromDeclarativeRegistrations();
            _structureBuilt = true;
            // Initial render: open the ancestor chain of the route the user
            // landed on (deep-link / refresh on a nested page).
            EnsureCurrentPathExpanded();
            StateHasChanged();
        }
    }

    private TreeMenuNode<TItem> CreateNodeFromContext(TreeNodeBuildContext<TItem> context)
    {
        return new TreeMenuNode<TItem>
        {
            Key = context.Key,
            Item = context.Item,
            Text = context.Text,
            Icon = context.Icon,
            IsDisabled = context.IsDisabled,
            Depth = context.Depth,
            ParentNode = context.Parent as TreeMenuNode<TItem>,
            CustomContent = context.CustomContent,
            AdditionalData = context.AdditionalData,
            Navigation = new NavigationInfo(),
            OnClick = default
        };
    }

    private TreeMenuNode<TItem> CreateNodeFromRegistration(TreeMenuNodeRegistration reg, TreeMenuNode<TItem>? parent, int depth, bool hasChildren)
    {
        return new TreeMenuNode<TItem>
        {
            Key = reg.Key,
            Item = default,
            Text = reg.Text,
            Icon = reg.Icon,
            IsDisabled = reg.IsDisabled,
            Depth = depth,
            ParentNode = parent,
            CustomContent = reg.NodeContent,
            AdditionalData = reg.Data,
            Navigation = new NavigationInfo
            {
                Href = reg.Href,
                Target = reg.Target,
                Match = reg.Match
            },
            OnClick = reg.OnClick
        };
    }

    private void BuildFromDeclarativeRegistrations()
    {
        var registrations = _registry.GetRegistrations();
        _registry.Clear();

        Dictionary<string, List<TreeMenuNodeRegistration>> childrenByParent = new();

        foreach (var reg in registrations)
        {
            var parentKey = reg.ParentKey ?? string.Empty;

            if (!childrenByParent.ContainsKey(parentKey))
            {
                childrenByParent[parentKey] = [];
            }

            childrenByParent[parentKey].Add(reg);
        }

        if (childrenByParent.TryGetValue(string.Empty, out var roots))
        {
            foreach (var reg in roots)
            {
                var node = BuildNodeFromRegistration(reg, null, 0, childrenByParent);
                _tree.RootNodes.Add(node);
            }
        }
    }

    private TreeMenuNode<TItem> BuildNodeFromRegistration(
        TreeMenuNodeRegistration reg,
        TreeMenuNode<TItem>? parent,
        int depth,
        Dictionary<string, List<TreeMenuNodeRegistration>> childrenByParent)
    {
        var hasChildren = childrenByParent.ContainsKey(reg.Key);
        var node = CreateNodeFromRegistration(reg, parent, depth, hasChildren);
        node.HasChildrenFlag = hasChildren;

        _tree.RegisterNode(node);

        if (reg.InitiallyExpanded || ExpandAll)
        {
            _tree.Expand(node.Key);
        }

        if (childrenByParent.TryGetValue(reg.Key, out var children))
        {
            foreach (var childReg in children)
            {
                var childNode = BuildNodeFromRegistration(childReg, node, depth + 1, childrenByParent);
                node.ChildrenInternal.Add(childNode);
            }
        }

        return node;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsDisposed) return;

        _currentUri = e.Location;

        if (ExpandMode == TreeMenuExpandMode.Flyout)
        {
            CloseAllMenus();
        }
        else if (_structureBuilt)
        {
            // Inline mode: keep the active page's ancestor chain open so
            // navigating to a sibling page doesn't collapse the group.
            EnsureCurrentPathExpanded();
        }

        StateHasChanged();
    }

    private RenderFragment RenderNode(TreeMenuNode<TItem> node) => __builder =>
    {
        var isExpanded = _tree.IsExpanded(node.Key);
        var isLoading = _tree.IsLoading(node.Key);
        var isActive = IsActive(node.Navigation.Href);
        var hasChildren = node.HasChildren;
        var isFlyout = ExpandMode == TreeMenuExpandMode.Flyout;
        var isHoverTrigger = Trigger == TreeMenuTrigger.Hover;

        <div class="bob-tree-menu__item"
             role="none"
             data-depth="@node.Depth"
             data-bob-disabled="@(node.IsDisabled ? "true" : null)"
             data-bob-active="@(isActive ? "true" : null)"
             @onmouseenter="@(isHoverTrigger && hasChildren ? (Func<MouseEventArgs, Task>)(_ => HandleHoverEnter(node.Key)) : null!)"
             @onmouseleave="@(isHoverTrigger && hasChildren && isFlyout ? (Func<MouseEventArgs, Task>)(_ => HandleHoverLeave(node.Key)) : null!)">

            @if (node.Navigation.HasNavigation && hasChildren)
            {
                // Split affordance: the label is a real <a> (right-click,
                // middle-click, aria-current, copy-link all work natively
                // and Blazor's router intercepts internal hrefs for SPA
                // navigation) and the chevron is a separate <button> that
                // stops propagation, so toggling expand never navigates.
                var rowAriaCurrent = isActive ? "page" : null;
                <div class="bob-tree-menu__row" role="none">
                    <a class="bob-tree-menu__link bob-tree-menu__link--with-toggle"
                       href="@node.Navigation.Href"
                       target="@node.Navigation.Target"
                       role="menuitem"
                       aria-current="@rowAriaCurrent"
                       aria-disabled="@node.IsDisabled.ToString().ToLowerInvariant()"
                       @onclick="() => HandleLinkClickAsync(node)"
                       @onclick:preventDefault="@(node.IsDisabled || OnNavigate.HasDelegate)">
                        @RenderItemBody(node)
                    </a>
                    <button type="button"
                            class="bob-tree-menu__toggle-btn"
                            aria-haspopup="true"
                            aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                            aria-label="@(isExpanded ? "Collapse" : "Expand")"
                            disabled="@node.IsDisabled"
                            @onclick="() => ToggleExpandAsync(node.Key)"
                            @onclick:stopPropagation="true">
                        <_BOBInAddon Icon="@GetExpandIcon()"
                                     IconRotation="@(isExpanded ? 90 : 0)"
                                     Loading="@isLoading"
                                     LoadingIndicatorVariant="BOBProgressIconVariant.Spinner"
                                     Size="Size"/>
                    </button>
                </div>
            }
            else if (node.Navigation.HasNavigation && !hasChildren)
            {
                <a class="bob-tree-menu__link"
                   href="@node.Navigation.Href"
                   target="@node.Navigation.Target"
                   role="menuitem"
                   aria-current="@(isActive ? "page" : null)"
                   aria-disabled="@node.IsDisabled.ToString().ToLowerInvariant()"
                   @onclick="() => HandleItemClickAsync(node)"
                   @onclick:preventDefault="@node.IsDisabled">
                    @RenderItemContent(node, hasChildren, isExpanded, isLoading)
                </a>
            }
            else
            {
                var ariaHaspopup = hasChildren ? "true" : null;
                var ariaExpanded = hasChildren ? isExpanded.ToString().ToLowerInvariant() : null;
                <button type="button"
                        class="bob-tree-menu__button"
                        role="menuitem"
                        aria-haspopup="@ariaHaspopup"
                        aria-expanded="@ariaExpanded"
                        aria-disabled="@node.IsDisabled.ToString().ToLowerInvariant()"
                        disabled="@node.IsDisabled"
                        @onclick="() => HandleItemClickAsync(node)">
                    @RenderItemContent(node, hasChildren, isExpanded, isLoading)
                </button>
            }

            @if (hasChildren && isExpanded)
            {
                <div
                    class="bob-tree-menu__submenu @(isFlyout ? "bob-tree-menu__submenu--flyout" : "bob-tree-menu__submenu--inline")"
                    role="menu"
                    @onmouseenter="@(isHoverTrigger ? (Action<MouseEventArgs>)(_ => HandleHoverEnterSubmenu()) : null!)"
                    @onmouseleave="@(isHoverTrigger && isFlyout ? (Func<MouseEventArgs, Task>)(_ => HandleHoverLeave(node.Key)) : null!)">
                    @foreach (var child in node.ChildrenInternal)
                    {
                        @RenderNode(child)
                    }
                </div>
            }
        </div>
    };

    /// <summary>
    /// Renders only the icon + label of a node (no chevron). Used by the
    /// split-affordance branch where the link element shows the label and
    /// the toggle button is a separate sibling.
    /// </summary>
    private RenderFragment RenderItemBody(TreeMenuNode<TItem> node) => __builder =>
    {
        @if (_isDeclarativeMode && node.CustomContent != null)
        {
            @node.CustomContent
        }
        else if (!_isDeclarativeMode && NodeTemplate != null)
        {
            @NodeTemplate(node)
        }
        else
        {
            @if (node.Icon.HasValue)
            {
                <BOBSvgIcon Icon="@node.Icon.Value" Size="Size" class="bob-tree-menu__icon"/>
            }

            <span class="bob-tree-menu__text">@(node.Text ?? node.Item?.ToString() ?? node.Key)</span>
        }
    };

    private RenderFragment RenderItemContent(TreeMenuNode<TItem> node, bool hasChildren, bool isExpanded, bool isLoading) => __builder =>
    {
        @if (_isDeclarativeMode && node.CustomContent != null)
        {
            @node.CustomContent
        }
        else if (!_isDeclarativeMode && NodeTemplate != null)
        {
            @NodeTemplate(node)
        }
        else
        {
            @if (node.Icon.HasValue)
            {
                <BOBSvgIcon Icon="@node.Icon.Value" Size="Size" class="bob-tree-menu__icon"/>
            }

            <span class="bob-tree-menu__text">@(node.Text ?? node.Item?.ToString() ?? node.Key)</span>
        }

        @if (hasChildren)
        {
            <_BOBInAddon Icon="@GetExpandIcon()"
                         IconRotation="@(isExpanded ? 90 : 0)"
                         Loading="@isLoading"
                         LoadingIndicatorVariant="BOBProgressIconVariant.Spinner"
                         Size="Size"/>
        }
    };

    private IconKey GetExpandIcon()
    {
        if (Orientation == TreeMenuOrientation.Horizontal && ExpandMode == TreeMenuExpandMode.Flyout)
            return BOBIconKeys.UI.ChevronDown;
        return BOBIconKeys.UI.ChevronRight;
    }

    /// <summary>
    /// Handles a click on a leaf or pure-container node. Container nodes
    /// without navigation toggle expand; leaves with navigation fire the
    /// browser-default link click (the <c>&lt;a&gt;</c> tag handles SPA
    /// navigation natively via Blazor's router). Container nodes with
    /// navigation use <see cref="HandleLinkClickAsync"/> instead — this
    /// method only sees them via the no-children branch.
    /// </summary>
    private async Task HandleItemClickAsync(TreeMenuNode<TItem> node)
    {
        if (node.IsDisabled) return;

        if (node.OnClick.HasDelegate)
        {
            await node.OnClick.InvokeAsync();
        }

        await OnNodeClick.InvokeAsync(new TreeNodeEventArgs<TreeMenuNode<TItem>>
        {
            Node = node,
            Key = node.Key,
            Depth = node.Depth,
            IsExpanded = _tree.IsExpanded(node.Key)
        });

        var hasNav = node.Navigation.HasNavigation && !string.IsNullOrEmpty(node.Navigation.Href);

        // Pure container (no Href): toggle the subtree.
        if (node.HasChildren)
        {
            await ToggleExpandAsync(node.Key);
            return;
        }

        // Leaf with navigation: <a href> default click navigates via
        // Blazor's router. We still notify OnNavigate consumers and
        // close flyout submenus.
        if (hasNav)
        {
            if (OnNavigate.HasDelegate)
            {
                await OnNavigate.InvokeAsync(node.Navigation.Href);
            }

            if (ExpandMode == TreeMenuExpandMode.Flyout)
            {
                CloseAllMenus();
            }
        }
    }

    /// <summary>
    /// Handles a click on the link half of a split-affordance row
    /// (container with both Href + children). Auto-expands the subtree so
    /// the user can immediately see siblings, then lets the
    /// <c>&lt;a&gt;</c> default click navigate. When the consumer wired
    /// an <see cref="OnNavigate"/> callback, the click was rendered with
    /// <c>preventDefault</c> on the markup side so the callback drives
    /// navigation exclusively.
    /// </summary>
    private async Task HandleLinkClickAsync(TreeMenuNode<TItem> node)
    {
        if (node.IsDisabled) return;

        if (node.OnClick.HasDelegate)
        {
            await node.OnClick.InvokeAsync();
        }

        await OnNodeClick.InvokeAsync(new TreeNodeEventArgs<TreeMenuNode<TItem>>
        {
            Node = node,
            Key = node.Key,
            Depth = node.Depth,
            IsExpanded = _tree.IsExpanded(node.Key)
        });

        // Auto-expand on link click — the user is about to browse the
        // section; showing siblings without them having to chase the
        // chevron is a usability win.
        if (node.HasChildren && !_tree.IsExpanded(node.Key))
        {
            await HandleExpandAsync(node.Key);
        }

        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync(node.Navigation.Href);
        }
    }

    /// <summary>
    /// Walks every node in the tree and expands the ancestor chain of the
    /// node whose <c>Href</c> matches the current URI. Keeps the active
    /// page's group open — without this, navigating to a child page closes
    /// the parent group as soon as <see cref="OnLocationChanged"/> fires.
    /// </summary>
    private void EnsureCurrentPathExpanded()
    {
        if (_tree.NodeMap.Count == 0) return;

        TreeMenuNode<TItem>? activeNode = null;
        foreach (var n in _tree.NodeMap.Values)
        {
            if (!string.IsNullOrEmpty(n.Navigation.Href) && IsActive(n.Navigation.Href))
            {
                // Pick the deepest match — multiple ancestors can match a
                // prefix-rule href, but the leaf is the actual current page.
                if (activeNode is null || n.Depth > activeNode.Depth)
                {
                    activeNode = n;
                }
            }
        }

        if (activeNode is null) return;

        var cursor = activeNode.ParentNode;
        while (cursor is not null)
        {
            _tree.Expand(cursor.Key);
            cursor = cursor.ParentNode;
        }
    }

    private async Task ToggleExpandAsync(string key)
    {
        if (_tree.IsExpanded(key))
        {
            await HandleCollapseAsync(key);
        }
        else
        {
            await HandleExpandAsync(key);
        }
    }

    private async Task HandleExpandAsync(string key)
    {
        var node = _tree.GetNode(key);
        if (node == null) return;

        if (ExpandMode == TreeMenuExpandMode.Flyout)
        {
            CollapseSiblingsOf(node);
        }
        else if (!Collapsible)
        {
            _tree.CollapseAll();
        }

        if (OnLoadChildren != null)
        {
            await _tree.LoadChildrenAsync(key, OnLoadChildren, KeySelector, ChildrenSelector, HasChildrenSelector, StateHasChanged);
        }

        _tree.Expand(key);
        _isOpen = true;
        await NotifyExpandedKeysChangedAsync();
        StateHasChanged();
    }

    private async Task HandleCollapseAsync(string key)
    {
        _tree.Collapse(key);

        if (!_tree.ExpandedKeys.Any())
        {
            _isOpen = false;
        }

        await NotifyExpandedKeysChangedAsync();
        StateHasChanged();
    }

    private void CollapseSiblingsOf(TreeMenuNode<TItem> node)
    {
        IEnumerable<TreeMenuNode<TItem>> siblings = node.ParentNode != null
            ? node.ParentNode.ChildrenInternal
            : _tree.RootNodes;

        foreach (var sibling in siblings)
        {
            if (sibling.Key != node.Key)
            {
                CollapseNodeAndDescendants(sibling);
            }
        }
    }

    private void CollapseNodeAndDescendants(TreeMenuNode<TItem> node)
    {
        _tree.Collapse(node.Key);
        foreach (var child in node.ChildrenInternal)
        {
            CollapseNodeAndDescendants(child);
        }
    }

    private void CloseAllMenus()
    {
        _hoverDelayHandler.Cancel();
        _tree.CollapseAll();
        _isOpen = false;
        StateHasChanged();
    }

    private async Task HandleHoverEnter(string key)
    {
        if (Trigger != TreeMenuTrigger.Hover) return;

        var node = _tree.GetNode(key);
        if (node == null || !node.HasChildren) return;

        _hoverDelayHandler.Cancel();
        await _hoverDelayHandler.ExecuteWithDelayAsync(async () =>
        {
            if (IsDisposed) return;
            await HandleExpandAsync(key);
        }, TimeSpan.FromMilliseconds(HoverOpenDelay));
    }

    private async Task HandleHoverLeave(string key)
    {
        if (Trigger != TreeMenuTrigger.Hover) return;
        if (ExpandMode != TreeMenuExpandMode.Flyout) return;

        await _hoverDelayHandler.ExecuteWithDelayAsync(async () =>
        {
            if (IsDisposed) return;

            var node = _tree.GetNode(key);
            if (node != null)
            {
                CollapseNodeAndDescendants(node);
            }

            if (!_tree.ExpandedKeys.Any())
            {
                _isOpen = false;
            }

            StateHasChanged();
            await Task.CompletedTask;
        }, TimeSpan.FromMilliseconds(HoverCloseDelay));
    }

    private void HandleHoverEnterSubmenu()
    {
        if (Trigger != TreeMenuTrigger.Hover) return;
        _hoverDelayHandler.Cancel();
    }

    private bool IsActive(string? href)
    {
        if (string.IsNullOrEmpty(href)) return false;

        var currentPath = NavigationManager.ToBaseRelativePath(_currentUri);
        var targetPath = NavigationManager.ToBaseRelativePath(NavigationManager.ToAbsoluteUri(href).AbsoluteUri);

        if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
        if (string.IsNullOrEmpty(targetPath)) targetPath = "/";

        var node = _tree.NodeMap.Values.FirstOrDefault(n => n.Navigation.Href == href);
        var match = Match ?? node?.Navigation.Match ?? NavLinkMatch.All;

        if (match == NavLinkMatch.All)
            return string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase);

        return currentPath.StartsWith(targetPath, StringComparison.OrdinalIgnoreCase);
    }

    private async Task NotifyExpandedKeysChangedAsync()
    {
        if (ExpandedKeysChanged.HasDelegate)
        {
            await ExpandedKeysChanged.InvokeAsync([.._tree.ExpandedKeys]);
        }
    }

    public void ExpandAllNodes()
    {
        _tree.ExpandAll();
        StateHasChanged();
    }

    public void CollapseAllNodes()
    {
        _tree.CollapseAll();
        _isOpen = false;
        StateHasChanged();
    }

    public void InvalidateCache(string? key = null) => _tree.InvalidateCache(key);

    public TreeMenuNode<TItem>? GetNode(string key) => _tree.GetNode(key);

    public void Dispose()
    {
        IsDisposed = true;
        _hoverDelayHandler.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
        _registry.Clear();
        _tree?.Clear();
    }

}