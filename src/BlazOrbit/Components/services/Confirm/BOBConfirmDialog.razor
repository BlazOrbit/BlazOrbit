@namespace BlazOrbit.Components
@attribute [GenerateComponentInfo]

@using BlazOrbit.Abstractions
@using BlazOrbit.Components

@inherits BOBComponentBase
@implements IModalContent

<bob-component @attributes="ComputedAttributes"
               data-bob-severity="@SeverityToken">
    <div class="bob-confirm__head">
        <span class="bob-confirm__icon" aria-hidden="true">
            <BOBSvgIcon Icon="@SeverityIcon" Size="BOBSize.Large"/>
        </span>
        <h2 class="bob-confirm__title">@Title</h2>
    </div>

    <p class="bob-confirm__message">@Message</p>

    <div class="bob-confirm__actions">
        <BOBButton Text="@ResolvedNoLabel"
                   OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, CancelAsync))"/>
        <BOBButton Text="@ResolvedYesLabel"
                   OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, AcceptAsync))"
                   Color="@AcceptColor"/>
    </div>
</bob-component>

@code {

    /// <summary>Cascaded reference back to the modal so the dialog can resolve with a result.</summary>
    [Parameter]
    public ModalReference ModalReference { get; set; } = default!;

    /// <summary>Dialog title.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Body message.</summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>Severity tier used for icon + accent.</summary>
    [Parameter]
    public ConfirmSeverity Severity { get; set; } = ConfirmSeverity.Info;

    /// <summary>Accept-button label.</summary>
    [Parameter]
    public string? YesLabel { get; set; }

    /// <summary>Cancel-button label.</summary>
    [Parameter]
    public string? NoLabel { get; set; }

    [Inject] internal IStringLocalizer<BOBServicesResources> Localizer { get; set; } = default!;

    private string ResolvedYesLabel => YesLabel ?? Localizer["Yes"];
    private string ResolvedNoLabel => NoLabel ?? Localizer["Cancel"];

    private string SeverityToken => Severity.ToString().ToLowerInvariant();

    private IconKey SeverityIcon => Severity switch
    {
        ConfirmSeverity.Warning => BOBIconKeys.MaterialIconsOutlined.i_warning,
        ConfirmSeverity.Danger => BOBIconKeys.MaterialIconsOutlined.i_error,
        _ => BOBIconKeys.MaterialIconsOutlined.i_info
    };

    // Accept button picks up the severity-derived palette token so a Danger dialog renders
    // the destructive call-to-action with the error palette without forcing the consumer to
    // wire up custom button colours.
    private string? AcceptColor => Severity switch
    {
        ConfirmSeverity.Warning => "var(--palette-warning)",
        ConfirmSeverity.Danger => "var(--palette-error)",
        _ => null
    };

    private Task AcceptAsync()
    {
        return ModalReference.CloseAsync(true);
    }

    private Task CancelAsync()
    {
        return ModalReference.CloseAsync(false);
    }

}
