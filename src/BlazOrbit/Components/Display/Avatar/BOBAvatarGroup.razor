@using BlazOrbit.Abstractions

@namespace BlazOrbit.Components.Display
@attribute [GenerateComponentInfo]

@inherits BOBComponentBase
@implements IHasSize

<bob-component @attributes="ComputedAttributes">
    <div class="bob-avatar-group"
         role="group"
         aria-label="@AriaLabel"
         style="@($"--_group-max-visible: {MaxVisible};")">

        <div class="bob-avatar-group__inner">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
        </div>

        @if (TotalOverride.HasValue && TotalOverride.Value > MaxVisible)
        {
            int overflow = TotalOverride.Value - MaxVisible;
            <span class="bob-avatar-group__overflow"
                  aria-label="@($"+{overflow} more")">+@overflow</span>
        }
    </div>
</bob-component>

@code {
    /// <summary>Avatar children. Items past <see cref="MaxVisible"/> are hidden via CSS.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Maximum number of avatars to render before hiding the rest. Defaults to <c>5</c>.</summary>
    [Parameter] public int MaxVisible { get; set; } = 5;
    /// <summary>Visual size of the group (applied via CSS scoped attributes; children pick their own).</summary>
    [Parameter] public BOBSize Size { get; set; } = BOBSize.Medium;
    /// <summary>Aria-label for the group container.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Avatars";
    /// <summary>
    /// Total number of avatars represented (visible + hidden). Drives the "+N" overflow badge.
    /// Set this when the data source is larger than what's actually rendered (e.g. virtualised
    /// or pre-truncated lists). When <c>null</c>, no overflow badge is rendered.
    /// </summary>
    [Parameter] public int? TotalOverride { get; set; }
}
