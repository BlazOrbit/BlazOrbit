@using BlazOrbit.Abstractions

@namespace BlazOrbit.Components.Display
@attribute [GenerateComponentInfo]

@inherits BOBComponentBase
@implements IHasSize
@implements IHasBackgroundColor

<bob-component @attributes="ComputedAttributes">
    <span class="bob-avatar"
          data-bob-shape="@Shape.ToString().ToLowerInvariant()"
          aria-label="@AriaLabel"
          role="img"
          style="@(string.IsNullOrEmpty(ImageUrl) ? GenerateGradient() : null)">

        @if (!string.IsNullOrEmpty(ImageUrl))
        {
            <img src="@ImageUrl" alt="@(AriaLabel ?? Label)" class="bob-avatar__img" />
        }
        else if (ChildContent is not null)
        {
            <span class="bob-avatar__content">@ChildContent</span>
        }
        else
        {
            <span class="bob-avatar__initials">@Initials()</span>
        }
    </span>

    @if (Status != BOBAvatarStatus.None)
    {
        <span class="bob-avatar__status"
              data-bob-status="@Status.ToString().ToLowerInvariant()"
              aria-label="@Status.ToString()"></span>
    }

</bob-component>

@code {
    /// <summary>Source URL of the avatar image. When empty, initials + gradient render instead.</summary>
    [Parameter] public string? ImageUrl { get; set; }
    /// <summary>Display label used to derive initials and gradient hash.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Custom child content (overrides initials).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Shape outline.</summary>
    [Parameter] public BOBAvatarShape Shape { get; set; } = BOBAvatarShape.Circle;
    /// <summary>Optional status indicator dot.</summary>
    [Parameter] public BOBAvatarStatus Status { get; set; } = BOBAvatarStatus.None;
    /// <summary>Visual size.</summary>
    [Parameter] public BOBSize Size { get; set; } = BOBSize.Medium;
    /// <summary>Aria-label override. Falls back to <see cref="Label"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>Background color of the avatar. Accepts any valid CSS color value, <see cref="PaletteColor"/> or <see cref="BOBColor"/>.</summary>
    [Parameter] public string? BackgroundColor { get; set; }

    /// <summary>
    /// Set when the avatar is nested inside a <see cref="BOBAvatarGroup"/>. Powers the group's
    /// auto-counted overflow badge — the avatar registers on init and unregisters on dispose
    /// so the badge stays accurate when consumers toggle visibility via <c>@if</c> guards.
    /// </summary>
    [CascadingParameter] internal BOBAvatarGroup? ParentGroup { get; set; }

    private bool _registered;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (ParentGroup is not null)
        {
            ParentGroup.Register(this);
            _registered = true;
        }
    }

    public override async ValueTask DisposeAsync()
    {
        if (_registered && ParentGroup is not null)
        {
            ParentGroup.Unregister(this);
            _registered = false;
        }
        await base.DisposeAsync();
    }

    private string Initials()
    {
        if (string.IsNullOrWhiteSpace(Label)) return "?";
        // Up to 2 chars: first + first of next word, uppercased.
        string[] parts = Label.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private string GenerateGradient()
    {
        // Deterministic hue from label hash so the same name always lights up the same way.
        int hash = (Label ?? string.Empty).Aggregate(17, (a, c) => a * 31 + c) & 0x7fffffff;
        int hue = hash % 360;
        int hue2 = (hue + 35) % 360;
        return $"--_avatar-bg: linear-gradient(135deg, hsl({hue} 60% 50%) 0%, hsl({hue2} 60% 40%) 100%)";
    }
}
