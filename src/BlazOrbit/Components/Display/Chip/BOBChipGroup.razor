@using BlazOrbit.Abstractions
@using Microsoft.Extensions.Localization

@namespace BlazOrbit.Components.Display
@attribute [GenerateComponentInfo]

@typeparam TValue

@inherits BOBComponentBase
@implements IChipGroupContainer
@implements IHasSize
@implements IHasColor
@implements IHasDisabled

@* Cascade `this` (as IChipGroupContainer) with IsFixed=true so chip children can wire up
   their click handler against the group without dragging the whole TValue generic
   through cascading parameter resolution. *@
<CascadingValue Value="@((IChipGroupContainer)this)" IsFixed="true">
    <bob-component @attributes="ComputedAttributes">

        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="bob-chip-group__label" id="@_labelId">
                @Label
                @if (Required)
                {
                    <span class="bob-field__required" aria-hidden="true">*</span>
                }
            </span>
        }

        <div class="bob-chip-group__items"
             role="@(Mode == ChipGroupSelectionMode.Single ? "radiogroup" : "group")"
             aria-label="@ResolvedAriaLabel"
             aria-labelledby="@(string.IsNullOrWhiteSpace(Label) ? null : _labelId)"
             aria-required="@(Required ? "true" : null)"
             aria-invalid="@(Required && (SelectedValues is null || SelectedValues.Count == 0) ? "true" : null)">
            @ChildContent
        </div>

        @if (!string.IsNullOrWhiteSpace(HelperText))
        {
            <span class="bob-chip-group__helper">@HelperText</span>
        }

    </bob-component>
</CascadingValue>

@code {
    [Inject] internal IStringLocalizer<BOBDisplayResources> Localizer { get; set; } = default!;

    private readonly string _labelId = $"bob-chip-group-label-{Guid.NewGuid():N}";

    /// <summary>
    /// Currently selected values. Bind via <c>@bind-SelectedValues</c>. In
    /// <see cref="ChipGroupSelectionMode.Single"/> mode the list holds at most one item;
    /// tapping the same chip again clears it.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TValue>? SelectedValues { get; set; }

    /// <summary>Two-way binding companion for <see cref="SelectedValues"/>.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<TValue>> SelectedValuesChanged { get; set; }

    /// <summary>Selection cardinality. Defaults to <see cref="ChipGroupSelectionMode.Single"/>.</summary>
    [Parameter]
    public ChipGroupSelectionMode Mode { get; set; } = ChipGroupSelectionMode.Single;

    /// <summary>Optional label rendered above the chip row.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Helper text rendered below the chip row.</summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>Aria-label fallback when <see cref="Label"/> is empty.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    private string ResolvedAriaLabel => AriaLabel ?? (string.IsNullOrWhiteSpace(Label) ? Localizer["Chips"] : Label!);

    /// <summary>
    /// Flags the group as required: renders the label asterisk, sets
    /// <c>aria-required="true"</c> on the items container, and surfaces
    /// <c>aria-invalid="true"</c> when no chip is selected. For full
    /// <see cref="Microsoft.AspNetCore.Components.Forms.EditContext"/>-driven
    /// validation (DataAnnotations, FluentValidation), wrap the group inside an
    /// <see cref="Microsoft.AspNetCore.Components.Forms.EditForm"/> whose model carries
    /// a property bound to <see cref="SelectedValues"/>; the consumer-side validator
    /// then drives the message surface. A dedicated <c>BOBChipGroupForm&lt;TValue&gt;</c>
    /// that hooks into <c>BOBInputComponentBase</c> directly is on the backlog.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Chip definitions rendered inside the group. Each child should set a <see cref="BOBChip.Value"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>When <see langword="true"/>, the entire group is non-interactive; cascades to nested chips.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    public bool IsDisabled => Disabled;

    /// <summary>Visual size cascaded into nested chips (chips may still override per-instance).</summary>
    [Parameter]
    public BOBSize Size { get; set; } = BOBSize.Medium;

    /// <summary>Accent color forwarded to nested chips via the inline color slot.</summary>
    [Parameter]
    public string? Color { get; set; }

    ChipGroupSelectionMode IChipGroupContainer.Mode => Mode;
    bool IChipGroupContainer.IsGroupDisabled => Disabled;

    bool IChipGroupContainer.IsValueSelected(object? value)
    {
        if (SelectedValues is null) return false;
        if (value is not TValue typed) return false;
        foreach (var v in SelectedValues)
        {
            if (EqualityComparer<TValue>.Default.Equals(v, typed)) return true;
        }

        return false;
    }

    async Task IChipGroupContainer.ToggleAsync(object? value)
    {
        if (Disabled) return;
        if (value is not TValue typed) return;

        var next = SelectedValues is null
            ? new List<TValue>()
            : new List<TValue>(SelectedValues);

        var alreadySelected = next.Any(v => EqualityComparer<TValue>.Default.Equals(v, typed));

        if (Mode == ChipGroupSelectionMode.Single)
        {
            // Single-select: a fresh tap replaces the whole list with one item; tapping the
            // current selection again clears it (toggle-off behaviour matches radio with a
            // Clearable opt-in).
            next = alreadySelected
                ? []
                : [typed];
        }
        else
        {
            if (alreadySelected)
            {
                next.RemoveAll(v => EqualityComparer<TValue>.Default.Equals(v, typed));
            }
            else
            {
                next.Add(typed);
            }
        }

        SelectedValues = next;
        if (SelectedValuesChanged.HasDelegate)
        {
            await SelectedValuesChanged.InvokeAsync(next);
        }
    }

}
