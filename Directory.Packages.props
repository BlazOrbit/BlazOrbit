<Project>

    <!--
      Central Package Management: every NuGet version used by the repository lives here.
      Project files declare `<PackageReference Include="..." />` without `Version`.

      Opted out:
      - `templates/` - template content ships to consumers with its own floating versions.
      - `artifacts/` - projects scaffolded from the templates by the template test matrix.
    -->

    <PropertyGroup>
        <_BlazOrbitRepoRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)'))</_BlazOrbitRepoRoot>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <ManagePackageVersionsCentrally Condition="$(MSBuildProjectDirectory.StartsWith('$(_BlazOrbitRepoRoot)templates', StringComparison.OrdinalIgnoreCase))">false</ManagePackageVersionsCentrally>
        <ManagePackageVersionsCentrally Condition="$(MSBuildProjectDirectory.StartsWith('$(_BlazOrbitRepoRoot)artifacts', StringComparison.OrdinalIgnoreCase))">false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!--
      Framework packages. Packable assemblies multi-target net8.0 + net10.0; each TFM
      references the matching ASP.NET Core / Microsoft.Extensions servicing line so
      consumers are never forced onto a newer major than the TFM they target.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Components" Version="8.0.31"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Forms" Version="8.0.31"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="8.0.31"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2"/>
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="8.0.31"/>
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="8.0.31"/>
        <PackageVersion Include="Microsoft.JSInterop" Version="8.0.31"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.JSInterop" Version="10.0.12"/>
    </ItemGroup>

    <!--
      Roslyn. Source generators (`EnforceExtendedAnalyzerRules`) stay on an older compiler
      API: the referenced Microsoft.CodeAnalysis version is the minimum compiler a consumer
      needs to load the generator (CS9057 otherwise). Bump only when raising the supported
      SDK floor. Tests and tools that host Roslyn as a library use the latest release.
    -->
    <ItemGroup Condition="'$(EnforceExtendedAnalyzerRules)' == 'true'">
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(EnforceExtendedAnalyzerRules)' != 'true'">
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0"/>
    </ItemGroup>

    <!-- Build tooling -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0"/>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401"/>
    </ItemGroup>

    <!-- Third-party runtime dependencies -->
    <ItemGroup>
        <PackageVersion Include="FluentValidation" Version="12.1.1"/>
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1"/>
    </ItemGroup>

    <!-- Testing -->
    <ItemGroup>
        <PackageVersion Include="bunit" Version="2.11.3"/>
        <PackageVersion Include="coverlet.MTP" Version="10.1.0"/>
        <PackageVersion Include="FluentAssertions" Version="8.11.0"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0"/>
        <PackageVersion Include="Microsoft.Playwright" Version="1.63.0"/>
        <PackageVersion Include="NSubstitute" Version="6.2.0"/>
        <!--
          Verify family pinned below 33.0: 33.x gates the build on a SponsorCheck license
          property (error SC021). Verify.DiffPlex 3.4+ requires Verify 33.
        -->
        <PackageVersion Include="Verify" Version="32.0.1"/>
        <PackageVersion Include="Verify.Blazor" Version="11.0.0"/>
        <PackageVersion Include="Verify.DiffPlex" Version="3.3.1"/>
        <PackageVersion Include="Verify.XunitV3" Version="32.0.1"/>
        <PackageVersion Include="xunit.v3" Version="4.0.1"/>
    </ItemGroup>

</Project>
