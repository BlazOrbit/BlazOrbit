@using BlazOrbit.Components.Forms
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations

<div class="test-password-consumer">
    <EditForm EditContext="_editContext" OnValidSubmit="HandleValid" OnInvalidSubmit="HandleInvalid">
        <DataAnnotationsValidator />

        <BOBInputPassword @bind-Value="_model.Password"
                          Label="Password"
                          HelperText="Min 8 chars." />

        <button type="submit" class="submit-btn">Submit</button>
    </EditForm>
    <div class="submit-result">@_submitResult</div>
</div>

@code {
    public class PasswordModel
    {
        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string? Password { get; set; }
    }

    private PasswordModel _model = new();
    private EditContext? _editContext;
    private string _submitResult = string.Empty;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    public PasswordModel BoundModel => _model;

    private void HandleValid() => _submitResult = "valid";
    private void HandleInvalid() => _submitResult = "invalid";
}
