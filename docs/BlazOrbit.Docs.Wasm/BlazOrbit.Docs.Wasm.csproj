<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<!--
			Required for dynamic culture switching in Blazor WASM.
			`BlazOrbit.Localization.Wasm` sets DefaultThreadCurrentCulture,
			which Blazor only allows when this flag is true. Adds ~1 MB ICU data.
			HybridGlobalization still delegates date/number formatting to `Intl`.
		-->
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<HybridGlobalization>true</HybridGlobalization>
		<!--
			AOT is gated behind the `EnableDocsAot` opt-in property and OFF by default.

			Why off by default:
			1. Cloudflare Pages enforces a 25 MB per-file limit on deployments.
			   AOT-compiled `dotnet.native.wasm` typically lands at ~30-40 MB,
			   which exceeds the limit and breaks the Cloudflare publish step.
			   Pairing AOT with `WasmStripILAfterAOT=true` (below) shaves ~30%
			   off and brings the file back under the limit.
			2. Native (emcc) compilation requires Python in PATH, which the
			   `mcr.microsoft.com/dotnet/sdk:10.0` container image does not ship.
			   CI gates (preview-gate / release-gate / preview-publish /
			   release-publish) run inside that container and only need to verify
			   the docs site compiles — they do not need optimized output.

			How to enable (opt-in):
			- Pass `-p:EnableDocsAot=true` on the command line.
			- The single flag activates both AOT and post-AOT IL strip together,
			  so callers cannot accidentally produce an AOT build that exceeds
			  the Cloudflare file-size budget.
			- The host running the build must have Python on PATH (GitHub-hosted
			  `ubuntu-latest` already does).

			See `.github/workflows/docs-site.yml` for the current publish flow.
		-->
		<RunAOTCompilation Condition="'$(EnableDocsAot)' == 'true'">true</RunAOTCompilation>
		<WasmStripILAfterAOT Condition="'$(EnableDocsAot)' == 'true'">true</WasmStripILAfterAOT>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\BlazOrbit\BlazOrbit.csproj" />
		<ProjectReference Include="..\..\src\BlazOrbit.FormsFluentValidation\BlazOrbit.FormsFluentValidation.csproj" />
		<ProjectReference Include="..\..\src\BlazOrbit.Localization.Wasm\BlazOrbit.Localization.Wasm.csproj" />
		<ProjectReference Include="..\..\docs\BlazOrbit.Docs.Components\BlazOrbit.Docs.Components.csproj" />
		<ProjectReference Include="..\..\docs\BlazOrbit.Docs.Translations\BlazOrbit.Docs.Translations.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BlazOrbit.Docs.CodeGeneration\BlazOrbit.Docs.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="Pages\**\*.razor" />
	</ItemGroup>


	<ItemGroup>
		<CompilerVisibleProperty Include="RootNamespace" />
		<CompilerVisibleProperty Include="ProjectDir" />
	</ItemGroup>

</Project>
