@using BlazOrbit.Docs.Wasm.Models
@using BlazOrbit.Docs.Wasm.Services
@using BlazOrbit.Hotkeys
@using System.Net
@using System.Text.RegularExpressions

@inject DocSearchService SearchService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IHotkeyService Hotkeys
@inject IStringLocalizer<DocSearch> Loc
@implements IAsyncDisposable

<div class="doc-search">
    <button type="button" class="doc-search-trigger" @onclick="OpenSearchAsync" aria-label="@Loc["Open search"]">
        <span class="doc-search-trigger__icon">
            <BOBSvgIcon Icon="@BOBIconKeys.MaterialIconsOutlined.i_search"/>
        </span>
        <span class="doc-search-trigger__label">@Loc["Search..."]</span>
        <span class="doc-search-trigger__shortcut">Ctrl K</span>
    </button>

    @if (_isOpen)
    {
        <div class="doc-search-overlay" @onclick="CloseSearch">
            <div class="doc-search-modal" @onclick:stopPropagation @onkeydown="HandleModalKeyDown">
                <div class="doc-search-modal__input-wrap">
                    <BOBInputText @bind-Value="_query"
                                  UpdateOnInput="true"
                                  OnInput="@(EventCallback.Factory.Create<string>(this, HandleInput))"
                                  Placeholder="@Loc["Search..."]"
                                  PrefixIcon="@BOBIconKeys.MaterialIconsOutlined.i_search"
                                  class="doc-search-modal__input"
                                  @onkeydown="HandleKeyDown"/>
                </div>

                @if (_results.Count > 0)
                {
                    @if (string.IsNullOrWhiteSpace(_query))
                    {
                        <div class="doc-search-modal__suggestions-header">Quick links</div>
                    }
                    <ul class="doc-search-modal__results" role="listbox">
                        @for (var i = 0; i < _results.Count; i++)
                        {
                            var index = i;
                            var result = _results[i];
                            <li class="doc-search-modal__item @(index == _selectedIndex ? "doc-search-modal__item--selected" : "")"
                                role="option"
                                aria-selected="@(index == _selectedIndex)"
                                @onclick="() => NavigateTo(result.Item.Route)">
                                <div
                                    class="doc-search-modal__item-title">@((MarkupString)DocSearchService.Highlight(result.Item.Title, _query))</div>
                                <div
                                    class="doc-search-modal__item-breadcrumb">@string.Join(" > ", result.Item.Breadcrumb)</div>
                            </li>
                        }
                    </ul>
                }
                else if (!string.IsNullOrWhiteSpace(_query))
                {
                    <div class="doc-search-modal__empty">@Loc["No results found"]</div>
                }

                <div class="doc-search-modal__footer">
                    <span>@Loc.Html("<kbd>↑</kbd> <kbd>↓</kbd> to navigate")</span>
                    <span>@Loc.Html("<kbd>↵</kbd> to select")</span>
                    <span>@Loc.Html("<kbd>esc</kbd> to close")</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _query = string.Empty;
    private bool _isOpen;
    private int _selectedIndex = -1;
    private List<DocSearchResult> _results = [];
    private IDisposable? _ctrlKRegistration;
    private IDisposable? _slashRegistration;

    protected override void OnInitialized()
    {
        // Ctrl+K (and "/" outside inputs) wire the docs site search via BlazOrbit.Hotkeys.
        // The previous DocSearchShortcuts.register JS bridge is gone; the hotkey service
        // already skips inputs / textareas / contentEditable, so the trigger never fires
        // while the user is typing inside the search input itself.
        _ctrlKRegistration = Hotkeys.Register(
            "ctrl+k",
            Loc["Open documentation search"],
            () => InvokeAsync(OpenSearchAsync),
            HotkeyScope.Global,
            true);

        _slashRegistration = Hotkeys.Register(
            "/",
            Loc["Open documentation search"],
            () => InvokeAsync(OpenSearchAsync),
            HotkeyScope.Global,
            true);
    }

    public async Task OpenSearchAsync()
    {
        _isOpen = true;
        _query = string.Empty;
        _results = SearchService.GetDefaultSuggestions().ToList();
        _selectedIndex = _results.Count > 0 ? 0 : -1;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("DocSearchShortcuts.focusInput", ".doc-search-modal__input input");
    }

    private void CloseSearch()
    {
        _isOpen = false;
        _selectedIndex = -1;
    }

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseSearch();
        }
    }

    private void HandleInput(string value)
    {
        _query = value;
        if (string.IsNullOrWhiteSpace(_query))
        {
            _results = SearchService.GetDefaultSuggestions().ToList();
        }
        else
        {
            _results = SearchService.Search(_query).ToList();
        }
        _selectedIndex = _results.Count > 0 ? 0 : -1;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_results.Count == 0)
        {
            if (e.Key == "Escape")
            {
                CloseSearch();
            }

            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
            case "Down":
                _selectedIndex = (_selectedIndex + 1) % _results.Count;
                break;
            case "ArrowUp":
            case "Up":
                _selectedIndex = (_selectedIndex - 1 + _results.Count) % _results.Count;
                break;
            case "Enter":
                if (_selectedIndex >= 0 && _selectedIndex < _results.Count)
                {
                    NavigateTo(_results[_selectedIndex].Item.Route);
                }

                break;
            case "Escape":
                CloseSearch();
                break;
        }
    }

    private void NavigateTo(string route)
    {
        _isOpen = false;
        _selectedIndex = -1;
        _query = string.Empty;
        NavigationManager.NavigateTo(route);
    }

    public ValueTask DisposeAsync()
    {
        _ctrlKRegistration?.Dispose();
        _slashRegistration?.Dispose();
        return ValueTask.CompletedTask;
    }

}
