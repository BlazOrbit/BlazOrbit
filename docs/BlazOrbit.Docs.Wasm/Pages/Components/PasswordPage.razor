@page "/components/forms/password"

@inject IStringLocalizer<PasswordPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBInputPassword"]"
         Lede="@Loc["Password input with built-in visibility toggle and optional strength meter scored against configurable rules."]"
         PageInstance="this"
         ApiType="@typeof(BOBInputPassword)">

    <DocDemo Key="Basic" Title="@Loc["Basic usage"]">
        <BOBInputPassword @bind-Value="_basic" Label="@Loc["Password"]" HelperText="@Loc["Use 8 or more characters."]" />
    </DocDemo>

    <DocDemo Key="Variants" Title="@Loc["Variants"]">
        <BOBInputPassword @bind-Value="_outlined" Variant="BOBInputVariant.Outlined" Label="@Loc["Outlined"]" />
        <br />
        <BOBInputPassword @bind-Value="_filled" Variant="BOBInputVariant.Filled" Label="@Loc["Filled"]" />
        <br />
        <BOBInputPassword @bind-Value="_standard" Variant="BOBInputVariant.Standard" Label="@Loc["Standard"]" />
        <br />
        <BOBInputPassword @bind-Value="_flat" Variant="BOBInputVariant.Flat" Label="@Loc["Flat"]" />
    </DocDemo>

    <DocDemo Key="Toggle" Title="@Loc["Visibility toggle"]">
        <BOBInputPassword @bind-Value="_toggleOn" ShowVisibilityToggle="true" Label="@Loc["Toggle on (default)"]" />
        <br />
        <BOBInputPassword @bind-Value="_toggleOff" ShowVisibilityToggle="false" Label="@Loc["Toggle off"]" />
    </DocDemo>

    <DocDemo Key="Strength" Title="@Loc["Strength meter"]">
        <BOBInputPassword @bind-Value="_meter"
                          ShowStrengthMeter="true"
                          UpdateOnInput="true"
                          MinLength="8"
                          Label="@Loc["New password"]"
                          HelperText="@Loc["8+ chars, uppercase, digit, symbol."]" />
    </DocDemo>

    <DocDemo Key="Sizes" Title="@Loc["Sizes"]">
        <BOBInputPassword @bind-Value="_small" Size="BOBSize.Small" Label="@Loc["Small"]" />
        <br />
        <BOBInputPassword @bind-Value="_medium" Size="BOBSize.Medium" Label="@Loc["Medium"]" />
        <br />
        <BOBInputPassword @bind-Value="_large" Size="BOBSize.Large" Label="@Loc["Large"]" />
    </DocDemo>

    <DocDemo Key="Prefix" Title="@Loc["With prefix icon"]">
        <BOBInputPassword @bind-Value="_prefixed"
                          PrefixIcon="@BOBIconKeys.MaterialIconsOutlined.i_lock"
                          Label="@Loc["Account password"]" />
    </DocDemo>

    <DocDemo Key="States" Title="@Loc["States"]">
        <BOBInputPassword @bind-Value="_required" Required="true" Label="@Loc["Required"]" />
        <br />
        <BOBInputPassword @bind-Value="_readonly" ReadOnly="true" Label="@Loc["ReadOnly"]" />
        <br />
        <BOBInputPassword @bind-Value="_disabled" Disabled="true" Label="@Loc["Disabled"]" />
        <br />
        <BOBInputPassword @bind-Value="_error" Error="true" Label="@Loc["Error"]" HelperText="@Loc["Password too short."]" />
    </DocDemo>

    <DocDemo Key="OnStrength" Title="@Loc["Strength callback"]">
        <BOBInputPassword @bind-Value="_callback"
                          UpdateOnInput="true"
                          ShowStrengthMeter="true"
                          OnStrengthChanged="HandleStrength"
                          Label="@Loc["Type to see callback"]" />
        <p class="doc-demo__caption">@Loc["Last reported:"] <code>@_lastStrength</code></p>
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBInputPasswordComponentInfo.Parameters" />
    </section>

</DocPage>

@code {
    private string? _basic;
    private string? _outlined;
    private string? _filled;
    private string? _standard;
    private string? _flat;
    private string? _toggleOn;
    private string? _toggleOff;
    private string? _meter;
    private string? _small;
    private string? _medium;
    private string? _large;
    private string? _prefixed;
    private string? _required;
    private string? _readonly = "hidden-value";
    private string? _disabled;
    private string? _error;
    private string? _callback;
    private BOBPasswordStrength _lastStrength = BOBPasswordStrength.None;

    private void HandleStrength(BOBPasswordStrength s) => _lastStrength = s;
}
