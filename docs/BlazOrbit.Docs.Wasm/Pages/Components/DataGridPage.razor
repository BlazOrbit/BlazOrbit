@page "/components/data/datagrid"

@inject IStringLocalizer<DataGridPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBDataGrid"]"
         Lede="@Loc["Strongly-typed tabular data with sorting, filtering, pagination, selection, custom templates, and more — declaratively."]"
         PageInstance="this"
         ApiType="@typeof(BOBDataGrid<>)"
         Keywords="@(["data grid", "table", "sorting", "pagination", "filter"])">

    <DocDemo Key="Basic" Title="@Loc["Basic usage"]"
             Description="@Loc["Bind Items and declare BOBDataColumn elements inside Columns."]">
        <BOBDataGrid Items="_people">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="Sortable" Title="@Loc["Sortable"]"
             Description="@Loc["Enable Sortable on the grid and on the columns you want clickable."]">
        <BOBDataGrid Items="_people" Sortable="true" SortAppendBehavior="SortAppendBehavior.None">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Sortable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="MultiSort" Title="@Loc["Multi-column sort"]"
             Description="@Loc["Click a header to sort. Multi-Sort behavior can be set using SortAppendBehavior parameter (None, Always, ShiftKey, CtrlKey, ShiftOrCtrlKey)."]">
        <BOBDataGrid Items="_orders" Sortable="true" SortAppendBehavior="SortAppendBehavior.Always">
            <Columns>
                <BOBDataColumn TItem="Order" Property="@(o => o.Region)" Header="@Loc["Region"]" Sortable="true"/>
                <BOBDataColumn TItem="Order" Property="@(o => o.Amount)" Header="@Loc["Amount"]" Sortable="true"
                               Align="ColumnAlign.Right" Format="C0"/>
                <BOBDataColumn TItem="Order" Property="@(o => o.Quantity)" Header="@Loc["Quantity"]" Sortable="true"
                               Align="ColumnAlign.Right"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="FilterPage" Title="@Loc["Filter + pagination"]">
        <BOBDataGrid Items="_big"
                     Filterable="true"
                     FilterPlaceholder="@Loc["Search..."]"
                     PageSize="10"
                     ShowPageSizeSelector="true"
                     PageSizeOptions="@([5, 10, 25])">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Filterable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="Selection" Title="@Loc["Multiple selection"]">
        <BOBDataGrid TItem="Person"
                     Items="_people"
                     SelectionMode="SelectionMode.Multiple"
                     SelectedItems="_selected"
                     SelectedItemsChanged="@(s =>
                                           {
                                               _selected = s;
                                               StateHasChanged();
                                           })">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="Template" Title="@Loc["Custom templates"]"
             Description="@Loc["Use Template with context to render any markup inside a cell."]">
        <BOBDataGrid Items="_people">
            <Columns>
                <BOBDataColumn TItem="Person" Header="@Loc["Person"]">
                    <Template>
                        <strong>@context.Name</strong>
                        <div style="font-size: 0.85em; opacity: 0.7;">@context.Email</div>
                    </Template>
                </BOBDataColumn>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Align="ColumnAlign.Right"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="Align" Title="@Loc["Alignment & width"]">
        <BOBDataGrid Items="_people">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name (left)"]"
                               Align="ColumnAlign.Left" Width="200px"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email (center)"]"
                               Align="ColumnAlign.Center"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age (right)"]"
                               Align="ColumnAlign.Right" Width="80px"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="ShadowAndBorder" Title="@Loc["Shadow & Border"]">
        <BOBDataGrid Items="_people" Shadow="@BOBShadowPresets.Elevation(3)">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
        <BOBDataGrid Items="_people" Border="@BOBBorderPresets.RoundedLarge">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="Themed" Title="@Loc["Themed surface"]"
             Description="@Loc["Color paints the foreground (cell text inherits), BackgroundColor paints the grid surface."]">
        <BOBDataGrid Items="_people"
                     Color="rgba(255, 255, 255, 1)"
                     BackgroundColor="rgba(33, 100, 196, 1)"
                     Border="@BOBBorderPresets.RoundedLarge">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="Aggregates" Title="@Loc["Aggregate footer"]"
             Description="@Loc["Set Aggregate per column (Sum, Average, Count, Min, Max, Custom). Aggregates run on the filtered set, not the visible page — totals reflect the user's filters."]">
        <BOBDataGrid Items="_orders" Filterable="true">
            <Columns>
                <BOBDataColumn TItem="Order" Property="@(o => o.Region)" Header="@Loc["Region"]"
                               Filterable="true"
                               Aggregate="AggregateFunction.Count" AggregateLabel="@(Loc["Total:"] + " ")"/>
                <BOBDataColumn TItem="Order" Property="@(o => o.Amount)" Header="@Loc["Amount"]"
                               Align="ColumnAlign.Right"
                               Format="C0" Aggregate="AggregateFunction.Sum" AggregateFormat="C0" AggregateLabel="Σ "/>
                <BOBDataColumn TItem="Order" Property="@(o => o.Quantity)" Header="@Loc["Quantity"]"
                               Align="ColumnAlign.Right"
                               Aggregate="AggregateFunction.Average" AggregateFormat="F1"
                               AggregateLabel="@(Loc["Avg:"] + " ")"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="RowActions" Title="@Loc["Per-row actions"]"
             Description="@Loc["RowActions renders icon buttons in a sticky-right column. Per-row Visible / Enabled predicates support read-only flags, role-gated workflows, etc."]">
        <BOBDataGrid Items="_people" RowActions="_rowActions">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
        @if (!string.IsNullOrEmpty(_actionLog))
        {
            <p class="doc-helper-text">@_actionLog</p>
        }
    </DocDemo>

    <DocDemo Key="BulkActions" Title="@Loc["Bulk actions on selection"]"
             Description="@Loc["BulkActions appear in the toolbar when at least one row is selected. Each handler receives the current selection — wire to delete / export / approve workflows."]">
        <BOBDataGrid TItem="Person"
                     Items="_people"
                     SelectionMode="SelectionMode.Multiple"
                     BulkActions="_bulkActions">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
        @if (!string.IsNullOrEmpty(_bulkLog))
        {
            <p class="doc-helper-text">@_bulkLog</p>
        }
    </DocDemo>

    <DocDemo Key="RowDetail" Title="@Loc["Master-detail / row expansion"]"
             Description="@Loc["RowDetailTemplate adds a chevron toggle to each row that expands a sub-row with related data. Combine with sticky headers for analytics-style drill-downs."]">
        <BOBDataGrid Items="_orders">
            <Columns>
                <BOBDataColumn TItem="Order" Property="@(o => o.Id)" Header="@Loc["Order"]"/>
                <BOBDataColumn TItem="Order" Property="@(o => o.Region)" Header="@Loc["Region"]"/>
                <BOBDataColumn TItem="Order" Property="@(o => o.Amount)" Header="@Loc["Amount"]"
                               Align="ColumnAlign.Right" Format="C0"/>
            </Columns>
            <RowDetailTemplate>
                <BOBFlexStack Gap="0.5rem" Direction="FlexStackDirection.Column">
                    <strong>Order #@context.Id — @context.Region</strong>
                    <span>@Loc["Quantity"]: @context.Quantity items</span>
                    <span>@Loc["Average price"]: @((context.Amount / Math.Max(1, context.Quantity)).ToString("C2"))</span>
                </BOBFlexStack>
            </RowDetailTemplate>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="LoadingSkeleton" Title="@Loc["Skeleton loading"]"
             Description="@Loc["LoadingMode = Skeleton renders animated placeholder rows while data is fetching. Pair with PageSize to control the row count. Reduced-motion users get static placeholders."]">
        <BOBFlexStack Gap="0.75rem" Direction="FlexStackDirection.Column">
            <BOBButton Text="@(_demoLoading ? Loc["Stop loading"] : Loc["Show skeleton"])" OnClick="@(EventCallback.Factory.Create<MouseEventArgs>(this, ToggleLoading))"/>
            <BOBDataGrid Items="_people"
                         Loading="_demoLoading"
                         LoadingMode="LoadingMode.Skeleton"
                         PageSize="5">
                <Columns>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
                </Columns>
            </BOBDataGrid>
        </BOBFlexStack>
    </DocDemo>

    <DocDemo Key="ErrorState" Title="@Loc["Error state"]"
             Description="@Loc["Set Error to surface a remote-load failure. Override ErrorContent for branded retry UX."]">
        <BOBDataGrid Items="_people"
                     Error="@Loc["Could not load orders — check your connection and retry."]">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="EmptyCta" Title="@Loc["Empty state with CTA"]"
             Description="@Loc["EmptyActionTemplate slots a button (or any markup) into the default empty layout — encourages users to create their first record without writing a custom EmptyContent."]">
        <BOBDataGrid Items="_emptyList">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
            </Columns>
            <EmptyActionTemplate>
                <BOBButton Text="@Loc["Create first contact"]"
                           LeadingIcon="@BOBIconKeys.MaterialIconsOutlined.i_add"/>
            </EmptyActionTemplate>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="ColumnFilters" Title="@Loc["Per-column filter"]"
             Description="@Loc["ShowColumnFilters renders a small text input below each Filterable header. Filters AND-combine across columns and with the toolbar Filterable search box."]">
        <BOBDataGrid Items="_people" ShowColumnFilters="true">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Filterable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="FilterOperators" Title="@Loc["Filter operators (text / numeric / date)"]"
             Description="@_filterOperatorsDesc">
        <BOBDataGrid Items="_employees" ShowColumnFilters="true">
            <Columns>
                <BOBDataColumn TItem="Employee" Property="@(p => p.Name)" Header="@Loc["Name"]" Filterable="true"/>
                <BOBDataColumn TItem="Employee" Property="@(p => p.Salary)" Header="@Loc["Salary"]" Filterable="true"
                               FilterMode="ColumnFilterMode.Numeric">
                    <Template Context="p">@p.Salary.ToString("N0")</Template>
                </BOBDataColumn>
                <BOBDataColumn TItem="Employee" Property="@(p => p.Hired)" Header="@Loc["Hired"]" Filterable="true"
                               FilterMode="ColumnFilterMode.Date">
                    <Template Context="p">@p.Hired.ToString("yyyy-MM-dd")</Template>
                </BOBDataColumn>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="FrozenColumns" Title="@Loc["Frozen columns"]"
             Description="@Loc["Freeze pins a column to the inline-start (Start) or inline-end (End) edge via position:sticky. Frozen columns require an explicit pixel Width so the grid can compute cumulative offsets for adjacent peers."]">
        <div style="overflow-x: auto;">
            <BOBDataGrid Items="_people">
                <Columns>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Width="80px"
                                   Freeze="ColumnFreeze.Start"/>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Width="200px"
                                   Freeze="ColumnFreeze.Start"/>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Width="320px"/>
                    <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Width="320px"/>
                    <BOBDataColumn TItem="Person" Header="@Loc["Status"]" Width="160px" Freeze="ColumnFreeze.End">
                        <Template Context="p">@(p.ReadOnly ? Loc["Read-only"] : Loc["Active"])</Template>
                    </BOBDataColumn>
                </Columns>
            </BOBDataGrid>
        </div>
    </DocDemo>

    <DocDemo Key="ResizeColumns" Title="@Loc["Column resize"]"
             Description="@_resizeColumnsDesc">
        <BOBDataGrid Items="_people" Resizable="true">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Width="80px"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Width="200px"
                               Resizable="true" MinWidth="120"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Width="280px"
                               Resizable="true" MinWidth="160"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Width="120px"
                               Resizable="true" MinWidth="80" MaxWidth="240"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="ReorderColumns" Title="@Loc["Column reorder (keyboard + drag)"]"
             Description="@_reorderColumnsDesc">
        <BOBDataGrid Items="_people" Reorderable="true">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="StatePersistence" Title="@Loc["State persistence"]"
             Description="@_statePersistenceDesc">
        <BOBDataGrid Items="_people"
                     PersistenceKey="docs-datagrid-demo"
                     Filterable="true"
                     ShowColumnFilters="true"
                     Reorderable="true"
                     Sortable="true"
                     PageSize="3"
                     ShowPageSizeSelector="true">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Sortable="true"
                               Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Sortable="true"
                               Filterable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="DataSourceInMemory" Title="@Loc["DataSource — InMemoryDataSource"]"
             Description="@_dataSourceInMemoryDesc">
        <BOBDataGrid TItem="Person"
                     DataSource="_inMemorySource"
                     Sortable="true"
                     Filterable="true"
                     PageSize="5">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Sortable="true"
                               Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Sortable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="DataSourceRemote" Title="@Loc["DataSource — RemoteDataSource"]"
             Description="@_dataSourceRemoteDesc">
        <BOBDataGrid TItem="Person"
                     DataSource="_remoteSource"
                     Sortable="true"
                     Filterable="true"
                     PageSize="10"
                     ShowPageSizeSelector="true">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Sortable="true"
                               Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]" Filterable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Sortable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="VirtualizeItemsProvider" Title="@Loc["Virtualize ItemsProvider (infinite scroll)"]"
             Description="@_virtualizeProviderDesc">
        <BOBDataGrid TItem="Person"
                     DataSource="_remoteSource"
                     EnableVirtualization="true"
                     Height="320px"
                     Sortable="true">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]" Sortable="true"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]" Sortable="true"/>
            </Columns>
        </BOBDataGrid>
    </DocDemo>

    <DocDemo Key="InlineEditCell" Title="@Loc["Inline editing — Cell mode"]"
             Description="@_inlineEditCellDesc">
        <BOBDataGrid TItem="EditablePerson"
                     Items="_editablePeople"
                     EditMode="BOBDataGridEditMode.Cell"
                     OnRowSave="@(p => { _lastSavedName = p.Name; return Task.CompletedTask; })">
            <Columns>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Id)" Header="ID"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Name)" Header="@Loc["Name"]" Editable="true"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Email)" Header="@Loc["Email"]" Editable="true"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Age)" Header="@Loc["Age"]" Editable="true"
                               Align="ColumnAlign.Right"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Hired)" Header="@Loc["Hired"]" Editable="true"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.IsActive)" Header="@Loc["Active"]" Editable="true"/>
            </Columns>
        </BOBDataGrid>
        @if (!string.IsNullOrEmpty(_lastSavedName))
        {
            <p style="margin-top: 0.5rem; font-size: 0.85em; opacity: 0.7;">@Loc["Saved: "] @_lastSavedName</p>
        }
    </DocDemo>

    <DocDemo Key="InlineEditBatch" Title="@Loc["Inline editing — Batch mode + validation"]"
             Description="@_inlineEditBatchDesc">
        <BOBDataGrid TItem="EditablePerson"
                     Items="_editablePeople"
                     EditMode="BOBDataGridEditMode.Batch"
                     OnRowSave="@(p => { _batchSavedCount++; return Task.CompletedTask; })"
                     OnRowCancel="@(p => { _batchCancelledCount++; return Task.CompletedTask; })">
            <Columns>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Id)" Header="ID"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Name)" Header="@Loc["Name"]" Editable="true"
                               Validator="@((p, v) => string.IsNullOrWhiteSpace(v?.ToString()) ? Loc["Name is required"].Value : null)"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Email)" Header="@Loc["Email"]" Editable="true"
                               Validator="@((p, v) => (v?.ToString() ?? string.Empty).Contains('@') ? null : Loc["Email must contain @"].Value)"/>
                <BOBDataColumn TItem="EditablePerson" Property="@(p => p.Age)" Header="@Loc["Age"]" Editable="true"
                               Align="ColumnAlign.Right"
                               Validator="@((p, v) => int.TryParse(v?.ToString(), out var n) && n is >= 18 and <= 120 ? null : Loc["Age must be 18–120"].Value)"/>
            </Columns>
        </BOBDataGrid>
        <p style="margin-top: 0.5rem; font-size: 0.85em; opacity: 0.7;">
            @Loc["Saved batches: "] @_batchSavedCount &nbsp;·&nbsp; @Loc["Cancelled batches: "] @_batchCancelledCount
        </p>
    </DocDemo>

    <DocDemo Key="Copyable" Title="@Loc["Copy to clipboard"]"
             Description="@Loc["Set Copyable=true to surface a toolbar button that copies the current filtered + sorted view as TSV + HTML, pasteable into Excel / Sheets / Numbers. Subscribe to OnCopy for confirmation UX."]">
        <BOBDataGrid Items="_people"
                     Filterable="true"
                     Copyable="true"
                     OnCopy="@(EventCallback.Factory.Create<BOBDataGridCopyEventArgs<Person>>(this, HandleCopyAsync))">
            <Columns>
                <BOBDataColumn TItem="Person" Property="@(p => p.Id)" Header="ID"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Name)" Header="@Loc["Name"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Email)" Header="@Loc["Email"]"/>
                <BOBDataColumn TItem="Person" Property="@(p => p.Age)" Header="@Loc["Age"]"/>
            </Columns>
        </BOBDataGrid>
        @if (_lastCopyCount is int n)
        {
            <p style="margin-top: 0.5rem; font-size: 0.85em; opacity: 0.7;">
                @string.Format(Loc["{0} rows copied to clipboard"].Value, n)
            </p>
        }
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBDataGridComponentInfo.Parameters"/>
    </section>

</DocPage>

@code {

    private record Person(int Id, string Name, string Email, int Age, bool ReadOnly = false);

    private class EditablePerson
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public int Age { get; set; }
        public DateTime Hired { get; set; }
        public bool IsActive { get; set; }
    }

    private record Order(int Id, string Region, decimal Amount, int Quantity);

    private record Employee(string Name, decimal Salary, DateTime Hired);

    private readonly List<Employee> _employees =
    [
        new("Alice Johnson", 72_000m, new DateTime(2019, 3, 14)),
        new("Marcus Chen", 58_500m, new DateTime(2021, 11, 2)),
        new("Priya Patel", 96_200m, new DateTime(2017, 7, 30)),
        new("Diego Martinez", 49_300m, new DateTime(2023, 1, 9)),
        new("Hana Nakamura", 84_750m, new DateTime(2020, 5, 22))
    ];

    private readonly List<Person> _people =
    [
        new(1, "Alice Johnson", "alice@example.com", 29),
        new(2, "Marcus Chen", "marcus@example.com", 34, true),
        new(3, "Priya Patel", "priya@example.com", 41),
        new(4, "Diego Martinez", "diego@example.com", 26),
        new(5, "Hana Nakamura", "hana@example.com", 38)
    ];

    private readonly List<Person> _big = Enumerable.Range(1, 35)
