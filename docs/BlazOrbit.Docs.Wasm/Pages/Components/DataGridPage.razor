    protected override void OnInitialized()
    {
        base.OnInitialized();
        _filterOperatorsDesc = Loc["FilterMode picks the operator vocabulary rendered next to the column input. Text columns expose Contains / StartsWith / EndsWith / = / ≠. Numeric and Date columns expose = / ≠ / > / < / ≥ / ≤. The operator <select> sits beside the typed input and AND-combines with global Filterable text and other column filters."];
        _resizeColumnsDesc = Loc["Resizable on the grid + Resizable on a column adds a small drag handle on the trailing edge of the header. Pointerdown captures the column and a full-grid overlay listens for pointermove / pointerup so the cursor can leave the handle mid-drag without losing the gesture. The new width is written to DataCollectionState.ColumnWidths and persists via PersistenceKey when configured. MinWidth / MaxWidth clamp the drag."];
        _reorderColumnsDesc = Loc["Reorderable enables both interactions on every header: focus + Alt+ArrowLeft / Alt+ArrowRight shifts the column for keyboard users, and HTML5 drag-and-drop on the th lets the user pick a header up and drop it onto a peer to take that peer's slot. Both paths write to DataCollectionState.ColumnOrder, so the drag survives the persistence round-trip alongside the keyboard nudges."];
        _statePersistenceDesc = Loc["Set PersistenceKey to round-trip filter / sort / page / column-order / column-filters through the registered IDataCollectionStatePersistence. Default registration is a no-op; consumers opt in to localStorage with builder.Services.AddBlazOrbitDataCollectionLocalStorage(). Register a custom IDataCollectionStatePersistence implementation for query-string or server-side stores."];
        _dataSourceInMemoryDesc = Loc["The DataSource parameter routes filter / sort / page through an IDataCollectionDataSource. InMemoryDataSource wraps an IEnumerable and runs the shared pipeline locally — same semantics as the legacy Items path, but the unified abstraction lets you swap to a remote source without touching the column markup."];
        _dataSourceRemoteDesc = Loc["RemoteDataSource accepts an async Func<DataRequest, Task<DataResult<T>>> provider. Each filter / sort / page change builds a DataRequest with StartIndex + Count plus the active sort / filter descriptors and awaits the provider. This demo simulates a 200ms server round-trip and counts pages from a 200-row store."];
        _virtualizeProviderDesc = Loc["When DataSource + EnableVirtualization + Height are all set, the grid hands row materialisation to Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize via ItemsProvider. The traditional pagination footer disappears — Virtualize requests slices on demand as the user scrolls, with a Placeholder row rendered while a chunk loads."];
        _inlineEditCellDesc = Loc["Mark a column with Editable=\"true\" and set EditMode=\"BOBDataGridEditMode.Cell\" on the grid to activate per-cell editing. Double-click a cell to open the input. Enter or blur saves; Escape cancels. The cell editor auto-resolves the input primitive from the property type — text / number / date / time / checkbox. OnRowSave fires after every successful commit."];
        _inlineEditBatchDesc = Loc["EditMode=\"BOBDataGridEditMode.Batch\" stages every cell commit until the user clicks the toolbar Save (applies + fires OnRowSave per row) or Cancel (reverts to pre-edit snapshot + fires OnRowCancel). Column-level Validator delegates return an error message that surfaces as a red cell border + tooltip and keeps the editor open until the input is valid."];
