    // InMemoryDataSource over the large person seed — exercises the new DataSource path
    // through the same shared pipeline as the legacy Items binding.
    private InMemoryDataSource<Person> _inMemorySource => new(_big);

    // RemoteDataSource — mock async provider that simulates a 200ms server round-trip
    // over a 200-row store, applying filter / sort / paging server-side semantics. Real
    // consumers point the provider at their API / database client.
    private RemoteDataSource<Person> _remoteSource => new(async (DataRequest req, CancellationToken ct) =>
    {
        await Task.Delay(200, ct);

        IEnumerable<Person> q = _remoteSeed;

        // Global filter — substring match over Name + Email.
        if (!string.IsNullOrWhiteSpace(req.GlobalFilter))
        {
            string f = req.GlobalFilter.ToLowerInvariant();
            q = q.Where(p => p.Name.ToLowerInvariant().Contains(f)
                          || p.Email.ToLowerInvariant().Contains(f));
        }

        // Sort — resolve the first descriptor by column header (Id / Name / Email / Age).
        if (req.Sorts.Count > 0)
        {
            var sort = req.Sorts[0];
            bool asc = sort.Direction == SortDirection.Ascending;
            q = sort.ColumnName switch
            {
                "ID" => asc ? q.OrderBy(p => p.Id) : q.OrderByDescending(p => p.Id),
                _ when sort.ColumnName == Loc["Name"].Value => asc ? q.OrderBy(p => p.Name) : q.OrderByDescending(p => p.Name),
                _ when sort.ColumnName == Loc["Email"].Value => asc ? q.OrderBy(p => p.Email) : q.OrderByDescending(p => p.Email),
                _ when sort.ColumnName == Loc["Age"].Value => asc ? q.OrderBy(p => p.Age) : q.OrderByDescending(p => p.Age),
                _ => q
            };
        }

        List<Person> all = q.ToList();
        int total = all.Count;

        IEnumerable<Person> page = req.Count is int take and > 0
            ? all.Skip(req.StartIndex).Take(take)
            : all.Skip(req.StartIndex);

        return new DataResult<Person>(page.ToList(), total);
    });

    private static readonly List<Person> _remoteSeed = Enumerable.Range(1, 200)
        .Select(i => new Person(i, $"Person {i:D3}", $"person{i}@example.com", 20 + i * 7 % 40))
        .ToList();
