@page "/components/utilities/themeselector"

@inject IStringLocalizer<ThemeSelectorPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBThemeSelector"]"
         Lede="@Loc["Theme toggle switch between light, dark, and custom themes. Automatically persists the user choice and applies it to the entire application."]"
         PageInstance="this"
         ApiType="@typeof(BOBThemeSelector)"
         Keywords="@(["theme selector", "dark mode", "light mode", "toggle"])">

    <section class="doc-section">
        <p class="doc-section__description">
                        @Loc.Html("The selector writes the active theme id to <code>localStorage</code> and toggles the <code>data-theme</code> attribute on the <code>&lt;html&gt;</code> element. This attribute drives the CSS custom-property cascade, so every component on the page updates instantly without re-rendering.")
        </p>
    </section>

    <DocDemo Key="Default" Title="@Loc["Default variant"]"
             Description="@Loc["A labeled button with an icon that reflects the current theme."]">
        <BOBThemeSelector/>
    </DocDemo>

    <DocDemo Key="SunMoon" Title="@Loc["Sun / Moon variant"]"
             Description="@Loc["The compact switch used in the docs header: a BOBSwitch with sun and moon icons."]">
        <BOBThemeSelector Variant="BOBThemeSelectorVariant.SunMoon"/>
    </DocDemo>

    <DocDemo Key="CustomThemes" Title="@Loc["Custom themes list"]"
             Description="@Loc["Cycle through a custom list — not limited to light / dark."]">
        <BOBThemeSelector AvailableThemes="@(["light", "dark"])"/>
    </DocDemo>

    <DocDemo Key="Event" Title="@Loc["Hook onto change events"]">
        <BOBThemeSelector Variant="BOBThemeSelectorVariant.SunMoon"
                          OnThemeChanged="@(t =>
                                          {
                                              _lastTheme = t;
                                              StateHasChanged();
                                          })"/>
        <span>@Loc["Last change"]: <code>@_lastTheme</code></span>
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBThemeSelectorComponentInfo.Parameters"/>
    </section>

</DocPage>

@code {
    private string _lastTheme = "(unchanged)";
}
