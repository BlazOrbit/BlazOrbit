@page "/components/forms/file-upload"

@using Microsoft.AspNetCore.Components.Forms

@inject IStringLocalizer<FileUploadPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBInputFile"]"
         Lede="@Loc["Drop-zone file picker with multi-select, MIME / size validation, image previews and a remove affordance."]"
         PageInstance="this"
         ApiType="@typeof(BOBInputFile)">

    <DocDemo Key="Basic" Title="@Loc["Basic single-file"]">
        <BOBInputFile OnFilesSelected="HandleSelected" />
        @if (_lastFiles.Count > 0)
        {
            <p class="doc-demo__caption">@Loc["Last selected:"] <code>@_lastFiles[0].Name</code></p>
        }
    </DocDemo>

    <DocDemo Key="Multiple" Title="@Loc["Multiple files"]">
        <BOBInputFile Multiple="true"
                      MaxFiles="5"
                      MaxSize="2097152"
                      Label="@Loc["Up to 5 files, 2 MB each"]"
                      HelperText="@Loc["Drop or click to add"]" />
    </DocDemo>

    <DocDemo Key="Accept" Title="@Loc["MIME filter — images + PDF"]">
        <BOBInputFile Accept="image/*,.pdf"
                      Multiple="true"
                      Label="@Loc["Images or PDF only"]" />
    </DocDemo>

    <DocDemo Key="Custom" Title="@Loc["Custom drop zone"]">
        <BOBInputFile Multiple="true">
            <span class="doc-fileupload-custom__title">@Loc["Drop your screenshots here"]</span>
            <span class="doc-fileupload-custom__hint">@Loc["PNG, JPG, GIF up to 10 MB"]</span>
        </BOBInputFile>
    </DocDemo>

    <DocDemo Key="States" Title="@Loc["States"]">
        <BOBInputFile Disabled="true" Label="@Loc["Disabled"]" />
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBInputFileComponentInfo.Parameters" />
    </section>

</DocPage>

@code {
    private IReadOnlyList<IBrowserFile> _lastFiles = [];

    private void HandleSelected(IReadOnlyList<IBrowserFile> files) => _lastFiles = files;
}
