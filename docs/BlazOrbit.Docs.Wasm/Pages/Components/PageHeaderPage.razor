@page "/components/layout/page-header"

@using BlazOrbit.Components

@inject IStringLocalizer<PageHeaderPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBPageHeader"]"
         Lede="@Loc["Title strip with eyebrow, lead paragraph, breadcrumbs and right-aligned action bar."]"
         PageInstance="this"
         ApiType="@typeof(BOBPageHeader)"
         Keywords="@(["page header", "title bar", "toolbar", "heading"])">

    <DocDemo Key="Basic" Title="@Loc["Basic"]">
        <BOBPageHeader Title="@Loc["Dashboard"]">
            <Lead>@Loc["Real-time service health and performance."]</Lead>
        </BOBPageHeader>
    </DocDemo>

    <DocDemo Key="WithEyebrowAndActions" Title="@Loc["Eyebrow + actions"]">
        <BOBPageHeader Title="@Loc["Users"]">
            <Eyebrow>@Loc["Operations"]</Eyebrow>
            <Lead>@Loc["Manage active accounts and roles."]</Lead>
            <Actions>
                <BOBButton Text="@Loc["Refresh"]"/>
                <BOBButton Text="@Loc["New user"]"/>
            </Actions>
        </BOBPageHeader>
    </DocDemo>

    <DocDemo Key="WithBreadcrumbs" Title="@Loc["With breadcrumbs"]">
        <BOBPageHeader Title="@Loc["Order #2421"]">
            <Breadcrumbs>
                <BOBBreadcrumbs Items="@_crumbs"/>
            </Breadcrumbs>
        </BOBPageHeader>
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBPageHeaderComponentInfo.Parameters"/>
    </section>

</DocPage>

@code {

    private readonly IReadOnlyList<BreadcrumbItem> _crumbs =
    [
        new("Home", "/"),
        new("Orders", "/orders"),
        new("#2421")
    ];

}
