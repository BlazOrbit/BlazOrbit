@page "/components/charts/line"
@implements IDisposable

@inject IStringLocalizer<LineChartPage> Loc

<DocPage Eyebrow="@Loc["Chart"]" Title="@Loc["BOBLineChart"]"
         Lede="@Loc["Continuous line chart with auto-detected X axis: numeric, DateTime / DateTimeOffset / TimeSpan, or categorical. Smooth interpolation, per-point markers, native SVG tooltips, zoom + brush, crosshair, annotations and live streaming — all SVG-rendered, no external chart library."]"
         PageInstance="this"
         ApiType="@typeof(BOBLineChart<,>)">

    <DocDemo Key="Basic" Title="@Loc["Basic usage (numeric X)"]">
        <BOBLineChart TX="int" TY="double"
                      Series="_numericSeries"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="Temporal" Title="@Loc["Temporal X axis"]"
             Description="@Loc["DateTime / DateTimeOffset / TimeSpan TX is auto-detected. Use BOBChartAxis.Format to control the tick label format."]">
        <BOBLineChart TX="DateTime" TY="decimal"
                      Series="_temporalSeries"
                      XAxis="@(new BOBChartAxis { Format = "yyyy-MM" })"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="Smooth" Title="@Loc["Smooth interpolation"]"
             Description="@Loc["Smooth=true draws a Catmull-Rom-style cubic bezier curve through the points instead of straight segments."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_numericSeries"
                      Smooth="true"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="MultiSeries" Title="@Loc["Multi-series with markers off"]">
        <BOBLineChart TX="int" TY="double"
                      Series="_multiSeries"
                      ShowMarkers="false"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="Stacked" Title="@Loc["Stacked lines"]"
             Description="@Loc["Stacked=true cumulates Y values so each series follows the running total. Useful for decomposition charts (e.g. revenue by region over time)."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_stackableSeries"
                      Stacked="true"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="ZoomBrush" Title="@Loc["Zoom and brush"]"
             Description="@Loc["ZoomEnabled adds wheel-to-zoom and double-click-to-reset. BrushEnabled adds drag-to-select with an optional OnBrush callback. Both require a continuous X axis."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_numericSeries"
                      ZoomEnabled="true"
                      BrushEnabled="true"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="Crosshair" Title="@Loc["Crosshair"]"
             Description="@Loc["ShowCrosshair tracks the mouse X and highlights the nearest point per series, rendering an HTML readout with the current values."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_multiSeries"
                      ShowCrosshair="true"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="ReferenceLines" Title="@Loc["Reference lines"]"
             Description="@Loc["Horizontal threshold lines rendered over the grid but under the markers."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_numericSeries"
                      Width="600" Height="320"
                      ReferenceLines="_referenceLines" />
    </DocDemo>

    <DocDemo Key="Annotations" Title="@Loc["Annotations"]"
             Description="@Loc["Mix text labels, vertical bands and symbol markers (Circle / Square / Triangle / Star / Diamond) at any data coordinate. Each annotation supports color, CSS class and pixel offsets — ideal for release markers, anomaly callouts and SLA windows."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_numericSeries"
                      Annotations="_annotations"
                      Width="600" Height="320" />
    </DocDemo>

    <DocDemo Key="Streaming" Title="@Loc["Live streaming"]"
             Description="@Loc["AppendPointsAsync pushes new points at runtime. StreamingWindow caps the FIFO buffer, StreamingFollow slides the zoom window forward and StreamingPaused freezes the visible state without dropping incoming data. Press Start to watch a live latency feed."]">
        <BOBFlexStack Gap="1rem" Direction="FlexStackDirection.Column">
            <BOBLineChart @ref="_streamChart"
                          TX="int" TY="double"
                          Series="_streamSeed"
                          StreamingWindow="40"
                          StreamingFollow="true"
                          ShowCrosshair="true"
                          ZoomEnabled="true"
                          Smooth="true"
                          ReferenceLines="_streamSloLines"
                          Width="600" Height="320" />
            <BOBFlexStack Gap="0.5rem" Direction="FlexStackDirection.Row">
                <BOBButton Text="@(_streaming ? Loc["Pause"] : Loc["Start"])" OnClick="ToggleStream" />
                <BOBButton Text="@Loc["Add one point"]" OnClick="AddStreamPoint" />
                <BOBButton Text="@Loc["Reset"]" OnClick="ResetStream" />
            </BOBFlexStack>
            <p class="doc-helper-text">@_streamStatus</p>
        </BOBFlexStack>
    </DocDemo>

    <DocDemo Key="CustomTooltip" Title="@Loc["Custom tooltip"]"
             Description="@Loc["Supply a TooltipTemplate to replace the default tooltip with your own markup."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_numericSeries"
                      Width="600" Height="320">
            <TooltipTemplate>
                <div style="display:flex;align-items:center;gap:0.5rem">
                    <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@context.Color"></span>
                    <span>@context.SeriesLabel: <strong>@context.Y</strong> at @context.X</span>
                </div>
            </TooltipTemplate>
        </BOBLineChart>
    </DocDemo>

</DocPage>

@code {

    private BOBLineChart<int, double>? _streamChart;
    private int _streamIndex = 7;
    private string _streamStatus = "Buffer: 6 points";
    private System.Threading.Timer? _streamTimer;
    private bool _streaming;

    public void Dispose() => _streamTimer?.Dispose();

    private async Task AddStreamPoint()
    {
        if (_streamChart is null) return;

        var pt = new BOBChartPoint<int, double>(_streamIndex, Random.Shared.NextDouble() * 30 + 5);
        await _streamChart.AppendPointsAsync("Latency (ms)", pt);
        _streamIndex++;
        _streamStatus = $"Last appended: X={pt.X}, Y={pt.Y:F1}";
    }

    private void ToggleStream()
    {
        if (_streaming)
        {
            _streamTimer?.Dispose();
            _streamTimer = null;
            _streaming = false;
            _streamStatus = $"Paused at X={_streamIndex - 1}";
            return;
        }
        _streaming = true;
        _streamTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(AddStreamPoint);
        }, null, dueTime: 0, period: 600);
    }

    private async Task ResetStream()
    {
        if (_streamChart is null) return;
        _streamTimer?.Dispose();
        _streamTimer = null;
        _streaming = false;
        await _streamChart.ClearStreamingAsync();
        _streamIndex = 7;
        _streamStatus = "Buffer reset";
    }

    private static readonly IEnumerable<BOBChartSeries<int, double>> _numericSeries =
        new[]
        {
            new BOBChartSeries<int, double>
            {
                Label = "Latency (ms)",
                Points = new[]
                {
                    new BOBChartPoint<int, double>(1, 12.4),
                    new BOBChartPoint<int, double>(2, 18.9),
                    new BOBChartPoint<int, double>(3, 9.7),
                    new BOBChartPoint<int, double>(4, 22.1),
                    new BOBChartPoint<int, double>(5, 15.3),
                    new BOBChartPoint<int, double>(6, 30.6),
                }
            }
        };

    private static readonly IEnumerable<BOBChartSeries<DateTime, decimal>> _temporalSeries =
        new[]
        {
            new BOBChartSeries<DateTime, decimal>
            {
                Label = "MRR",
                Points = new[]
                {
                    new BOBChartPoint<DateTime, decimal>(new DateTime(2026, 01, 01), 12_000m),
                    new BOBChartPoint<DateTime, decimal>(new DateTime(2026, 02, 01), 14_500m),
                    new BOBChartPoint<DateTime, decimal>(new DateTime(2026, 03, 01), 13_800m),
                    new BOBChartPoint<DateTime, decimal>(new DateTime(2026, 04, 01), 17_200m),
                    new BOBChartPoint<DateTime, decimal>(new DateTime(2026, 05, 01), 18_900m),
                }
            }
        };

    private static readonly IEnumerable<BOBChartSeries<int, double>> _multiSeries =
        new[]
        {
            new BOBChartSeries<int, double>
            {
                Label = "Build A",
                Points = Enumerable.Range(1, 12)
                    .Select(i => new BOBChartPoint<int, double>(i, 50 + Math.Sin(i * 0.6) * 15))
                    .ToArray()
            },
            new BOBChartSeries<int, double>
            {
                Label = "Build B",
                Points = Enumerable.Range(1, 12)
                    .Select(i => new BOBChartPoint<int, double>(i, 55 + Math.Cos(i * 0.4) * 10))
                    .ToArray()
            }
        };

    private static readonly IEnumerable<BOBChartSeries<int, double>> _stackableSeries =
        new[]
        {
            new BOBChartSeries<int, double>
            {
                Label = "Direct",
                Points = Enumerable.Range(1, 8)
                    .Select(i => new BOBChartPoint<int, double>(i, 20 + i * 2))
                    .ToArray()
            },
            new BOBChartSeries<int, double>
            {
                Label = "Referral",
                Points = Enumerable.Range(1, 8)
                    .Select(i => new BOBChartPoint<int, double>(i, 10 + i))
                    .ToArray()
            },
            new BOBChartSeries<int, double>
            {
                Label = "Organic",
                Points = Enumerable.Range(1, 8)
                    .Select(i => new BOBChartPoint<int, double>(i, 15 + i * 1.5))
                    .ToArray()
            }
        };

    private static readonly IEnumerable<BOBChartSeries<int, double>> _streamSeed =
        new[]
        {
            new BOBChartSeries<int, double>
            {
                Label = "Latency (ms)",
                Points = new[]
                {
                    new BOBChartPoint<int, double>(1, 12.4),
                    new BOBChartPoint<int, double>(2, 18.9),
                    new BOBChartPoint<int, double>(3, 9.7),
                    new BOBChartPoint<int, double>(4, 22.1),
                    new BOBChartPoint<int, double>(5, 15.3),
                    new BOBChartPoint<int, double>(6, 30.6),
                }
            }
        };

    private static readonly IEnumerable<BOBChartReferenceLine> _referenceLines =
        new[]
        {
            new BOBChartReferenceLine
            {
                Value = 20,
                Label = "SLO",
                Color = "var(--palette-error)",
                Style = BOBChartReferenceLineStyle.Dashed,
                StrokeWidth = 2
            }
        };

    private static readonly IEnumerable<BOBChartReferenceLine> _streamSloLines =
        new[]
        {
            new BOBChartReferenceLine
            {
                Value = 25,
                Label = "p95 SLO",
                Color = "var(--palette-warning)",
                Style = BOBChartReferenceLineStyle.Dashed,
                StrokeWidth = 1.5
            }
        };

    // Mix of annotation kinds against the _numericSeries (X 1..6, Y up to 30).
    private static readonly IEnumerable<BOBChartAnnotation> _annotations =
        new BOBChartAnnotation[]
        {
            // Vertical band marking a deploy window across X = 2..3.
            new BOBChartBandAnnotation<int>
            {
                FromX = 2,
                ToX = 3,
                FillOpacity = 0.18,
                Label = "Deploy v2.4",
                Color = "var(--palette-warning)"
            },
            // Star marker at the latency peak (X=6, Y≈30.6).
            new BOBChartShapeAnnotation<int, double>
            {
                X = 6,
                Y = 30.6,
                Shape = BOBChartAnnotationShape.Star,
                SizePx = 18,
                Color = "var(--palette-error)"
            },
            // Text label sitting above the peak.
            new BOBChartTextAnnotation<int, double>
            {
                X = 6,
                Y = 30.6,
                Text = "Peak",
                DxPx = 10,
                DyPx = -12,
                Color = "var(--palette-error)"
            },
            // Diamond marker at the dip (X=3, Y=9.7).
            new BOBChartShapeAnnotation<int, double>
            {
                X = 3,
                Y = 9.7,
                Shape = BOBChartAnnotationShape.Diamond,
                SizePx = 14,
                Color = "var(--palette-success)"
            },
        };
}
