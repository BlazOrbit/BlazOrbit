@page "/components/charts/donut"

@inject IStringLocalizer<DonutChartPage> Loc

<DocPage Eyebrow="@Loc["Chart"]" Title="@Loc["BOBDonutChart"]"
         Lede="@Loc["Annular distribution chart — same shape as the pie but with a hollow centre (default 60% of the outer radius). Useful for embedding a KPI label inside the ring."]"
         PageInstance="this"
         ApiType="@typeof(BOBDonutChart<>)"
>

    <DocDemo Key="Basic" Title="@Loc["Basic usage"]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       Width="380" Height="380" />
    </DocDemo>

    <DocDemo Key="ThinRing" Title="@Loc["Thin ring (InnerRadius = 0.8)"]"
             Description="@Loc["A higher InnerRadius (closer to 1) produces a thinner ring. Lower values approach the look of a full pie."]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       InnerRadius="0.8"
                       Width="380" Height="380" />
    </DocDemo>

    <DocDemo Key="WideRing" Title="@Loc["Wide ring (InnerRadius = 0.35)"]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       InnerRadius="0.35"
                       Width="380" Height="380" />
    </DocDemo>

    <DocDemo Key="WithExport" Title="@Loc["With export button"]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       Width="380" Height="380"
                       ShowExportButton="true"
                       ExportFileName="status-distribution" />
    </DocDemo>

    <DocDemo Key="SliceClick" Title="@Loc["Slice click handler"]"
             Description="@Loc["OnSliceClick fires when a slice is clicked. Combine with a centred KPI label for interactive dashboards."]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       Width="380" Height="380"
                       OnSliceClick="HandleSliceClick" />
        @if (!string.IsNullOrEmpty(_clickMessage))
        {
            <p class="doc-helper-text">@_clickMessage</p>
        }
    </DocDemo>

    <DocDemo Key="CustomPadding" Title="@Loc["Custom padding"]"
             Description="@Loc["Padding controls the pixel inset between the SVG viewport edge and the outer radius. Increase it when labels or legend crowd the ring."]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       Width="380" Height="380"
                       Padding="32" />
    </DocDemo>

    <DocDemo Key="LegendTop" Title="@Loc["Legend on top"]"
             Description="@Loc["LegendPosition can be combined with any InnerRadius to suit your layout."]">
        <BOBDonutChart TY="decimal"
                       Slices="_statusSlices"
                       Width="380" Height="380"
                       LegendPosition="BOBChartLegendPosition.Top" />
    </DocDemo>

</DocPage>

@code {

    private string? _clickMessage;

    private void HandleSliceClick(BOBChartSliceClickArgs<decimal> args)
    {
        _clickMessage = $"Clicked: {args.SliceLabel} — {args.Value} ({args.Percentage:F1}%)";
    }

    private static readonly IEnumerable<BOBChartSlice<decimal>> _statusSlices =
        new[]
        {
            new BOBChartSlice<decimal> { Label = "Active", Value = 62m },
            new BOBChartSlice<decimal> { Label = "Idle",   Value = 27m },
            new BOBChartSlice<decimal> { Label = "Error",  Value = 11m },
        };
}
