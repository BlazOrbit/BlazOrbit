@page "/components/charts/sparkline"

@inject IStringLocalizer<SparklinePage> Loc

<DocPage Eyebrow="@Loc["Chart"]" Title="@Loc["Sparkline"]"
         Lede="@Loc["Sparkline mode is a parameter on BOBLineChart that hides axes, grid, tick labels and legend — only the line stroke remains. Pair with a small Width / Height (e.g. 120×32) to embed inline in tables, KPI cards or list rows."]"
         PageInstance="this"
         ApiType="@typeof(BOBLineChart<,>)">

    <BOBBanner Severity="BOBBannerSeverity.Warning"
               Title="@Loc["Extra package required"]"
               Message="@Loc["This chart requires the BlazOrbit.Charts NuGet package. Install it with dotnet add package BlazOrbit.Charts and register AddBlazOrbitCharts() in Program.cs."]" />

    <DocDemo Key="Inline" Title="@Loc["Inline KPI sparklines"]">
        <BOBFlexStack Gap="2rem" Direction="FlexStackDirection.Column">
            <BOBFlexStack Gap="1rem" Direction="FlexStackDirection.Row">
                <span><strong>API latency</strong></span>
                <BOBLineChart TX="int" TY="double"
                              Series="_latency"
                              Sparkline="true"
                              ShowMarkers="false"
                              Width="160" Height="32" />
                <span>32 ms</span>
            </BOBFlexStack>
            <BOBFlexStack Gap="1rem" Direction="FlexStackDirection.Row">
                <span><strong>Active users</strong></span>
                <BOBLineChart TX="int" TY="double"
                              Series="_activeUsers"
                              Sparkline="true"
                              ShowMarkers="false"
                              Smooth="true"
                              Width="160" Height="32" />
                <span>2 481</span>
            </BOBFlexStack>
            <BOBFlexStack Gap="1rem" Direction="FlexStackDirection.Row">
                <span><strong>Error rate</strong></span>
                <BOBLineChart TX="int" TY="double"
                              Series="_errorRate"
                              Sparkline="true"
                              ShowMarkers="false"
                              Width="160" Height="32" />
                <span>0.42%</span>
            </BOBFlexStack>
        </BOBFlexStack>
    </DocDemo>

    <DocDemo Key="WithMarkers" Title="@Loc["Sparkline with markers"]"
             Description="@Loc["ShowMarkers=true keeps the per-point dots even in sparkline mode for cases where individual reading values matter (e.g. financial last-trade markers)."]">
        <BOBLineChart TX="int" TY="double"
                      Series="_latency"
                      Sparkline="true"
                      MarkerRadius="2"
                      Width="240" Height="48" />
    </DocDemo>

</DocPage>

@code {

    private static IEnumerable<BOBChartSeries<int, double>> Synth(string label, double mean, double stddev, int seed, int n = 30)
    {
        Random rng = new(seed);
        var pts = new List<BOBChartPoint<int, double>>();
        for (int i = 0; i < n; i++)
        {
            double u1 = 1 - rng.NextDouble();
            double u2 = 1 - rng.NextDouble();
            double z = Math.Sqrt(-2 * Math.Log(u1)) * Math.Cos(2 * Math.PI * u2);
            pts.Add(new BOBChartPoint<int, double>(i, mean + z * stddev));
        }
        return new[] { new BOBChartSeries<int, double> { Label = label, Points = pts.ToArray() } };
    }

    private static readonly IEnumerable<BOBChartSeries<int, double>> _latency = Synth("latency", 30, 6, 1);
    private static readonly IEnumerable<BOBChartSeries<int, double>> _activeUsers = Synth("users", 2400, 80, 2);
    private static readonly IEnumerable<BOBChartSeries<int, double>> _errorRate = Synth("errors", 0.5, 0.15, 3);
}
