@page "/components/charts/mixed"

@inject IStringLocalizer<MixedChartPage> Loc

<DocPage Eyebrow="@Loc["Chart"]" Title="@Loc["BOBMixedChart"]"
         Lede="@Loc["Combined-series chart that blends bar + line + area in a single plot. Series share the X axis and can optionally bind to a secondary Y axis on the right edge — handy for actual vs target reports or value vs ratio comparisons."]"
         PageInstance="this"
         ApiType="@typeof(BOBMixedChart<>)"
         Keywords="@(["mixed", "combo", "bar", "line", "area", "secondary axis", "dual axis", "actual vs target"])">

    <BOBBanner Severity="BOBBannerSeverity.Warning"
               Title="@Loc["Extra package required"]"
               Message="@Loc["This chart requires the BlazOrbit.Charts NuGet package. Install it with dotnet add package BlazOrbit.Charts and register AddBlazOrbitCharts() in Program.cs."]"/>

    <DocDemo Key="BarPlusLine" Title="@Loc["Bars with trend line"]"
             Description="@Loc["Bars carry the actuals; the line sits on top showing the rolling target. Both share the primary Y axis (same unit)."]">
        <BOBMixedChart TX="string"
                       Series="_actualVsTarget"
                       Width="640" Height="320"/>
    </DocDemo>

    <DocDemo Key="DualAxis" Title="@Loc["Secondary axis"]"
             Description="@Loc["Set UseSecondaryAxis on a series to project it against the right-side scale instead of the primary one — required when the series belongs to a different domain (e.g. revenue in $ vs conversion in %)."]">
        <BOBMixedChart TX="string"
                       Series="_revenueAndRatio"
                       SecondaryAxisLabel="%"
                       Width="640" Height="320"/>
    </DocDemo>

    <DocDemo Key="Triple" Title="@Loc["Bar + Area + Line"]"
             Description="@Loc["All three visual types coexist on the same plot. Render order is bars → areas → lines so lines always sit on top."]">
        <BOBMixedChart TX="string"
                       Series="_triple"
                       BarGroupRatio="0.55"
                       Width="640" Height="320"/>
    </DocDemo>

</DocPage>

