@page "/components/charts/radar"

@inject IStringLocalizer<RadarChartPage> Loc

<DocPage Eyebrow="@Loc["Chart"]" Title="@Loc["BOBRadarChart"]"
         Lede="@Loc["Radar / spider chart — multi-dimensional comparison across N axes (3-12). Each series renders a closed polygon; categories are evenly distributed around the circle."]"
         PageInstance="this"
         ApiType="@typeof(BOBRadarChart<,>)">

    <DocDemo Key="Basic" Title="@Loc["Single-series profile"]">
        <BOBRadarChart TX="string" TY="double"
                       Series="_skillsSingle"
                       Width="420" Height="420" />
    </DocDemo>

    <DocDemo Key="MultiSeries" Title="@Loc["Multi-series comparison"]"
             Description="@Loc["Overlap two profiles to compare shapes — ideal for skill matrices, product feature parity, A/B benchmark dashboards."]">
        <BOBRadarChart TX="string" TY="double"
                       Series="_skillsMulti"
                       Width="440" Height="440" />
    </DocDemo>

    <DocDemo Key="Rings" Title="@Loc["Custom ring count + max"]">
        <BOBRadarChart TX="string" TY="double"
                       Series="_skillsMulti"
                       RingCount="6"
                       Max="10"
                       FillOpacity="0.18"
                       Width="440" Height="440" />
    </DocDemo>

</DocPage>

