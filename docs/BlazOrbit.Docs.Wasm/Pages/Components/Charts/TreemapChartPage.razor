@page "/components/charts/treemap"

@inject IStringLocalizer<TreemapChartPage> Loc

<DocPage Eyebrow="@Loc["Chart"]" Title="@Loc["BOBTreemapChart"]"
         Lede="@Loc["Hierarchical layout that fills a rectangle with proportionally sized cells. The squarified algorithm keeps each cell close to square so adjacent magnitudes are easy to compare. Use for portfolio breakdowns, storage usage, organisation charts and budget allocation."]"
         PageInstance="this"
         ApiType="@typeof(BOBTreemapChart<>)"
         Keywords="@(["treemap", "hierarchy", "tree", "portfolio", "squarified", "drilldown"])">

    <BOBBanner Severity="BOBBannerSeverity.Warning"
               Title="@Loc["Extra package required"]"
               Message="@Loc["This chart requires the BlazOrbit.Charts NuGet package. Install it with dotnet add package BlazOrbit.Charts and register AddBlazOrbitCharts() in Program.cs."]"/>

    <DocDemo Key="FlatPortfolio" Title="@Loc["Flat portfolio breakdown"]">
        <BOBTreemapChart TY="decimal"
                         Nodes="_portfolio"
                         Width="640" Height="320"/>
    </DocDemo>

    <DocDemo Key="Hierarchical" Title="@Loc["Hierarchical drill-down"]"
             Description="@Loc["Branch nodes recurse into nested rects so the chart reads as a tree. Padding leaves a frame around each parent so the hierarchy stays visible."]">
        <BOBTreemapChart TY="decimal"
                         Nodes="_hierarchy"
                         Padding="3"
                         MinLabelSize="40"
                         OnNodeClick="@(EventCallback.Factory.Create<BOBChartTreemapClickArgs<decimal>>(this, HandleNodeClick))"
                         Width="720" Height="360"/>
        @if (_lastClicked is not null)
        {
            <p class="doc-callout doc-callout--info"><strong>@Loc["Clicked:"]</strong> @string.Join(" / ", _lastClicked.Path) - @_lastClicked.Node.Value</p>
        }
    </DocDemo>

    <DocDemo Key="CustomColors" Title="@Loc["Explicit per-node colors"]"
             Description="@Loc["Node Color overrides the auto-palette. Useful when categories already have brand colours assigned upstream."]">
        <BOBTreemapChart TY="decimal"
                         Nodes="_branded"
                         Width="640" Height="280"/>
    </DocDemo>

</DocPage>

@code {

    private BOBChartTreemapClickArgs<decimal>? _lastClicked;

    private void HandleNodeClick(BOBChartTreemapClickArgs<decimal> args)
    {
        _lastClicked = args;
    }

