@page "/components/forms/autocomplete"

@inject IStringLocalizer<AutoCompletePage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBAutoComplete"]"
         Lede="@Loc["Async-source typeahead with debounce, cancellation, keyboard navigation and custom item templates."]"
         PageInstance="this"
         ApiType="@typeof(BOBAutoComplete<>)"
         Keywords="@(["autocomplete", "suggest", "typeahead", "search"])">

    <DocDemo Key="Basic" Title="@Loc["Basic usage"]">
        <BOBAutoComplete TItem="string"
                         @bind-Value="_picked"
                         SearchAsync="SearchCountries"
                         ItemText="@(c => c)"
                         Label="@Loc["Country"]"
                         Placeholder="@Loc["Type to search…"]"/>
        @if (!string.IsNullOrEmpty(_picked))
        {
            <p class="doc-demo__caption">@Loc["Picked:"] <code>@_picked</code></p>
        }
    </DocDemo>

    <DocDemo Key="Debounce" Title="@Loc["Debounce"]">
        <BOBAutoComplete TItem="string"
                         @bind-Value="_debounced"
                         SearchAsync="SearchCountries"
                         ItemText="@(c => c)"
                         DebounceMs="500"
                         Label="@Loc["500ms debounce"]"/>
    </DocDemo>

    <DocDemo Key="MinLength" Title="@Loc["Minimum search length"]">
        <BOBAutoComplete TItem="string"
                         @bind-Value="_minLength"
                         SearchAsync="SearchCountries"
                         ItemText="@(c => c)"
                         MinSearchLength="3"
                         Label="@Loc["Type 3+ chars"]"/>
    </DocDemo>

    <DocDemo Key="Template" Title="@Loc["Custom item template"]">
        <BOBAutoComplete TItem="Country"
                         @bind-Value="_country"
                         SearchAsync="SearchCountriesObj"
                         ItemText="@(c => c.Name)"
                         Label="@Loc["Country"]">
            <ItemTemplate>
                <div class="doc-ac-item">
                    <strong>@context.Name</strong>
                    <span class="doc-ac-item__code">@context.Code</span>
                </div>
            </ItemTemplate>
        </BOBAutoComplete>
    </DocDemo>

    <DocDemo Key="NoResults" Title="@Loc["No-results template"]">
        <BOBAutoComplete TItem="string"
                         @bind-Value="_empty"
                         SearchAsync="@((q, ct) => Task.FromResult(Enumerable.Empty<string>()))"
                         ItemText="@(c => c)"
                         Label="@Loc["Always empty"]">
            <NoResultsTemplate>
                <em>@Loc["Nothing matches"] "<strong>@context</strong>"</em>
            </NoResultsTemplate>
        </BOBAutoComplete>
    </DocDemo>

    <DocDemo Key="FreeText" Title="@Loc["Free-text commit via StringToItem"]"
             Description="@Loc["StringToItem promotes whatever the user typed into a TItem on blur or Enter - useful for tag-style inputs that accept ad-hoc values alongside the suggestion list."]">
        <BOBAutoComplete TItem="string"
                         @bind-Value="_freeText"
                         SearchAsync="SearchCountries"
                         ItemText="@(c => c)"
                         StringToItem="@(s => string.IsNullOrWhiteSpace(s) ? null : s.Trim())"
                         Label="@Loc["Country or custom value"]"
                         Placeholder="@Loc["Pick one or type your own…"]"/>
        @if (!string.IsNullOrEmpty(_freeText))
        {
            <p class="doc-demo__caption">@Loc["Committed:"] <code>@_freeText</code></p>
        }
    </DocDemo>

    <DocDemo Key="States" Title="@Loc["States"]">
        <BOBAutoComplete TItem="string"
                         @bind-Value="_required"
                         SearchAsync="SearchCountries"
                         ItemText="@(c => c)"
                         Required="true"
                         Label="@Loc["Required"]"/>
        <br/>
        <BOBAutoComplete TItem="string"
                         @bind-Value="_disabled"
                         SearchAsync="SearchCountries"
                         ItemText="@(c => c)"
                         Disabled="true"
                         Label="@Loc["Disabled"]"/>
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBAutoCompleteComponentInfo.Parameters"/>
    </section>

</DocPage>

@code {
    private string? _picked;
    private string? _debounced;
    private string? _minLength;
    private string? _empty;
    private string? _required;
    private string? _disabled;
    private string? _freeText;
    private Country? _country;

    private static readonly string[] _countries =
    [
        "Argentina", "Brazil", "Canada", "Chile", "China", "Colombia", "Denmark",
        "Egypt", "Finland", "France", "Germany", "Greece", "India", "Indonesia",
        "Italy", "Japan", "Korea", "Mexico", "Netherlands", "Norway", "Peru",
        "Poland", "Portugal", "Romania", "Russia", "Spain", "Sweden", "Turkey",
        "Ukraine", "United Kingdom", "United States", "Uruguay", "Venezuela", "Vietnam"
    ];

    private async Task<IEnumerable<string>> SearchCountries(string query, CancellationToken ct)
    {
        await Task.Delay(150, ct);
        return _countries
            .Where(c => c.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8);
    }

    private async Task<IEnumerable<Country>> SearchCountriesObj(string query, CancellationToken ct)
    {
        await Task.Delay(150, ct);
        return _countries
            .Where(c => c.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .Select(c => new Country { Name = c, Code = c.Substring(0, Math.Min(2, c.Length)).ToUpperInvariant() });
    }

    public class Country
    {
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
    }

}
