@page "/components/forms/numberslider"

@inject IStringLocalizer<InputNumberSliderPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBInputNumberSlider"]"
         Lede="@Loc["Single-thumb numeric slider with min, max, step, ticks, and value label. Supports horizontal and vertical orientation with full keyboard navigation."]"
         PageInstance="this"
         ApiType="@typeof(BOBInputNumberSlider<>)"
         Keywords="@(["number slider", "range", "numeric", "input"])">

    <section class="doc-section">
        <p class="doc-section__description">
                        @Loc.Html("The component accepts any .NET numeric type that implements <code>INumber&lt;T&gt;</code> - <code>int</code>, <code>decimal</code>, <code>double</code>, <code>float</code>, and more. This is enforced at compile time via the generic <code>TValue</code> parameter. All interactive features - stepper buttons, tick marks, value labels, and keyboard arrow navigation - are available regardless of the underlying numeric type.")
        </p>
    </section>

    <DocDemo Key="Basic" Title="@Loc["Basic usage"]">
        <BOBInputNumberSlider TValue="int" @bind-Value="_basic" Label="@Loc["Volume"]"/>
    </DocDemo>

    <DocDemo Key="MinMaxStep" Title="@Loc["Min, Max & Step"]">
        <BOBInputNumberSlider TValue="int" @bind-Value="_brightness" Label="@Loc["Brightness"]" Min="0" Max="100"
                              Step="5"/>
    </DocDemo>

    <DocDemo Key="Decimals" Title="@Loc["Decimal values"]">
        <BOBInputNumberSlider TValue="decimal" @bind-Value="_temperature" Label="@Loc["Temperature"]" Min="-20m"
                              Max="40m" Step="0.5m" ValueLabelFormat="0.0 °C"/>
    </DocDemo>

    <DocDemo Key="Ticks" Title="@Loc["Ticks"]">
        <BOBInputNumberSlider TValue="int" @bind-Value="_zoom" Label="@Loc["Zoom"]" Min="0" Max="100" Step="10"
                              ShowTicks="true"/>
    </DocDemo>

    <DocDemo Key="Vertical" Title="@Loc["Vertical orientation"]">
        <div style="height: 240px; display: flex; gap: 2rem;">
            <BOBInputNumberSlider TValue="int" @bind-Value="_verticalA" Label="@Loc["Bass"]"
                                  Orientation="BOBSliderOrientation.Vertical" Min="0" Max="100"/>
            <BOBInputNumberSlider TValue="int" @bind-Value="_verticalB" Label="@Loc["Mid"]"
                                  Orientation="BOBSliderOrientation.Vertical" Min="0" Max="100"/>
            <BOBInputNumberSlider TValue="int" @bind-Value="_verticalC" Label="@Loc["Treble"]"
                                  Orientation="BOBSliderOrientation.Vertical" Min="0" Max="100"/>
        </div>
    </DocDemo>

    <DocDemo Key="Sizes" Title="@Loc["Sizes"]">
        <BOBInputNumberSlider TValue="int" @bind-Value="_sizeS" Label="@Loc["Small"]" Size="BOBSize.Small"/>
        <BOBInputNumberSlider TValue="int" @bind-Value="_sizeM" Label="@Loc["Medium (Default)"]" Size="BOBSize.Medium"/>
        <BOBInputNumberSlider TValue="int" @bind-Value="_sizeL" Label="@Loc["Large"]" Size="BOBSize.Large"/>
    </DocDemo>

    <DocDemo Key="ColorAndBackground" Title="@Loc["Color & Background"]">
        <BOBInputNumberSlider TValue="int" @bind-Value="_colored" Label="@Loc["Custom Color"]"
                              Color="@BOBColor.Beige.Lighten2" BackgroundColor="@BOBColor.DarkViolet.Darken3"/>
    </DocDemo>

    <DocDemo Key="States" Title="@Loc["States"]">
        <BOBInputNumberSlider TValue="int" @bind-Value="_required" Label="@Loc["Required"]" Required="true"/>
        <BOBInputNumberSlider TValue="int" @bind-Value="_readonly" Label="@Loc["ReadOnly"]" ReadOnly="true"/>
        <BOBInputNumberSlider TValue="int" @bind-Value="_disabled" Label="@Loc["Disabled"]" Disabled="true"/>
        <BOBInputNumberSlider TValue="int" @bind-Value="_errorValue" Label="@Loc["Error"]" Error="true"
                              HelperText="@Loc["Validation message goes here."]"/>
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBInputNumberSliderComponentInfo.Parameters"/>
    </section>

</DocPage>

@code {
    private int _basic = 30;
    private int _brightness = 60;
    private decimal _temperature = 21.5m;
    private int _zoom = 50;
    private int _verticalA = 40;
    private int _verticalB = 60;
    private int _verticalC = 75;
    private int _sizeS = 25;
    private int _sizeM = 50;
    private int _sizeL = 75;
    private int _colored = 50;
    private int _required;
    private int _readonly = 42;
    private int _disabled = 42;
    private int _errorValue = 5;
}
