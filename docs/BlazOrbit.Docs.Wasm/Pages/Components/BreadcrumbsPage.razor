@page "/components/navigation/breadcrumbs"

@using BlazOrbit.Components
@using BlazOrbit.Components.Navigation

@inject IStringLocalizer<BreadcrumbsPage> Loc


<DocPage Eyebrow="@Loc["Component"]" Title="@Loc["BOBBreadcrumbs"]"
         Lede="@Loc["Compact trail showing where the user is and how to walk back up the route."]"
         PageInstance="this"
         ApiType="@typeof(BOBBreadcrumbs)"
         Keywords="@(["breadcrumbs", "navigation path", "hierarchy"])">

    <DocDemo Key="Basic" Title="@Loc["Basic"]">
        <BOBBreadcrumbs Items="@_basicItems"/>
    </DocDemo>

    <DocDemo Key="WithIcons" Title="@Loc["With leading icons"]">
        <BOBBreadcrumbs Items="@_iconItems"/>
    </DocDemo>

    <DocDemo Key="CustomSeparator" Title="@Loc["Custom separator"]">
        <BOBBreadcrumbs Items="@_basicItems">
            <Separator>
                <span class="doc-demo__inline">/</span>
            </Separator>
        </BOBBreadcrumbs>
    </DocDemo>

    <DocDemo Key="Truncated" Title="@Loc["Truncated trail"]">
        <BOBBreadcrumbs Items="@_longItems" MaxVisible="3"/>
        <p class="doc-demo__caption">@Loc["MaxVisible=3 hides the middle entries behind an ellipsis."]</p>
    </DocDemo>

    <DocDemo Key="ItemTemplate" Title="@Loc["Custom item template"]">
        <BOBBreadcrumbs Items="@_basicItems">
            <ItemTemplate Context="item">
                @if (item.IsCurrent)
                {
                    <strong>@item.Text</strong>
                }
                else
                {
                    <a class="doc-demo__inline" href="@item.Href">@item.Text.ToUpperInvariant()</a>
                }
            </ItemTemplate>
        </BOBBreadcrumbs>
    </DocDemo>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Properties"]</h2>
        <PropertyTable Properties="@BOBBreadcrumbsComponentInfo.Parameters"/>
    </section>

</DocPage>

@code {

    private readonly IReadOnlyList<BreadcrumbItem> _basicItems =
    [
        new("Home", "/"),
        new("Components", "/components"),
        new("Navigation", "/components/navigation"),
        new("Breadcrumbs")
    ];

    private readonly IReadOnlyList<BreadcrumbItem> _iconItems =
    [
        new("Home", "/", BOBIconKeys.MaterialIconsOutlined.i_home),
        new("Settings", "/settings", BOBIconKeys.MaterialIconsOutlined.i_settings),
        new("Profile")
    ];

    private readonly IReadOnlyList<BreadcrumbItem> _longItems =
    [
        new("Root", "/"),
        new("Workspace", "/workspace"),
        new("Project", "/workspace/project"),
        new("Folder", "/workspace/project/folder"),
        new("Subfolder", "/workspace/project/folder/sub"),
        new("Document")
    ];

}
