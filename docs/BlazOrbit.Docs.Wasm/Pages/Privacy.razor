@page "/privacy"
@layout MainLayout

@inject IStringLocalizer<Privacy> Loc

<DocSeo Title="@Loc["Privacy"]"
        Description="@Loc["BlazOrbit documentation site privacy policy. No trackers, no analytics, no third-party scripts."]"
        Keywords="@(["privacy", "policy", "no tracking", "cookies", "GDPR"])"/>

<div class="doc-content">
    <h1>@Loc["Privacy"]</h1>

    <p>
        @Loc["This documentation site is intentionally analytics-free."]
    </p>

    <ul>
        <li>@Loc["No Google Analytics, Plausible, Fathom, Cloudflare Web Analytics, or any other tracker."]</li>
        <li>@Loc.Html("No third-party scripts are loaded. Every JavaScript and CSS asset ships from the same origin as this page (<code>self</code> in CSP terms).")</li>
        <li>@Loc["No remote fonts. Typography is bundled."]</li>
        <li>@Loc.Html("No telemetry beacons from the BlazOrbit runtime. The library never phones home; the only outbound surface in any consumer app is the optional <code>/BlazOrbit/Culture/Set</code> endpoint when Server localization is opted in.")</li>
    </ul>

    <p>
        @Loc["This policy is intentional and not subject to change without an explicit announcement on the GitHub repository."]
    </p>
</div>
