@page "/features/localization"

@inject IStringLocalizer<Localization> Loc

<DocPage Eyebrow="@Loc["Feature"]"
         Title="@Loc["Localization"]"
         Lede="@Loc["BOBLocalize - compile-time bundles, .tn translation files, pluggable providers, and a culture selector that ships with the integration packages."]"
         Keywords="@(["localization", "i18n", "culture", "translation", "multi-language", "boblocalize"])">

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Which package to install"]</h2>
        <ul>
            <li>@Loc.Html("<code>BlazOrbit.Localization.Wasm</code> - for Blazor WebAssembly apps. Persists the chosen culture in <code>localStorage</code>.")</li>
            <li>@Loc.Html("<code>BlazOrbit.Localization.Server</code> - for Blazor Server apps. Persists via an HTTP cookie and wires up <code>RequestLocalizationOptions</code>.")</li>
        </ul>
        <p class="doc-section__description">
            @Loc.Html("Both packages register <code>BobLocalizer&lt;T&gt;</code> as the <code>IStringLocalizer&lt;T&gt;</code> implementation - components keep injecting the standard ASP.NET interface and resolve through BOBLocalize. No <code>.resx</code> files, no satellite assemblies.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["WASM setup"]</h2>
        <BOBCodeBlock Title="Program.cs"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="@_wasmProgram"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("<code>UseBlazOrbitLocalizationWasm</code> reads the persisted culture before any component renders, so the first paint uses the right language.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Server setup"]</h2>
        <BOBCodeBlock Title="Program.cs"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="@_serverProgram"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("A <code>CookieRequestCultureProvider</code> is inserted at the front of the request localization chain. A startup filter registers a <code>/BlazOrbit/Culture/Set</code> endpoint the selector uses to set the cookie.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["The BOBCultureSelector"]</h2>
        <p class="doc-section__description">
            @Loc.Html("Ships with <code>BlazOrbit.Localization.Shared</code> (a transitive dependency of both <code>.Server</code> and <code>.Wasm</code>). Two built-in variants:")
        </p>
        <ul>
            <li>@Loc.Html("<code>BOBCultureSelectorVariant.Dropdown</code> - a styled dropdown with flags and culture names.")</li>
            <li>@Loc.Html("<code>BOBCultureSelectorVariant.Flags</code> - one flag button per supported culture.")</li>
        </ul>
        <BOBCodeBlock Title="MainLayout.razor"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_selectorUsage"/>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Authoring your own strings"]</h2>
        <p class="doc-section__description">
            @Loc.Html("Translations live in <code>.tn</code> files - a tiny escape-minimal text format - and are packaged into <em>bundles</em>. A bundle is announced with an assembly-level attribute that names a <em>marker type</em>; the source generator picks up the marker and bakes every <code>.tn</code> file under <code>Translations/</code> into a compile-time <code>FrozenDictionary</code>.")
        </p>

        <h3 class="doc-section__subtitle">@Loc["1. Declare the bundle"]</h3>
        <BOBCodeBlock Title="BobLocalizationBundles.cs"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="@_bundleDeclaration"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html(_declareBundleDesc)
        </p>

        <h3 class="doc-section__subtitle">@Loc["2. Drop the .tn files"]</h3>
        <BOBCodeBlock Title="Translations/Pages/Greeting.tn"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_tnNeutral"/>
        <BOBCodeBlock Title="Translations/Pages/Greeting.es.tn"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_tnSpanish"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("<code>#</code> lines introduce keys, the next non-empty line is the value. Multi-culture catalogues with <code>@ culture</code> headers also work. Escape a literal <code>#</code>, <code>@</code>, or <code>/</code> at the start of a line with a backslash.")
        </p>

        <h3 class="doc-section__subtitle">@Loc["3. Feed the generator"]</h3>
        <BOBCodeBlock Title="MyApp.csproj"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_consumerCsproj"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("The generator runs as an analyzer reference and reads the <code>.tn</code> files declared as <code>AdditionalFiles</code>. It emits a <code>[ModuleInitializer]</code> that registers every bundle with <code>BobLocalize</code> at assembly load - no startup code required.")
        </p>

        <h3 class="doc-section__subtitle">@Loc["4. Resolve a key in a component"]</h3>
        <BOBCodeBlock Title="Greeting.razor"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_usageCode"/>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["File-name conventions"]</h2>
        <p class="doc-section__description">
            @Loc.Html("For a marker <code>Namespace.Type</code>, the generator accepts either layout under <code>TranslationsFolder/</code>:")
        </p>
        <BOBCodeBlock Title="@Loc["Layouts that resolve to the same bundle"]"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_fileLayouts"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("Both forms canonicalise to <code>Layout.NavMenu.[culture]</code>. The match is namespace-suffix sensitive, so two <code>NavMenu</code> markers in different namespaces can ship distinct <code>.tn</code> files without colliding. Files without a culture segment use the bundle's <code>DefaultCulture</code>.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Custom providers"]</h2>
        <p class="doc-section__description">
            @Loc.Html("BOBLocalize resolves a lookup by running a <em>chain</em> of <code>IBobLocalizationProvider</code> implementations. The default chain is <code>[BundleProvider, LiteralProvider]</code> - <code>BundleProvider</code> hits the compile-time table, <code>LiteralProvider</code> is the sentinel that surfaces <code>ResourceNotFound = true</code>. Custom providers plug in for scenarios like database-backed translations or CMS strings.")
        </p>
        <BOBCodeBlock Title="@Loc["Per-bundle chain override"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="@_chainOverride"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("Register the provider in DI as a singleton (or scoped, for per-request state); the localizer resolves it through <code>IServiceProvider</code> when the chain reaches its slot. Providers return <code>false</code> from <code>TryGet</code> to defer to the next link.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Translations that contain HTML"]</h2>
        <p class="doc-section__description">
            @Loc.Html("When a translation ships markup (<code>&lt;strong&gt;</code>, <code>&lt;br /&gt;</code>, an inline icon), call <code>L.Html(key, args)</code> from <code>BobLocalizerHtmlExtensions</code>. The template is rendered verbatim through a <code>MarkupString</code>; each format argument passes through <code>HtmlEncoder.Default</code> before substitution, so untrusted runtime values cannot inject markup.")
        </p>

        <BOBCodeBlock Title="Translations/Pages/FormsPage.tn"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_tnHtml"/>
        <BOBCodeBlock Title="FormsPage.razor"
                      Language="SyntaxHighlightLanguage.Razor"
                      Code="@_usageHtml"/>
        <p class="doc-section__description" style="margin-top: 1rem;">
            @Loc.Html("<strong>Threat model.</strong> The pattern is safe while two invariants hold: translations live in source-controlled <code>.tn</code> files (audited the same way as inline Razor markup), and dynamic values reach the template only as format arguments - never concatenated into the key string. If a custom provider sources translations from user-editable storage (CMS, DB column), run an HTML sanitiser <em>before</em> wrapping in <code>MarkupString</code>; the helper only encodes arguments, not the template.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Manually switching culture"]</h2>
        <p class="doc-section__description">
            @Loc.Html("If you'd rather not use the selector, both persistence services (<code>ILocalizationPersistence</code>) expose <code>SetStoredCultureAsync</code> you can call from your own UI. The integration packages flip <code>CultureInfo.CurrentUICulture</code> and raise <code>BobLocalize.NotifyCultureChanged</code> so live components re-render.")
        </p>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["Why BOBLocalize over native resx"]</h2>
        <ul>
            <li>@Loc.Html("<strong>Compile-time bundles</strong> - every <code>.tn</code> hashes to a baked <code>FrozenDictionary&lt;ulong, string&gt;</code>. No <code>ResourceManager</code> reflection, no satellite-assembly probing.")</li>
            <li>@Loc.Html("<strong>No null returns</strong> - when no provider answers, the literal key (formatted with supplied arguments) is the value and <code>ResourceNotFound = true</code> surfaces the diagnostic.")</li>
            <li>@Loc.Html("<strong>Pluggable providers</strong> - register a <code>DbProvider</code> ahead of <code>BundleProvider</code> to overlay CMS edits on top of shipped translations.")</li>
            <li>@Loc.Html("<strong>Compatible with <code>IStringLocalizer&lt;T&gt;</code></strong> - components keep the familiar Microsoft contract; only the implementation changes.")</li>
        </ul>
    </section>

</DocPage>

@code {

    private const string _wasmProgram = @"using System.Globalization;
using BlazOrbit.Localization.Wasm;

var builder = WebAssemblyHostBuilder.CreateDefault(args);

builder.Services.AddBlazOrbit();
builder.Services.AddBlazOrbitLocalizationWasm(opts =>
{
    opts.SupportedCultures = [
        new CultureInfo(""en-US""),
        new CultureInfo(""es-ES""),
        new CultureInfo(""fr-FR"")
    ];
    opts.DefaultCulture = ""en-US"";
});

var host = builder.Build();
await host.UseBlazOrbitLocalizationWasm();
await host.RunAsync();";

    private const string _serverProgram = @"using System.Globalization;
using BlazOrbit.Localization.Server;
using Microsoft.AspNetCore.Localization;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddBlazOrbit();
builder.Services.AddBlazOrbitLocalizationServer(opts =>
{
    opts.SupportedCultures = [
        new CultureInfo(""en-US""),
        new CultureInfo(""es-ES""),
        new CultureInfo(""fr-FR"")
    ];
    opts.DefaultCulture = ""en-US"";
});

var app = builder.Build();

app.UseRequestLocalization(
    app.Services.GetRequiredService<IOptions<RequestLocalizationOptions>>().Value);

app.Run();";

    private const string _selectorUsage = @"<BOBCultureSelector Variant=""BOBCultureSelectorVariant.Dropdown"" />

@* or *@

<BOBCultureSelector Variant=""BOBCultureSelectorVariant.Flags"" />";

    private const string _bundleDeclaration = @"using BlazOrbit.Localization;
using MyApp.Pages;

[assembly: BobLocalizationBundle(typeof(GreetingResources), DefaultCulture = ""en-US"")]

namespace MyApp.Pages;

// Marker - never instantiated. Can also be an existing component class.
public sealed class GreetingResources { }";

    private const string _tnNeutral = @"# HelloWorld
Hello, world!

# WelcomeUser
Welcome, {0}!";

    private const string _tnSpanish = @"# HelloWorld
¡Hola, mundo!

# WelcomeUser
¡Bienvenido, {0}!";

    private const string _consumerCsproj = @"<ItemGroup>
  <ProjectReference Include=""..\..\src\BlazOrbit.Localization.CodeGeneration\BlazOrbit.Localization.CodeGeneration.csproj""
                    OutputItemType=""Analyzer"" ReferenceOutputAssembly=""false"" />
</ItemGroup>

<ItemGroup>
  <AdditionalFiles Include=""Translations\**\*.tn"" />
</ItemGroup>";

    private const string _usageCode = @"@inject IStringLocalizer<GreetingResources> L

<h1>@L[""HelloWorld""]</h1>
<p>@L[""WelcomeUser"", user.Name]</p>";

    private const string _fileLayouts = @"Translations/Layout/NavMenu.tn          # hierarchical (folder mirrors namespace)
Translations/Layout/NavMenu.es.tn

Translations/Layout.NavMenu.tn          # dot-separated single-file layout
Translations/Layout.NavMenu.es.tn";

    private const string _tnHtml = @"# FormsIntro
Build <strong>typed</strong> forms with <em>validated</em> bindings.

# WelcomeUser
Hello, <strong>{0}</strong>!";

    private const string _usageHtml = @"@inject IStringLocalizer<FormsPage> L

<p>@L.Html(""FormsIntro"")</p>
<p>@L.Html(""WelcomeUser"", user.Name)</p>";

    private const string _chainOverride = @"using BlazOrbit.Localization;
using BlazOrbit.Localization.Providers;

[assembly: BobLocalizationBundle(
    typeof(CmsResources),
    DefaultCulture = ""en-US"",
    Chain = new[] { typeof(DbProvider), typeof(BundleProvider), typeof(LiteralProvider) })]

// In Program.cs
services.AddSingleton<DbProvider>();";

    private string _declareBundleDesc =
        """
        typeof(...) is the marker - it can be an empty class or any existing type. The <code>DefaultCulture</code> property is the terminal fallback for the bundle's provider chain; <code>TranslationsFolder</code> (defaults to <code>"Translations"</code>) controls where the generator looks for matching <code>.tn</code> files.
        """;

}
