@page "/not-found"
@layout MainLayout

@inject IStringLocalizer<NotFound> Loc

<DocSeo Title="@Loc["Not Found"]" Description="@Loc["The requested page could not be found."]"
        Keywords="@(["404", "not found"])"
        Robots="noindex, follow"/>

<div class="doc-content">
    <h1>@Loc["Not Found"]</h1>
    <p>@Loc["Sorry, the content you are looking for does not exist."]</p>
</div>
