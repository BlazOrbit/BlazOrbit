@page "/getting-started/templates"

@inject IStringLocalizer<Templates> Loc

<DocPage Eyebrow="@Loc["Guide"]"
         Title="@Loc["Project Templates"]"
         Lede="@Loc["Start a new BlazOrbit project from a `dotnet new` template — Server or WebAssembly, .NET 8 or .NET 10, with optional localization wired up."]"
         Keywords="@(["templates", "dotnet new", "scaffolding", "project", "boilerplate"])">

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["1. Install the templates"]</h2>
        <p class="doc-section__description">
            @Loc.Html("The templates ship as a single NuGet package. Install once and the <code>dotnet new</code> CLI picks them up globally.")
        </p>

        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new install BlazOrbit.Templates"/>

        <p class="doc-section__description">
            @Loc["Update to a newer release at any time:"]
        </p>

        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new install BlazOrbit.Templates::*"/>

        <p class="doc-section__description">
            @Loc["Uninstall when you no longer need them:"]
        </p>

        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new uninstall BlazOrbit.Templates"/>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["2. Available templates"]</h2>
        <p class="doc-section__description">
            @Loc["Both templates ship the same component surface and theming pipeline. Pick the hosting model that fits your app."]
        </p>

        <table class="doc-table">
            <thead>
            <tr>
                <th>@Loc["Short name"]</th>
                <th>@Loc["Hosting"]</th>
                <th>@Loc["Description"]</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><code>blazorbit-server</code></td>
                <td>@Loc["Blazor Server"]</td>
                <td>@Loc["Interactive Server render mode + cookie-friendly auth integration points."]</td>
            </tr>
            <tr>
                <td><code>blazorbit-wasm</code></td>
                <td>@Loc["Blazor WebAssembly"]</td>
                <td>@Loc["Standalone WASM with PWA manifest, service worker, and BlazOrbit bundles preconfigured."]</td>
            </tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["3. Parameters"]</h2>

        <table class="doc-table">
            <thead>
            <tr>
                <th>@Loc["Parameter"]</th>
                <th>@Loc["Values"]</th>
                <th>@Loc["Default"]</th>
                <th>@Loc["Effect"]</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><code>-F</code> / <code>--Framework</code></td>
                <td><code>net8.0</code> · <code>net10.0</code></td>
                <td><code>net8.0</code></td>
                <td>@Loc.Html("Targets the chosen TFM and switches per-version host plumbing (e.g. <code>MapStaticAssets</code>, <code>ImportMap</code>, <code>NotFoundPage</code>).")</td>
            </tr>
            <tr>
                <td><code>-IncludeLocalization</code></td>
                <td><code>true</code> · <code>false</code></td>
                <td><code>false</code></td>
                <td>@Loc.Html("Adds <code>BlazOrbit.Localization.Server</code> / <code>.Wasm</code>, registers <code>RequestLocalization</code> / <code>localStorage</code> bridge, and exposes <code>BOBCultureSelector</code> in the navbar.")</td>
            </tr>
            <tr>
                <td><code>-IncludeCharts</code></td>
                <td><code>true</code> · <code>false</code></td>
                <td><code>false</code></td>
                <td>@Loc.Html("Adds <code>BlazOrbit.Charts</code>, registers <code>AddBlazOrbitCharts()</code>, and replaces Home with a dashboard sample.")</td>
            </tr>
            <tr>
                <td><code>-UseNotificationsCenter</code></td>
                <td><code>true</code> · <code>false</code></td>
                <td><code>false</code></td>
                <td>@Loc.Html("Adds <code>BlazOrbit.Notifications</code>, registers <code>AddBlazOrbitNotifications()</code>, adds <code>BOBNotificationBell</code> in the navbar, and includes a notification inbox demo in Home.")</td>
            </tr>
            <tr>
                <td><code>-UseHotKeys</code></td>
                <td><code>true</code> · <code>false</code></td>
                <td><code>false</code></td>
                <td>@Loc.Html("Adds <code>BlazOrbit.Hotkeys</code>, registers <code>AddBlazOrbitHotkeys()</code>, mounts <code>BOBHotkeyHost</code> in the app shell, and includes a keyboard-shortcuts demo in Home.")</td>
            </tr>
            <tr>
                <td><code>-Theme</code></td>
                <td><code>None</code> · <code>NeoBrutalism</code> · <code>BentoGrid</code> · <code>Glassmorphism</code> · <code>FlatDesign</code> · <code>MaterialDesign</code> · <code>Neomorphism</code> · <code>Claymorphism</code> · <code>RetroWeb</code></td>
                <td><code>None</code></td>
                <td>@Loc["Pre-built visual theme that overrides the default palette and design tokens (border radius, border width, input radius, font family, etc.)."]</td>
            </tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["4. Generate a project"]</h2>

        <p class="doc-section__description">
            <strong>@Loc["Blazor Server, .NET 10, no localization:"]</strong>
        </p>
        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new blazorbit-server -n MyApp -F net10.0"/>

        <p class="doc-section__description" style="margin-top: 1.5rem;">
            <strong>@Loc["Blazor Server, .NET 10, with localization:"]</strong>
        </p>
        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new blazorbit-server -n MyApp -F net10.0 -IncludeLocalization true"/>

        <p class="doc-section__description" style="margin-top: 1.5rem;">
            <strong>@Loc["Blazor WebAssembly, .NET 8, no localization:"]</strong>
        </p>
        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new blazorbit-wasm -n MyApp -F net8.0"/>

        <p class="doc-section__description" style="margin-top: 1.5rem;">
            <strong>@Loc["Blazor WebAssembly, .NET 10, with localization:"]</strong>
        </p>
        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new blazorbit-wasm -n MyApp -F net10.0 -IncludeLocalization true"/>

        <p class="doc-section__description" style="margin-top: 1.5rem;">
            <strong>@Loc["Blazor Server, .NET 10, with Neo-Brutalism theme:"]</strong>
        </p>
        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new blazorbit-server -n MyApp -F net10.0 -Theme NeoBrutalism"/>

        <p class="doc-section__description" style="margin-top: 1.5rem;">
            <strong>@Loc["Blazor Server, .NET 10, with everything:"]</strong>
        </p>
        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="dotnet new blazorbit-server -n MyApp -F net10.0 -IncludeLocalization true -IncludeCharts true -UseNotificationsCenter true -UseHotKeys true"/>

        <div class="doc-callout doc-callout--info">
            <span class="doc-callout__icon">ℹ️</span>
            <div>
                @Loc.Html("Run <code>cd MyApp &amp;&amp; dotnet run</code> to launch. The default Home page is a live showcase of the component library you can edit at <code>Components/Pages/Home.razor</code> (Server) or <code>Pages/Home.razor</code> (WASM).")
            </div>
        </div>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["5. What the template ships"]</h2>
        <p class="doc-section__description">@Loc["Out of the box, every generated project includes:"]</p>
        <ul>
            <li>@Loc.Html("A pre-wired <code>BOBInitializer</code> in <code>MainLayout.razor</code> with theme switching and the modal/toast hosts.")</li>
            <li>@Loc["A branded loading screen using the BlazOrbit icon, replaced once the interactive shell mounts."]</li>
            <li>@Loc.Html("The CSS bundle linked from <code>_content/BlazOrbit/css/blazorbit.css</code> and the anti-flash bootstrap script.")</li>
            <li>@Loc["A favicon set (SVG + 48/192/512 PNG) and, on WASM, a PWA manifest."]</li>
            <li>@Loc["A showcase Home page demonstrating buttons, inputs, cards, and accordion with palette-driven styling."]</li>
            <li>@Loc.Html("When localization is enabled: <code>BOBCultureSelector</code> in the navbar, <code>en-US</code> / <code>es-ES</code> / <code>fr-FR</code> sample cultures, and the request-localization wiring.")</li>
            <li>@Loc.Html("When charts are enabled: <code>BlazOrbit.Charts</code> package, <code>AddBlazOrbitCharts()</code> registration, and a dashboard Home page with sample KPIs and data visualizations.")</li>
            <li>@Loc.Html("When notifications are enabled: <code>BOBNotificationBell</code> in the navbar and a sample inbox with push / mark-read / remove demo.")</li>
            <li>@Loc.Html("When hotkeys are enabled: <code>BOBHotkeyHost</code> in the layout shell and a sample shortcuts table with <code>Ctrl+K</code> / <code>Ctrl+F1</code> handlers.")</li>
        </ul>
    </section>

    <section class="doc-section">
        <h2 class="doc-section__title">@Loc["For contributors — local feed"]</h2>
        <p class="doc-section__description">
            @Loc["Validating template changes against unreleased library bits requires a local NuGet feed. The repo ships a script that packs the libraries plus the templates package, installs them, generates a matrix of sample projects, and builds each combo end-to-end."]
        </p>

        <BOBCodeBlock Title="@Loc["Terminal"]"
                      Language="SyntaxHighlightLanguage.CSharp"
                      Code="./scripts/test-templates.ps1"/>

        <p class="doc-section__description">
            @Loc.Html("See <code>scripts/test-templates.ps1 -Help</code> for flags (<code>-SkipBlazOrbitPack</code>, <code>-KeepWorkDir</code>, custom <code>-Matrix</code>, …).")
        </p>
    </section>
</DocPage>
