@namespace BlazOrbit.Docs.Components
@using BlazOrbit.Components.Forms
@using BlazOrbit.Components.Layout

@foreach (var category in _categories)
{
    <section>
        <h2>@category.Name</h2>
        <BOBGrid Columns="12" Gap="0.75rem">
            @foreach (var propName in category.Properties)
            {
                if (Palette.ContainsKey(propName))
                {
                    var key = propName;
                    <BOBGridItem Xs="12" Md="4">
                        <BOBInputColor Label="@key"
                                       Value="Palette[key]"
                                       ValueChanged="c => HandleColorChanged(key, c)"
                                       ValueExpression="@(() => Palette[key])"
                                       Size="BOBSize.Small"/>
                    </BOBGridItem>
                }
            }
        </BOBGrid>
    </section>
}

@code {
    [Parameter] public Dictionary<string, CssColor> Palette { get; set; } = new();

    [Parameter] public EventCallback<Dictionary<string, CssColor>> OnPaletteChanged { get; set; }

    protected override void OnParametersSet()
    {
        Palette ??= new Dictionary<string, CssColor>();
    }

    private readonly List<ColorCategory> _categories =
    [
        new ColorCategory("Surface", ["Background", "BackgroundContrast", "Surface", "SurfaceContrast"]),
        new ColorCategory("Main", ["Primary", "PrimaryContrast", "Secondary", "SecondaryContrast"]),
        new ColorCategory("Status", ["Error", "ErrorContrast", "Success", "SuccessContrast", "Warning", "WarningContrast", "Info", "InfoContrast"]),
        new ColorCategory("Utility", ["Black", "White", "Border", "Shadow", "Highlight"])
    ];

    private async Task HandleColorChanged(string propertyName, CssColor? newColor)
    {
        if (newColor == null) return;
        Palette[propertyName] = newColor;
        await OnPaletteChanged.InvokeAsync(Palette);
    }

    private record ColorCategory(string Name, string[] Properties);

}
