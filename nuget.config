<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-scoped NuGet configuration. `<clear />` discards feeds registered at user or
  machine level so every restore resolves the same way on every machine and in CI.

  - nuget.org serves every third-party package.
  - blazorbit-local-test is the folder scripts/test-templates.ps1 packs into. Only BlazOrbit
    package ids map to it, and only template projects generated under artifacts/ consume them.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="blazorbit-local-test" value="artifacts/local-feed" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="blazorbit-local-test">
      <package pattern="BlazOrbit" />
      <package pattern="BlazOrbit.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
