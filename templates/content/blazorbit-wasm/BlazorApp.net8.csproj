<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!--#if (IncludeLocalization)-->
    <!-- BlazOrbit.Localization changes the app's culture during startup, which the
         default WASM globalization payload does not support. Loading the full ICU
         data set lets RequestLocalization / persisted culture cookies switch
         cultures at runtime. Cost: ~7MB extra in the wasm payload. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!--#endif-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
    <PackageReference Include="BlazOrbit" Version="*" />
    <!--#if (IncludeLocalization)-->
    <PackageReference Include="BlazOrbit.Localization.Wasm" Version="*" />
    <!--#endif-->
    <!--#if (IncludeCharts)-->
    <PackageReference Include="BlazOrbit.Charts" Version="*" />
    <!--#endif-->
    <!--#if (UseNotificationsCenter)-->
    <PackageReference Include="BlazOrbit.Notifications" Version="*" />
    <!--#endif-->
    <!--#if (UseHotKeys)-->
    <PackageReference Include="BlazOrbit.Hotkeys" Version="*" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
