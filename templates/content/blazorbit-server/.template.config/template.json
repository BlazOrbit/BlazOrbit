{
  "$schema": "http://json.schemastore.org/template",
  "author": "BlazOrbit",
  "classifications": ["Web", "Blazor", "BlazOrbit"],
  "identity": "BlazOrbit.Server",
  "name": "BlazOrbit Server App",
  "shortName": "blazorbit-server",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "BlazorApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net8.0", "description": "Target .NET 8.0" },
        { "choice": "net10.0", "description": "Target .NET 10.0" }
      ],
      "defaultValue": "net8.0",
      "replaces": "net8.0"
    },
    "IncludeLocalization": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to include BlazOrbit localization support."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        { "condition": "(Framework != 'net8.0')", "exclude": ["**/*.net8.*"] },
        { "condition": "(Framework != 'net10.0')", "exclude": ["**/*.net10.*"] },
        { "condition": "(Framework != 'net10.0')", "exclude": ["Components/Pages/NotFound.razor", "Components/Layout/ReconnectModal.razor", "Components/Layout/ReconnectModal.razor.css", "Components/Layout/ReconnectModal.razor.js"] },
        { "condition": "(!IncludeLocalization)", "exclude": ["localized/**"] },
        { "condition": "(IncludeLocalization)", "exclude": ["Program.cs", "Components/Layout/MainLayout.razor", "Components/Layout/NavMenu.razor", "localized/**"] }
      ],
      "rename": {
        "Components/App.net8.razor": "Components/App.razor",
        "Components/App.net10.razor": "Components/App.razor",
        "Components/Routes.net8.razor": "Components/Routes.razor",
        "Components/Routes.net10.razor": "Components/Routes.razor",
        "Program.net8.cs": "Program.cs",
        "Program.net10.cs": "Program.cs",
        "Properties/launchSettings.net8.json": "Properties/launchSettings.json",
        "Properties/launchSettings.net10.json": "Properties/launchSettings.json"
      }
    },
    {
      "condition": "(IncludeLocalization)",
      "source": "localized/",
      "target": "./",
      "rename": {
        "Program.net8.cs": "Program.cs",
        "Program.net10.cs": "Program.cs"
      }
    }
  ]
}
